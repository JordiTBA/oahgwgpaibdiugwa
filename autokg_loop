local function d(lvl, ...)
    if not GBXP_DEBUG then return end
    if (lvl or 2) > DEBUG_LEVEL then return end
    local parts = { _ts(), "[GBXP]" }
    for i = 1, select("#", ...) do
        parts[#parts+1] = tostring(select(i, ...))
    end
    print(table.concat(parts, " "))
end

local function dx(...)
