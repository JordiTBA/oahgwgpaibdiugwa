-- GBXP stage & rule helpers
------------------------------------------------------------
local function _isMutationSelected(uuid)
    if not _getMutationNamesForUUID then return false end
    local muts = _getMutationNamesForUUID(uuid) or {}
    if type(muts) ~= "table" then return false end

    for _, name in ipairs(muts) do
        name = tostring(name)
        local k1 = name
        local k2 = name:lower()
        if GBXP_MUT_SELECTED[k1] or GBXP_MUT_SELECTED[k2] then
            return true
        end
    end
    return false
end

local function _getCutoffAge()
    local v = TAB_AGE_UNEQUIP_MIN and TAB_AGE_UNEQUIP_MIN.gbxp
    if type(v) == "number" and v > 0 then
        return v
    end
    return AGE_MAX_UNEQUIP_B
end

local function _modeNeedsMutToFinish(mode)
    mode = tostring(mode or "auto"):upper()
    -- mode yang wajib mutasi cocok supaya FINISH
    return (mode == "AUTO" or mode == "A" or mode == "CAD")
end

local function _getStageForGBXP(uuid)
    local mode   = tostring(GBXP_STAGE_MODE or "auto"):upper()
    local isAuto = (mode == "AUTO")

    local mutMatch = _isMutationSelected(uuid)

    ----------------------------------------------------------------
    -- MODE A â†’ PURE MUTATION MODE
    ----------------------------------------------------------------
    if mode == "A" then
        if mutMatch then
            -- sudah dapat mutasi target, selesai
            return nil
        else
            -- belum mutasi target, tetap di stage A
            return "A"
        end
    end
    
    if mode == "D" then
        local age = getPetAge(uuid)
        if not age then return nil end
        age = math.floor(age + EPS)

        local cutoffAge = _getCutoffAge()
        if age >= (cutoffAge - EPS) then
            return nil -- finish
        end
        return "D"
    end

    ----------------------------------------------------------------
    -- MODE selain A â†’ pakai age + KG100
    ----------------------------------------------------------------
    local age  = getPetAge(uuid)
    local w100 = getWeightAtLevel100(uuid)
    if not age or not w100 then return nil end

    age = math.floor(age + EPS)

    local cutoffAge = _getCutoffAge()

    -- apakah butuh mutasi cocok untuk dianggap FINISH?
    local requireMutToFinish = _modeNeedsMutToFinish(mode)
    local finishMutOK = (not requireMutToFinish) or mutMatch

    -- FINISH / SELESAI
    if age >= (cutoffAge - EPS)
       and w100 >= (W100_MAX_EQUIP - EPS)
       and finishMutOK then
        return nil
    end

    ----------------------------------------------------------------
    -- STAGE A (cari mutasi)
    --  - AUTO / mode yang mengandung "A": sama seperti dulu
    --  - CAD: cuma kalau KG sudah tembus & umur >= equip age tab BOOST
    ----------------------------------------------------------------
    if not mutMatch then
        local modeHasA = (mode:find("A", 1, true) ~= nil)

        if isAuto or modeHasA then
            if mode == "CAD" then
                local minAgeA = 0
                if TAB_AGE_EQUIP_MIN and type(TAB_AGE_EQUIP_MIN.boost) == "number" then
                    minAgeA = TAB_AGE_EQUIP_MIN.boost
                end

                if age >= (minAgeA - EPS) and w100 >= (W100_MAX_EQUIP - EPS) then
                    return "A"
                end
            else
                -- AUTO / CD / DC yang punya "A" â†’ stage A begitu belum mutasi
                return "A"
            end
        end
    end

    ----------------------------------------------------------------
    -- Stage B / C / D sama seperti versi lama
    ----------------------------------------------------------------

    -- Stage B / D untuk umur < 40
    if age < (40 - EPS) then
        if (not isAuto)
           and (mode == "CD" or mode == "DC" or mode == "CAD")
           and w100 >= (W100_MAX_EQUIP - EPS) then
            return "D"
        end
        return "B"
    end

    -- Stage C: umur >= 40, KG100 belum tembus limit
    if age >= (40 - EPS) and w100 < (W100_MAX_EQUIP - EPS) then
        return "C"
    end

    -- Stage D: KG100 sudah cukup, umur belum sampai cutoff
    if w100 >= (W100_MAX_EQUIP - EPS) and age < (cutoffAge - EPS) then
        return "D"
    end

    return nil
end




local function _shouldUnequipGBXP(uuid)
    local mode   = tostring(GBXP_STAGE_MODE or "auto"):upper()
    local isAuto = (mode == "AUTO")

    local mutMatch = _isMutationSelected(uuid)

    ----------------------------------------------------------------
    -- MODE A â†’ selesai kalau MUTASI SUDAH COCOK
    ----------------------------------------------------------------
    if mode == "A" then
        return mutMatch
    end

    ----------------------------------------------------------------
    -- MODE lain â†’ same finish rule dengan _getStageForGBXP
    ----------------------------------------------------------------
    local age  = getPetAge(uuid)
    local w100 = getWeightAtLevel100(uuid)
    if not age or not w100 then return false end

    age = math.floor(age + EPS)

    local cutoffAge = _getCutoffAge()

    local requireMutToFinish = _modeNeedsMutToFinish(mode)
    local finishMutOK = (not requireMutToFinish) or mutMatch

    return age >= (cutoffAge - EPS)
       and w100 >= (W100_MAX_EQUIP - EPS)
       and finishMutOK
end



