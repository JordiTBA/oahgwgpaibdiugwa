local PetListView

local function _resolvePetListView()
    if PetListView then
        return PetListView
    end

    local G = (getgenv and getgenv()) or _G
    if G and type(G.PetListView) == "table" then
        PetListView = G.PetListView
        return PetListView
    end

    return nil
end

----------------------------------------------------------------
-- AUTO HATCH PAUSE / RESUME (VERSI YANG KERJA)
----------------------------------------------------------------
local _hatchWasRunningForGift = false

local function _getAutoHatchLoop()
    local GG  = (getgenv and getgenv()) or _G
    local loop = rawget(GG, "auto_hatchLoop") or rawget(_G, "auto_hatchLoop")
    return loop, GG
end

local function _isAutoHatchRunning()
    local loop, GG = _getAutoHatchLoop()
    local running = false

    if type(loop) == "table" then
        if type(loop.IsRunning) == "function" then
            local ok, res = pcall(function()
                return loop:IsRunning()
            end)
            running = ok and res == true
        else
            running = (loop.running == true)
        end
    end

    if not running then
        local flag = rawget(GG, "__AUTO_HATCH_RUNNING") or rawget(_G, "__AUTO_HATCH_RUNNING")
        running = (flag == true)
    end

    return running
end

local function _ensureAutoHatchStoppedForGift()
    local loop = _getAutoHatchLoop()  -- ambil return pertama (loop)

    if _hatchWasRunningForGift then
        return
    end

    if _isAutoHatchRunning() then
        _hatchWasRunningForGift = true
        if type(loop) == "table" and type(loop.Stop) == "function" then
            pcall(function()
                -- pakai proxy dot-call dari auto_hatchLoop
                loop.Stop("pause_for_gift")
            end)
        end
        --print("[AutoGift] AutoHatch sedang jalan â†’ STOP sementara (pause_for_gift)")
    end
end

local function _resumeAutoHatchIfNeeded()
    if not _hatchWasRunningForGift then
        return
    end

    local loop = _getAutoHatchLoop()  -- ambil return pertama (loop)

    if type(loop) == "table" and type(loop.Start) == "function" then
        pcall(function()
            -- proxy dot-call
            loop.Start()
        end)
    end

    _hatchWasRunningForGift = false
    --print("[AutoGift] AutoHatch di-resume setelah gift pass selesai")
end

