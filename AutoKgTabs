        TAB_W_UNEQUIP_MAX[tabKey]   = tonumber(TAB_W_UNEQUIP_MAX[tabKey])   or 999999

        selected[tabKey] = selected[tabKey] or {}
    end

    for _, k in ipairs(ALL_TABS) do
