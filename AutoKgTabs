local function BuildSwapSkillConfig(ui, bodyParent, STATE, PetListView, autoSave)
    local G = (getgenv and getgenv()) or _G

    ----------------------------------------------------------------
    -- SOURCE OF TRUTH (GLOBAL)
    ----------------------------------------------------------------
    local swap_skill = rawget(G, "swap_skill") or rawget(_G, "swap_skill")
    if type(swap_skill) ~= "table" then
        swap_skill = {
            enabled      = false,
            selected     = {},
            order        = {},
            delays       = {},
            poll         = 0.05,
            scanInterval = 0.1,
        }
    end
    G.swap_skill = swap_skill
    _G.swap_skill = swap_skill

    local SS = swap_skill

    -- normalize types (jangan overwrite keras)
    SS.enabled      = (SS.enabled == true)
    SS.selected     = (type(SS.selected) == "table") and SS.selected or {}
    SS.order        = (type(SS.order)    == "table") and SS.order    or {}
    SS.delays       = (type(SS.delays)   == "table") and SS.delays   or {}
    SS.scanInterval = tonumber(SS.scanInterval) or 0.1
    SS.poll         = tonumber(SS.poll) or 0.05

    ----------------------------------------------------------------
    -- helpers
    ----------------------------------------------------------------
    local function _normUUID(u)
        if u == nil then return nil end
        local s = tostring(u)
        local core = s:match("{?([0-9a-fA-F%-]+)}?") or s
        if core == "" then return nil end
        return "{" .. core .. "}"
    end

    local function toNumFloat(text)
        text = tostring(text or ""):gsub("%s+", "")
        if text == "" then return nil end
        text = text:gsub(",", ".")
        return tonumber(text)
    end

    local function norm(s)
        s = tostring(s or ""):lower()
        s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
        return s
    end

    local function ensureDelay(uuid)
        uuid = _normUUID(uuid)
        if not uuid then return nil end
        local d = SS.delays[uuid]
        if type(d) ~= "table" then
            d = { unequipAfterReady = 0.6, equipNext = 0 }
            SS.delays[uuid] = d
        end
        d.unequipAfterReady = tonumber(d.unequipAfterReady) or 0.6
        d.equipNext         = tonumber(d.equipNext) or 0
        return d
    end

    local function ensureOrderUnique(uuid)
        uuid = _normUUID(uuid)
        if not uuid then return end
        for i = #SS.order, 1, -1 do
            if SS.order[i] == uuid then
                table.remove(SS.order, i)
            end
        end
        table.insert(SS.order, 1, uuid)
    end

    local function getSwapPetEntries()
        -- ambil dari petList main_pet (agar sesuai flow kamu)
        local ok, entries = pcall(function()
            return PetListView.buildEntriesForTab("noos", STATE.main_pet and STATE.main_pet.selected or {})
        end)
        if ok and type(entries) == "table" then return entries end
        return {}
    end

    -- apply helper (Start/Stop module)
    local function applySwapSkillModule(reason)
        local GG = (getgenv and getgenv()) or _G
        local Mod = GG.SwapSkillModule or GG.SwapSkill or _G.SwapSkillModule or _G.SwapSkill
        if not Mod then return end

        local function callMaybe(obj, method, ...)
            local f = obj and obj[method]
            if type(f) ~= "function" then return false end
            local args = table.pack(...)
            if pcall(function() f(obj, table.unpack(args, 1, args.n)) end) then return true end
            return pcall(function() f(table.unpack(args, 1, args.n)) end)
        end

        local hasAny = (SS.selected and next(SS.selected) ~= nil)

        if SS.enabled and hasAny then
            callMaybe(Mod, "SyncFromState"); callMaybe(Mod, "syncFromState")
            callMaybe(Mod, "Start");        callMaybe(Mod, "start")
        else
            callMaybe(Mod, "Stop", reason or "ui"); callMaybe(Mod, "stop", reason or "ui")
        end
    end

