                end
            end
        end
        applyVisual()

        btnItem.MouseButton1Click:Connect(function()
            if mode == "single" then
                selectedKey = k
                refreshButtonText()
                if onChanged then
                    onChanged("single", selectedKey)
                end
                overlay:Destroy()
            else
                selectedMap[k] = not selectedMap[k]
                refreshButtonText()
