-- Mutasi yang DIANGGAP BAIK sekarang diambil dari state:
--   â€¢ Global: GBXP_MUT_SELECTED
--   â€¢ Atau dari STATE (kalau kamu simpan di sana)
--
-- Jika tidak ada config, script TIDAK akan cleanse apapun (lebih aman).
local SCAN_EVERY = 3
local EQUIP_WAIT = 1
local APPLY_GAP  = 1.5 -- rate limit antar ApplyShard

