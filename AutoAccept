local DEBUG          = false
local TIMEOUT_READY  = 200
local TIMEOUT_ACTION = 200

local function dbg(...)
    if DEBUG then
        print("[TradeRecvDBG]", ...)
    end
end

local function warnx(...)
    warn("[TradeRecvDBG]", ...)
end

--------------------------------------------------
-- Safe require helper
--------------------------------------------------
local function safeRequire(obj)
    local ok, mod = pcall(function()
        return require(obj)
    end)
    if not ok then
        dbg("require fail:", tostring(obj))
    end
    return ok and mod or nil
end

