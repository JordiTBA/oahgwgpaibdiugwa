-- Public API
----------------------------------------------------------
function M.SetDebug(on)
    DEBUG = (on == true)
end

function M.SyncFromState()
    local ss = ensureSwapSkillState()
    local list = buildSelectedOrdered()
    for _, uuid in ipairs(list) do
        ensureDelay(uuid)
        local c = ss.skillCache[uuid]
        if type(c) == "table" then
            local k = c.kind
            local ln = c.labelNorm
            if (k ~= "Skill" and k ~= "Passive") or type(ln) ~= "string" or ln == "" then
                ss.skillCache[uuid] = nil
            end
        end
    end
end

function M.Start()
    
        local ss = ensureSwapSkillState()

    if ss.enabled == false and not force then
        return false, "disabled by state"
    end
    ensureSwapSkillState()
    if running then return true end
    running = true
    resetTrackers()

    if hbConn then hbConn:Disconnect() end
    hbConn = RunService.Heartbeat:Connect(tick)

    _G.__SWAP_SKILL_RUNNING = true
    return true
end

function M.Stop()
    if not running then
        return true, "already stopped"
    end
    running = false
    _G.__SWAP_SKILL_RUNNING = false
    if hbConn then hbConn:Disconnect() end
    resetTrackers()
    return true
end

-- âœ… setter: SET apa adanya (tanpa default 0.28, tanpa clamp)
-- kalau input invalid => jangan overwrite
function M.SetScanInterval(v)
    local ss = ensureSwapSkillState()
    local n = tonumber(v)
    if n == nil then
        return ss.scanInterval
    end
    ss.scanInterval = n
    return ss.scanInterval
end

function M.IsRunning()
    return running == true
end

