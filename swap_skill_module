-- Equip / Unequip safe
----------------------------------------------------------
local DEBUG = false
local function log(...)
    if not DEBUG then
        print("[SwapSkill]", ...)
    end
end

local function equip(uuid)
    uuid = _normUUID(uuid)
    if not uuid then return end
    pcall(function()
        PetsService:EquipPet(uuid)
    end)
end

local function unequip(uuid)
    uuid = _normUUID(uuid)
    if not uuid then return end
    pcall(function()
        PetsService:UnequipPet(uuid)
    end)
end

----------------------------------------------------------
-- Ordered selected list
----------------------------------------------------------
local function buildSelectedOrdered()
    local ss = ensureSwapSkillState()
    local selected = ss.selected or {}
    local order    = ss.order or {}

    local out, used = {}, {}

    for _, u in ipairs(order) do
        u = _normUUID(u)
        if u and selected[u] == true and not used[u] then
            used[u] = true
            table.insert(out, u)
        end
    end

    for u, on in pairs(selected) do
        if on then
            u = _normUUID(u)
            if u and not used[u] then
                used[u] = true
                table.insert(out, u)
            end
        end
    end

    return out
end

----------------------------------------------------------
-- Runner (Heartbeat connection)
----------------------------------------------------------
local hbConn = nil
local running = false

local lastReady = {}  -- [uuid]=bool
local busy      = {}  -- [uuid]=bool
local lastTrig  = {}  -- [uuid]=time

local acc = 0

local function resetTrackers()
    table.clear(lastReady)
    table.clear(busy)
    table.clear(lastTrig)
    acc = 0
end

local function tick(dt)
    if not running then return end

    local ss = ensureSwapSkillState()
    local poll = tonumber(ss.poll) or 0.05
    if poll < 0.02 then poll = 0.02 end

    acc += dt
    if acc < poll then return end
    acc = 0

    local list = buildSelectedOrdered()
    if #list <= 0 then return end

    local now = os.clock()

    -- âœ… scanInterval: baca dari STATE, fallback cuma untuk hitung (TIDAK nulis balik ke state)
    -- kalau kamu mau 100% tanpa fallback: ganti "or 0" dan biar jadi selalu lolos limiter.
    local minInterval = toNum(ss.scanInterval)
    if minInterval == nil or minInterval <= 0 then
        minInterval = 0.25 -- fallback runtime ONLY (bukan default permanen)
    end

    for _, uuid in ipairs(list) do
        if not busy[uuid] then
            local cd
            local ok = pcall(function()
                cd = getCooldown(uuid)
            end)
            if not ok then cd = nil end

            if cd ~= nil then
                local ready = (cd <= READY_TOL)
                local wasReady = (lastReady[uuid] == true)

                if (not wasReady) and ready then
                    local lt = lastTrig[uuid] or 0
                    if (now - lt) >= minInterval then
                        lastTrig[uuid] = now
                        busy[uuid] = true

                        local d  = ensureDelay(uuid)
                        local du = tonumber(d and d.unequipAfterReady) or DEFAULT_DELAYS.unequipAfterReady
                        local de = tonumber(d and d.equipNext)         or DEFAULT_DELAYS.equipNext

                        log("READY", uuid, "du", du, "de", de, "-> UNEQUIP+EQUIP SAME")

                        task.delay(du, function()
                            if not running then return end

                            unequip(uuid)
                            lastReady[uuid] = false

                            task.delay(de, function()
                                if not running then return end
                                equip(uuid)
                                busy[uuid] = false
                            end)
                        end)
                    end
                end

                lastReady[uuid] = ready
            else
                lastReady[uuid] = false
            end
        end
    end
end

