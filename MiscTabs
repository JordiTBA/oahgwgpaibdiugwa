local function getTargetItems()
    local items = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(items, {
                key      = plr.Name,     -- dipakai dropdown
                name     = plr.Name,     -- tampil di UI
                userId   = plr.UserId,   -- disimpan ke config
            })
        end
    end

    return items
end


