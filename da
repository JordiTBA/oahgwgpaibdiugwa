    -- Count pets by growth stage (detailed breakdown)
    function m:CountPetsDetailed()
        local stats = {
            waiting = 0,  -- No mutation yet
            mutated = 0,  -- Has target mutation, age < 40
            age40 = 0,    -- Has target mutation, age 40-99
            age100 = 0    -- Has target mutation, age >= 100 (done!)
        }

        if not Pet or not Pet.GetAllPetsInInventory then
            return stats
        end

        local allPets = Pet:GetAllPetsInInventory() or {}
        local selectedTypes = Growth.TargetPetTypes or {}
        local targetMutations = Growth.TargetMutations or {}

        for guid, petData in pairs(allPets) do
            local petType = Pet:GetPetType(petData)
            local isFavorited = Pet.IsPetFavorited and Pet:IsPetFavorited(petData) or false

            if selectedTypes[petType] and not isFavorited then
                local age = Pet:GetPetAge(petData) or 0
                -- Use Growth:GetPetMutation to properly convert enum to display name
                local mutation = Growth.GetPetMutation and Growth:GetPetMutation(petData) or nil
                local hasMutation = mutation and mutation ~= "" and mutation ~= "None" and targetMutations[mutation]

                if not hasMutation then
                    -- No mutation or wrong mutation
                    stats.waiting = stats.waiting + 1
                elseif age >= 100 then
                    -- Has mutation AND age 100+ = Done!
                    stats.age100 = stats.age100 + 1
                elseif age >= 40 then
                    -- Has mutation AND age 40-99
                    stats.age40 = stats.age40 + 1
                else
                    -- Has mutation but age < 40
                    stats.mutated = stats.mutated + 1
                end
            end
        end

        return stats
    end

