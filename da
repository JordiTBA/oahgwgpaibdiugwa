    -- 6) List Item PetBoost dari InventoryData + Backpack
    -------------------------------------------------------------
    local function __listPetBoostItems()
        local items = {}
        local countByName = {} -- Group by clean name and count

        local inv = __getInventoryDataTable()
        if type(inv) ~= "table" then
            return items
        end

        for rawUUID, rec in pairs(inv) do
            if type(rec) == "table" and rec.ItemType == "PetBoost" then
                local coreUUID = __normUUID(rawUUID)
                if coreUUID then
                    -- Find tool in Backpack
                    local prettyName = nil
                    for _, tool in ipairs(Backpack:GetChildren()) do
                        local attr = tool:GetAttribute("c") or tool:GetAttribute("C")
                        if attr then
                            local attrCore = __normUUID(attr)
                            if attrCore == coreUUID then
                                prettyName = tool.Name
                                break
                            end
                        end
                    end

                    if prettyName and prettyName ~= "" then
                        -- Extract clean name (remove quantity and boost type)
                        local cleanName = prettyName
                            :gsub("%s*[xX]%s*%d+%s*$", "")   -- Remove "x99", " x 99", "X99" at end
                            :gsub("%s*%[.*%]%s*$", "")       -- Remove "[Passive]", "[XP]" etc at end
                            :gsub("%s*[xX]%s*%d+%s*", "")    -- Also remove if in middle (before bracket)
                            :gsub("%s+$", "")                 -- Trim trailing spaces

                        if cleanName == "" then
                            cleanName = prettyName
                        end

                        -- Count by clean name
                        if not countByName[cleanName] then
                            countByName[cleanName] = {
                                count = 0,
                                uuids = {}
                            }
                        end
                        countByName[cleanName].count = countByName[cleanName].count + 1
                        table.insert(countByName[cleanName].uuids, coreUUID)
                    end
                end
            end
        end

        -- Build items list (no count in name)
        for cleanName, data in pairs(countByName) do
            -- Use first UUID as key
            table.insert(items, {
                key  = data.uuids[1],   -- UUID for reference
                name = cleanName,       -- Clean name only
                uuids = data.uuids,     -- All UUIDs for this item type
            })
        end

        table.sort(items, function(a, b)
            return a.name < b.name
        end)

        return items
    end




