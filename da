    ----------------------------------------------
    -- AUTO ELEPHANT V1 (Single Team)
    ----------------------------------------------
    function m:StartAutoElephantV1()
        if not self.IsRunningV1 then return end

        -- Validate config
        if not self.V1_PetTeamPets or next(self.V1_PetTeamPets) == nil then
            self:Notify("Auto Elephant v.1", "No pet team selected!", Color3.fromRGB(255, 100, 100))
            return
        end

        if not self.V1_SelectedPetTypes or next(self.V1_SelectedPetTypes) == nil then
            self:Notify("Auto Elephant v.1", "No pet types selected!", Color3.fromRGB(255, 100, 100))
            return
        end

        -- Get all pets
        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterPetsByType(allPets, self.V1_SelectedPetTypes)
        local petTeamGuids = self:GetPetTeamGuids(self.V1_PetTeamPets)

        -- Ensure pet team is active
        self:EquipPetTeam(self.V1_PetTeamPets)

        -- Get active pets
        local activePetsArray = Pet:GetActivePets() or {}
        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        -- Check target pets - unequip if reached weight
        for _, guid in ipairs(activePetsArray) do
            if not petTeamGuids[guid] and targetPets[guid] then
                local petData = Pet:GetPetData(guid)
                if petData then
                    local weight = Pet:GetPetWeight(petData)
                    if weight >= self.V1_TargetWeight then
                        local petType = Pet:GetPetType(petData)
                        self:Notify("V1 Max KG!", petType .. " reached " .. string.format("%.1f", weight) .. " KG", Color3.fromRGB(100, 255, 100))

                        Pet:UnequipPet(guid)
                        task.wait(0.25)

                        -- Send webhook notification with full stats
                        self:SendElephantV1Webhook()
                    end
                end
            end
        end

        -- Count current target pets in garden (only pets matching selected types)
        activePetsArray = Pet:GetActivePets() or {}
        activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        local activeTargetCount = 0
        for guid, _ in pairs(activePets) do
            if targetPets[guid] then
                activeTargetCount = activeTargetCount + 1
            end
        end

        -- Calculate free slots respecting max target limit
        local maxTargetPets = self.V1_MaxTargetPets or 3
        local targetFreeSlots = maxTargetPets - activeTargetCount
        local freeSlots = math.min(8 - #activePetsArray, targetFreeSlots)

        if freeSlots > 0 then
            for guid, petData in pairs(targetPets) do
                if freeSlots <= 0 then break end
                if not activePets[guid] then
                    local weight = Pet:GetPetWeight(petData)
                    if weight < self.V1_TargetWeight then
                        Pet:EquipPet(guid)
                        freeSlots = freeSlots - 1
                        task.wait(0.25)
                    end
                end
            end
        end
    end

    ----------------------------------------------
    -- AUTO ELEPHANT V2 (Two Stage: Leveling -> Elephant)
    ----------------------------------------------
    function m:StartAutoElephantV2()
        if not self.IsRunningV2 then return end

        -- Validate config
        if not self.V2_LevelingPetTeamPets or next(self.V2_LevelingPetTeamPets) == nil then
            self:Notify("Auto Elephant v.2", "No leveling pet team selected!", Color3.fromRGB(255, 100, 100))
            return
        end

        if not self.V2_ElephantPetTeamPets or next(self.V2_ElephantPetTeamPets) == nil then
            self:Notify("Auto Elephant v.2", "No elephant pet team selected!", Color3.fromRGB(255, 100, 100))
            return
        end

        if not self.V2_SelectedPetTypes or next(self.V2_SelectedPetTypes) == nil then
            self:Notify("Auto Elephant v.2", "No pet types selected!", Color3.fromRGB(255, 100, 100))
            return
        end

        -- Get all pets
        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterPetsByType(allPets, self.V2_SelectedPetTypes)

        -- Find pets that need leveling vs elephant
        local needsLeveling = {}
        local readyForElephant = {}
        local completed = {}

        for guid, petData in pairs(targetPets) do
            local weight = Pet:GetPetWeight(petData)
            local age = Pet:GetPetAge(petData)

            if weight >= self.V2_TargetWeight then
                -- Completed - reached target weight
                table.insert(completed, guid)
            elseif age >= self.V2_LevelBeforeElephant then
                -- Ready for elephant stage
                table.insert(readyForElephant, guid)
            else
                -- Still needs leveling
                table.insert(needsLeveling, guid)
            end
        end

        -- Determine stage
        local hasElephantReady = #readyForElephant > 0

        if not hasElephantReady and self.V2_Stage == "elephant" then
            -- No pets ready for elephant, switch to leveling
            self.V2_Stage = "leveling"
        elseif hasElephantReady and self.V2_Stage == "leveling" then
            -- Pets ready for elephant, switch to elephant stage
            self.V2_Stage = "elephant"
        end

        -- Get current team based on stage
        local currentTeamPets = self.V2_Stage == "elephant" and self.V2_ElephantPetTeamPets or self.V2_LevelingPetTeamPets
        local petTeamGuids = self:GetPetTeamGuids(currentTeamPets)

        -- Unequip pets that are completed or don't belong to current stage
        local activePetsArray = Pet:GetActivePets() or {}

        -- Build lookup for current stage's valid pets
        local validPetsForStage = {}
        local petsToEquip = self.V2_Stage == "elephant" and readyForElephant or needsLeveling
        for _, guid in ipairs(petsToEquip) do
            validPetsForStage[guid] = true
        end

        for _, guid in ipairs(activePetsArray) do
            if not petTeamGuids[guid] then
                local petData = Pet:GetPetData(guid)
                if petData then
                    local weight = Pet:GetPetWeight(petData)
                    local shouldUnequip = false

                    -- Only process target pets (check if in targetPets)
                    local isTargetPet = targetPets[guid] ~= nil

                    -- Check if completed (only for target pets)
                    if weight >= self.V2_TargetWeight and isTargetPet then
                        local petType = Pet:GetPetType(petData)
                        self:Notify("V2 Max KG!", petType .. " reached " .. string.format("%.1f", weight) .. " KG", Color3.fromRGB(100, 255, 100))
                        shouldUnequip = true

                        -- Send webhook notification with full stats after unequip
                        task.spawn(function()
                            task.wait(0.5)
                            self:SendElephantV2Webhook()
                        end)
                    -- Check if pet doesn't belong to current stage
                    elseif not validPetsForStage[guid] then
                        shouldUnequip = true
                    end

                    if shouldUnequip then
                        Pet:UnequipPet(guid)
                        task.wait(0.25)
                    end
                end
            end
        end

        -- Skill Stuck Detection: check if pet skills are stuck and fix them
        if self.SkillStuckEnabled then
            local petTeamGuids = self:GetPetTeamGuids(currentTeamPets)
            local stuckPets = {}

            for guid, _ in pairs(petTeamGuids) do
                local cooldown = self:GetSkillCooldown(guid)
                local rec = SKILL_STUCK[guid] or { lastCooldown = nil, sameCount = 0 }

                if cooldown == nil then
                    rec.lastCooldown, rec.sameCount = nil, 0
                else
                    if rec.lastCooldown ~= nil then
                        local diff = cooldown - rec.lastCooldown
                        if diff >= -self.SkillStuckTolerance then
                            rec.sameCount = (rec.sameCount or 0) + 1
                        else
                            rec.sameCount = 0
                        end
                    else
                        rec.sameCount = 0
                    end

                    rec.lastCooldown = cooldown

                    if rec.sameCount >= self.SkillStuckThreshold then
                        table.insert(stuckPets, guid)
                        rec.sameCount = 0
                    end
                end

                SKILL_STUCK[guid] = rec
            end

            -- Fix stuck pets by pickup and re-place
            if #stuckPets > 0 then
                for _, guid in ipairs(stuckPets) do
                    Pet:UnequipPet(guid)
                    task.wait(0.25)
                end
                task.wait(0.5)
                for _, guid in ipairs(stuckPets) do
                    Pet:EquipPet(guid)
                    task.wait(0.25)
                end
                -- print("[Elephant V2] Fixed", #stuckPets, "stuck pets")
            end
        end

        -- Equip current team
        self:EquipPetTeam(currentTeamPets)

        -- Equip target pets based on stage
        activePetsArray = Pet:GetActivePets() or {}
        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        -- Count current target pets in garden
        local currentTargetCount = 0
        local petTeamGuids = self:GetPetTeamGuids(currentTeamPets)
        for _, guid in ipairs(activePetsArray) do
            if not petTeamGuids[guid] then
                currentTargetCount = currentTargetCount + 1
            end
        end

        -- Get max pets limit based on stage
        local maxTargetPets = self.V2_Stage == "elephant" and self.V2_MaxElephantPets or self.V2_MaxLevelingPets
        local targetFreeSlots = maxTargetPets - currentTargetCount
        local freeSlots = math.min(8 - #activePetsArray, targetFreeSlots)
        local petsToEquip = self.V2_Stage == "elephant" and readyForElephant or needsLeveling

        for _, guid in ipairs(petsToEquip) do
            if freeSlots <= 0 then break end
            if not activePets[guid] then
                Pet:EquipPet(guid)
                freeSlots = freeSlots - 1
                task.wait(0.25)
            end
        end
    end

    ----------------------------------------------
    -- START/STOP V1
    ----------------------------------------------
    function m:StartV1()
        if self.IsRunningV1 then return end

        -- Stop V2 if running (mutually exclusive)
        if self.IsRunningV2 then
            self:StopV2()
            task.wait(0.5)
        end

        self.IsRunningV1 = true

        self:Notify("Elephant v.1 Started", "Target: " .. self.V1_TargetWeight .. " KG", Color3.fromRGB(100, 180, 255))

        -- Send initial webhook on start
        task.spawn(function()
            task.wait(1)
            self:SendElephantV1Webhook()
        end)

        task.spawn(function()
            self:PickupAllPets()
            task.wait(1)

            while self.IsRunningV1 do
                pcall(function()
                    self:StartAutoElephantV1()
                end)
                task.wait(5)
            end
        end)
    end

    function m:StopV1()
        local wasRunning = self.IsRunningV1
        self.IsRunningV1 = false


        if wasRunning then
            self:Notify("Elephant v.1 Stopped", "Auto elephant v.1 stopped", Color3.fromRGB(255, 150, 100))
            task.spawn(function()
                task.wait(0.5)
                self:PickupAllPets()
            end)
        end
    end

    ----------------------------------------------
    -- START/STOP V2
    ----------------------------------------------
    function m:StartV2()
        if self.IsRunningV2 then return end

        -- Stop V1 if running (mutually exclusive)
        if self.IsRunningV1 then
            self:StopV1()
            task.wait(0.5)
        end

        self.IsRunningV2 = true
        self.V2_Stage = "leveling" -- Always start from leveling
        SKILL_STUCK = {} -- Reset stuck detection state

        self:Notify("Elephant v.2 Started", "Two-stage automation started", Color3.fromRGB(100, 180, 255))

        -- Send initial webhook on start
        task.spawn(function()
            task.wait(1)
            self:SendElephantV2Webhook()
        end)

        task.spawn(function()
            self:PickupAllPets()
            task.wait(1)

            while self.IsRunningV2 do
                pcall(function()
                    self:StartAutoElephantV2()
                end)
                task.wait(5)
            end
        end)
    end

    function m:StopV2()
        local wasRunning = self.IsRunningV2
        self.IsRunningV2 = false


        if wasRunning then
            self:Notify("Elephant v.2 Stopped", "Auto elephant v.2 stopped", Color3.fromRGB(255, 150, 100))
            task.spawn(function()
                task.wait(0.5)
                self:PickupAllPets()
            end)
        end
    end

    return m

end

-- Module: module/performance.lua
EmbeddedModules["module/performance.lua"] = function()
    -- module/performance.lua
    -- Performance optimization module for hiding garden elements

    local m = {}

    local Core

    function m:Init(_core)
        Core = _core
    end

    -- Get player's own farm
    function m:GetMyFarm()
        local farms = Core.Workspace.Farm:GetChildren()
        for _, farm in pairs(farms) do
            local important = farm:FindFirstChild("Important")
            if important then
                local data = important:FindFirstChild("Data")
                if data then
                    local owner = data:FindFirstChild("Owner")
                    if owner and owner.Value == Core.LocalPlayer.Name then
                        return farm
                    end
                end
            end
        end
        return nil
    end

    -- Get all farms
    function m:GetAllFarms()
        return Core.Workspace.Farm:GetChildren()
    end

    -- Set visibility for plants in a farm
    function m:SetFarmPlantsVisibility(farm, visible)
        if not farm then return end

        local important = farm:FindFirstChild("Important")
        if not important then return end

        local plantsPhysical = important:FindFirstChild("Plants_Physical")
        if not plantsPhysical then return end

        for _, plant in pairs(plantsPhysical:GetDescendants()) do
            if plant:IsA("BasePart") then
                plant.Transparency = visible and 0 or 1
            elseif plant:IsA("Decal") or plant:IsA("Texture") then
                plant.Transparency = visible and 0 or 1
            elseif plant:IsA("ParticleEmitter") or plant:IsA("Trail") or plant:IsA("Beam") then
                plant.Enabled = visible
            elseif plant:IsA("BillboardGui") or plant:IsA("SurfaceGui") then
                plant.Enabled = visible
            end
        end
    end

    -- Set visibility for objects (sprinklers, etc) in a farm
    function m:SetFarmObjectsVisibility(farm, visible)
        if not farm then return end

        local important = farm:FindFirstChild("Important")
        if not important then return end

        local objectsPhysical = important:FindFirstChild("Objects_Physical")
        if not objectsPhysical then return end

        for _, obj in pairs(objectsPhysical:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Transparency = visible and 0 or 1
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = visible and 0 or 1
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                obj.Enabled = visible
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                obj.Enabled = visible
            end
        end
    end

    -- Hide/Show my garden plants
    function m:HideMyGardenPlants()
        local myFarm = self:GetMyFarm()
        if myFarm then
            self:SetFarmPlantsVisibility(myFarm, false)
        end
    end

    function m:ShowMyGardenPlants()
        local myFarm = self:GetMyFarm()
        if myFarm then
            self:SetFarmPlantsVisibility(myFarm, true)
        end
    end

    -- Hide/Show other gardens plants
    function m:HideOtherGardenPlants()
        local myFarm = self:GetMyFarm()
        local allFarms = self:GetAllFarms()

        for _, farm in pairs(allFarms) do
            if farm ~= myFarm then
                self:SetFarmPlantsVisibility(farm, false)
            end
        end
    end

    function m:ShowOtherGardenPlants()
        local myFarm = self:GetMyFarm()
        local allFarms = self:GetAllFarms()

        for _, farm in pairs(allFarms) do
            if farm ~= myFarm then
                self:SetFarmPlantsVisibility(farm, true)
            end
        end
    end

    -- Hide/Show my garden objects
    function m:HideMyGardenObjects()
        local myFarm = self:GetMyFarm()
        if myFarm then
            self:SetFarmObjectsVisibility(myFarm, false)
        end
    end

    function m:ShowMyGardenObjects()
        local myFarm = self:GetMyFarm()
        if myFarm then
            self:SetFarmObjectsVisibility(myFarm, true)
        end
    end

    -- Hide/Show other gardens objects
    function m:HideOtherGardenObjects()
        local myFarm = self:GetMyFarm()
        local allFarms = self:GetAllFarms()

        for _, farm in pairs(allFarms) do
            if farm ~= myFarm then
                self:SetFarmObjectsVisibility(farm, false)
            end
        end
    end

    function m:ShowOtherGardenObjects()
        local myFarm = self:GetMyFarm()
        local allFarms = self:GetAllFarms()

        for _, farm in pairs(allFarms) do
            if farm ~= myFarm then
                self:SetFarmObjectsVisibility(farm, true)
            end
        end
    end

    -- Remove spider web FX
    function m:RemoveSpiderWebFX()
        local workspace = game:GetService("Workspace")
        local petsFX = workspace:FindFirstChild("PetsFX")
        if not petsFX then return end

        for _, fx in pairs(petsFX:GetDescendants()) do
            if fx.Name:lower():find("spider") or fx.Name:lower():find("web") then
                pcall(function() fx:Destroy() end)
            end
        end
    end

    -- Auto remove spider web loop
    m.SpiderWebLoopRunning = false
    m.SpiderWebLoopToken = 0

    function m:StartAutoRemoveSpiderWebFX()
        if m.SpiderWebLoopRunning then return end
        m.SpiderWebLoopRunning = true
        m.SpiderWebLoopToken = m.SpiderWebLoopToken + 1
        local myToken = m.SpiderWebLoopToken

        task.spawn(function()
            while m.SpiderWebLoopRunning and myToken == m.SpiderWebLoopToken do
                pcall(function() self:RemoveSpiderWebFX() end)
                task.wait(1)
            end
        end)
    end

    function m:StopAutoRemoveSpiderWebFX()
        m.SpiderWebLoopRunning = false
        m.SpiderWebLoopToken = m.SpiderWebLoopToken + 1
    end

    return m

end

