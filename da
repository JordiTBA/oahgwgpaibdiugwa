    -- Get pet type options
    function m:GetPetTypeOptions()
        local petTypeOptions = {}
        if Pet and Pet.GetPetRegistry then
            local petRegistry = Pet:GetPetRegistry()
            for _, petInfo in ipairs(petRegistry) do
                table.insert(petTypeOptions, petInfo.Name)
            end
            table.sort(petTypeOptions, function(a, b)
                return string.lower(a) < string.lower(b)
            end)
        else
            petTypeOptions = {"Common", "Uncommon", "Rare", "Legendary", "Mythical"}
        end
        return petTypeOptions
    end

    -- Helper to get pet options including saved ones
    function m:GetPetOptionsWithSaved(savedTeamGuidsMap)
        local results = {}
        local lookup = {} -- name -> guid
        local seenGuids = {}

        -- 1. Get standard active pets (favorite pets)
        if Pet and Pet.GetActivePetsForDropdown then
            for _, item in ipairs(Pet:GetActivePetsForDropdown()) do
                table.insert(results, item)
                lookup[item.text] = item.value
                seenGuids[item.value] = true
            end
        end

        -- 2. Add saved pets if missing
        if savedTeamGuidsMap then
            for guid, _ in pairs(savedTeamGuidsMap) do
                if not seenGuids[guid] then
                    -- Fetch pet data manually
                    local petData = Pet:GetPetData(guid)
                    if petData then
                        -- Format display name (logic from Pet:GetActivePetsForDropdown)
                        local PD = petData.PetData or petData.Data or {}
                        local petType = petData.PetType or petData.Type or PD.Type or PD.PetType or "Unknown"
                        local age = PD.Level or PD.Age or petData.Level or petData.Age or 0
                        local baseWeight = PD.BaseWeight or petData.BaseWeight or 0

                        -- Weight scale per level (default 0.1)
                        local SCALE_PER_LVL = 0.1
                        local currentWeight = baseWeight * (1 + SCALE_PER_LVL * age)

                        -- Resolve mutation
                        local mutCode = PD.MutationType or petData.MutationType or ""
                        local mutName = ""
                        if mutCode ~= "" then
                            if Pet.MutationEnumMap and Pet.MutationEnumMap[mutCode] then
                                mutName = Pet.MutationEnumMap[mutCode]
                            else
                                mutName = mutCode
                            end
                            if mutName == "Gold" then mutName = "Golden" end
                        end

                        local displayName = ""
                        if mutName ~= "" then displayName = mutName .. " " end
                        displayName = displayName .. petType
                        displayName = displayName .. string.format(" Age %d", age)
                        displayName = displayName .. string.format(" %.2f KG", currentWeight)

                        local cleanGuid = tostring(guid):gsub("[{}]", "")
                        local shortGuid = string.sub(cleanGuid, 1, 8)
                        displayName = displayName .. " (" .. shortGuid .. ")"

                        -- Add to results
                        local item = {
                            text = displayName,
                            value = guid,
                            weight = currentWeight
                        }
                        table.insert(results, item)
                        lookup[item.text] = guid
                        seenGuids[guid] = true
                    else
                        -- Pet data not found (maybe deleted/traded?), add placeholder with GUID
                        local shortGuid = string.sub(tostring(guid), 1, 8)
                        local displayName = "Unknown Pet (" .. shortGuid .. ")"
                        local item = { text = displayName, value = guid, weight = 0 }
                        table.insert(results, item)
                        lookup[item.text] = guid
                        seenGuids[guid] = true
                    end
                end
            end
        end

        -- Sort by weight descending
        table.sort(results, function(a, b)
            return (a.weight or 0) > (b.weight or 0)
        end)

        -- Extract just names for dropdown
        local names = {}
        for _, item in ipairs(results) do
            table.insert(names, item.text)
        end

        if #names == 0 then table.insert(names, "No favorite pets") end

        return names, lookup
    end


