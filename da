    -- module/pet.lua
    -- Pet module untuk mengelola pet di Grow a Garden
    local m = {}

    local Core



    function m:Init(_core)
        Core = _core
        self:LoadMutationEnumMap()
    end

    -- Load mutation enum-to-display-name mapping from game's PetMutationRegistry
    function m:LoadMutationEnumMap()
        self.MutationEnumMap = {}
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local mutationModule = require(RS.Data.PetRegistry.PetMutationRegistry)
            if mutationModule.EnumToPetMutation then
                for enumVal, displayName in pairs(mutationModule.EnumToPetMutation) do
                    self.MutationEnumMap[enumVal] = displayName
                end
            end
        end)
    end

    -- Get pet replication data from game
    function m:GetPetReplicationData()
        local replicationClass = require(Core.ReplicatedStorage.Modules.ReplicationClass)
        local activePetsReplicator = replicationClass.new("ActivePetsService_Replicator")
        return activePetsReplicator:YieldUntilData().Table
    end

    -- Get all active pets for current player
    function m:GetActivePets()
        local success, replicationData = pcall(function()
            return self:GetPetReplicationData()
        end)

        if not success then
            warn("[Pet] Failed to get replication data:", replicationData)
            return {}
        end

        if not replicationData or not replicationData.ActivePetStates then
            warn("[Pet] Invalid replication data structure")
            return {}
        end

        local activePetStates = replicationData.ActivePetStates
        local playerName = Core.LocalPlayer.Name
        local playerId = tostring(Core.LocalPlayer.UserId)

        local playerPets = activePetStates[playerName]
                        or activePetStates[playerId]
                        or activePetStates[tonumber(playerId)]

        if not playerPets then
            warn("[Pet] No active pets found for player:", playerName)
            return {}
        end

        -- Convert to array of pet GUIDs
        local petGuids = {}
        for petGuid, petState in pairs(playerPets) do
            table.insert(petGuids, petGuid)
        end

        return petGuids
    end

    -- Get player pet data
    function m:GetPlayerPetData()
        local success, replicationData = pcall(self.GetPetReplicationData, self)
        if not success then
            warn("[Pet] Failed to get replication data:", tostring(replicationData))
            return nil
        end

        if not replicationData or not replicationData.PlayerPetData then
            warn("[Pet] Invalid PlayerPetData structure")
            return nil
        end

        local playerPetData = replicationData.PlayerPetData
        local playerName = Core.LocalPlayer.Name
        local playerId = tostring(Core.LocalPlayer.UserId)

        local playerData = playerPetData[playerName]
                        or playerPetData[playerId]
                        or playerPetData[tonumber(playerId)]

        if not playerData then
            warn("[Pet] No pet data found for player:", playerName)
            return nil
        end

        return playerData
    end

    -- Get pet data by GUID
    function m:GetPetData(petGuid)
        local playerData = self:GetPlayerPetData()
        if playerData and playerData.PetInventory then
            return playerData.PetInventory.Data[petGuid]
        end
        return nil
    end

    -- Get pet type name
    function m:GetPetType(petData)
        if not petData then return "Unknown" end
        return petData.PetType or "Unknown"
    end

    -- Get pet weight
    function m:GetPetWeight(petData)
        if not petData or not petData.PetData then return 0 end
        return petData.PetData.BaseWeight or 0
    end

    -- Get pet age (level)
    function m:GetPetAge(petData)
        if not petData or not petData.PetData then return 0 end
        return petData.PetData.Level or 0
    end

    -- Check if pet is favorited/locked
    function m:IsPetFavorited(petData)
        if not petData then return false end
        -- Check common favorite/lock flags in pet data
        if petData.Favorited then return true end
        if petData.IsFavorite then return true end
        if petData.IsFavorited then return true end
        if petData.Locked then return true end
        if petData.PetData then
            if petData.PetData.Favorited then return true end
            if petData.PetData.IsFavorite then return true end
            if petData.PetData.IsFavorited then return true end
            if petData.PetData.Locked then return true end
        end
        return false
    end

    -- Get all my pets with full data (like PandoraHub)
    function m:GetAllMyPets()
        local playerData = self:GetPlayerPetData()
        if not playerData or not playerData.PetInventory or not playerData.PetInventory.Data then
            return {}
        end

        local pets = {}
        local activePets = self:GetActivePets()
        local activePetsSet = {}
        for _, guid in ipairs(activePets) do
            activePetsSet[guid] = true
        end

        for petGuid, petData in pairs(playerData.PetInventory.Data) do
            local isActive = activePetsSet[petGuid] or false
            local isFavorited = self:IsPetFavorited(petData)

            table.insert(pets, {
                ID = petGuid,
                Type = self:GetPetType(petData),
                Age = self:GetPetAge(petData),
                BaseWeight = self:GetPetWeight(petData),
                IsActive = isActive,
                IsFavorited = isFavorited,
                RawData = petData
            })
        end

        -- Sort by type name
        table.sort(pets, function(a, b)
            return a.Type < b.Type
        end)

        return pets
    end

    -- Serialize pet for display in dropdown (like PandoraHub)
    function m:SerializePet(pet)
        if not pet then return "Unknown Pet" end

        local petType = pet.Type or "Unknown"
        local age = pet.Age or 0
        local weight = pet.BaseWeight or 0
        local activeStr = pet.IsActive and " [Active]" or ""
        local favStr = pet.IsFavorited and " [Fav]" or ""

        return string.format("%s (Age: %d, %.1fkg)%s%s", petType, age, weight, activeStr, favStr)
    end

    -- Get pet display name with details
    function m:GetPetDisplayName(petData)
        if not petData then return "Unknown Pet" end

        local petType = self:GetPetType(petData)
        local weight = self:GetPetWeight(petData)
        local level = (petData.PetData and petData.PetData.Level) or 0

        -- Get raw mutation code from multiple possible locations
        local rawMutation = nil
        if petData.MutationType and petData.MutationType ~= "" then
            rawMutation = petData.MutationType
        elseif petData.PetData and petData.PetData.MutationType and petData.PetData.MutationType ~= "" then
            rawMutation = petData.PetData.MutationType
        elseif petData.Mutation and petData.Mutation ~= "" then
            rawMutation = petData.Mutation
        end

        local mutationPrefix = ""
        if rawMutation then
            -- Resolve enum code to display name
            local displayName = rawMutation
            if self.MutationEnumMap and self.MutationEnumMap[rawMutation] then
                displayName = self.MutationEnumMap[rawMutation]
            end
            if displayName == "Gold" then
                displayName = "Golden"
            end
            mutationPrefix = displayName .. " - "
        end

        return string.format("%s%s (%.2f KG, Age %d)", mutationPrefix, petType, weight, level)
    end

    -- Equip pet
    function m:EquipPet(petGuid)
        if not petGuid then
            warn("[Pet] Invalid pet GUID provided")
            return false
        end

        local success = pcall(function()
            -- Use farm center as default position
            local position = CFrame.new(0, 0, 0)

            Core.ReplicatedStorage.GameEvents.PetsService:FireServer(
                "EquipPet",
                petGuid,
                position
            )
        end)

        if not success then
            warn("[Pet] Failed to equip pet:", petGuid)
            return false
        end

        return true
    end

    -- Unequip pet
    function m:UnequipPet(petGuid)
        if not petGuid then
            warn("[Pet] Invalid pet GUID provided")
            return false
        end

        local success = pcall(function()
            Core.ReplicatedStorage.GameEvents.PetsService:FireServer(
                "UnequipPet",
                petGuid
            )
        end)

        if not success then
            warn("[Pet] Failed to unequip pet:", petGuid)
            return false
        end

        return true
    end

    -- Find which egg contains a specific pet
    function m:FindEggByPetName(petName)
        local success, eggRegistry = pcall(function()
            return require(Core.ReplicatedStorage.Data.EggRegistry)
        end)

        if not success then
            -- warn("[Pet] Failed to get egg registry:", eggRegistry)
            return "Unknown Egg"
        end

        local eggList = eggRegistry.EggList
        if not eggList then
            warn("[Pet] EggList is nil or not found")
            return "Unknown Egg"
        end

        -- Search through all eggs
        for eggName, eggData in pairs(eggList) do
            if eggData.RarityData and eggData.RarityData.Items then
                -- Check if the pet exists in this egg
                if eggData.RarityData.Items[petName] then
                    return eggName
                end
            end
        end

        return "Unknown Egg"
    end

    -- Get pet registry with all available pet types
    function m:GetPetRegistry()
        local success, petRegistry = pcall(function()
            return require(Core.ReplicatedStorage.Data.PetRegistry)
        end)

        if not success then
            warn("[Pet] Failed to get pet registry:", petRegistry)
            return {}
        end

        local petList = petRegistry.PetList
        if not petList then
            warn("[Pet] PetList is nil or not found")
            return {}
        end

        -- Convert PetList to UI format
        local listPets = {}
        for petName, petData in pairs(petList) do
            local eggName = self:FindEggByPetName(petName)
            table.insert(listPets, {
                Name = petName,
                Rarity = petData.Rarity or "Unknown",
                Egg = eggName
            })
        end

        if #listPets < 1 then
            return {}
        end

        -- Sort pets by egg name, then alphabetically
        table.sort(listPets, function(a, b)
            local eggA = a.Egg or "Unknown"
            local eggB = b.Egg or "Unknown"
            if eggA ~= eggB then
                return string.lower(tostring(eggA)) < string.lower(tostring(eggB))
            end
            return string.lower(tostring(a.Name)) < string.lower(tostring(b.Name))
        end)

        return listPets
    end

    -- Get all pets in inventory
    function m:GetAllPetsInInventory()
        local playerData = self:GetPlayerPetData()
        if not playerData or not playerData.PetInventory then
            return {}
        end

        return playerData.PetInventory.Data or {}
    end

    -- Get all owned pet tools from backpack (for gifting)
    function m:GetAllOwnedPets()
        local myPets = {}

        -- Get backpack
        local backpack = Core:GetBackpack()
        if not backpack then
            warn("[Pet] Failed to get backpack")
            return myPets
        end

        -- Loop through all tools in backpack
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                -- Check if tool is a pet (attribute "b" == "l")
                local toolType = tool:GetAttribute("b")
                if toolType == "l" then
                    table.insert(myPets, tool)
                end
            end
        end

        return myPets
    end

    -- Get favorite pets from inventory for dropdown (not just equipped)
    function m:GetActivePetsForDropdown()
        local results = {}

        local playerData = self:GetPlayerPetData()
        if not playerData or not playerData.PetInventory or not playerData.PetInventory.Data then
            return results
        end

        -- Weight scale per level
        local SCALE_PER_LVL = 0.1
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local petReg = require(RS.Data.PetRegistry)
            if petReg and petReg.PetConfig and petReg.PetConfig.WEIGHT_CONFIG then
                SCALE_PER_LVL = petReg.PetConfig.WEIGHT_CONFIG.SCALE_PERCENTAGE_OF_BASE_WEIGHT_PER_LEVEL or 0.1
            end
        end)

        local petInventory = playerData.PetInventory.Data

        for guid, rec in pairs(petInventory) do
            if type(rec) == "table" then
                local PD = rec.PetData or rec.Data or {}

                local isFavorite = self:IsPetFavorited(rec)
                if isFavorite then
                    local petType = rec.PetType or rec.Type or PD.Type or PD.PetType or "Unknown"
                    local age = PD.Level or PD.Age or rec.Level or rec.Age or 0
                    local baseWeight = PD.BaseWeight or rec.BaseWeight or 0
                    local currentWeight = baseWeight * (1 + SCALE_PER_LVL * age)

                    -- Resolve mutation code to display name
                    local mutCode = PD.MutationType or rec.MutationType or ""
                    local mutName = ""
                    if mutCode ~= "" then
                        if self.MutationEnumMap and self.MutationEnumMap[mutCode] then
                            mutName = self.MutationEnumMap[mutCode]
                        else
                            mutName = mutCode
                        end
                        if mutName == "Gold" then mutName = "Golden" end
                    end

                    -- Build display: "MutName PetType Age X Y.YY KG (shortGuid)"
                    local displayName = ""
                    if mutName ~= "" then
                        displayName = mutName .. " "
                    end
                    displayName = displayName .. petType
                    displayName = displayName .. string.format(" Age %d", age)
                    displayName = displayName .. string.format(" %.2f KG", currentWeight)

                    local cleanGuid = tostring(guid):gsub("[{}]", "")
                    local shortGuid = string.sub(cleanGuid, 1, 8)
                    displayName = displayName .. " (" .. shortGuid .. ")"

                    table.insert(results, {
                        text = displayName,
                        value = guid,
                        weight = currentWeight
                    })
                end
            end
        end

        -- Sort by weight descending (heaviest first)
        table.sort(results, function(a, b)
            return (a.weight or 0) > (b.weight or 0)
        end)

        return results
    end

    return m

end

-- Module: pet_team/ui_pandoruy.lua
EmbeddedModules["pet_team/ui_pandoruy.lua"] = function()
    -- pet_team/ui_pandoruy.lua
    -- UI untuk Pet Team Tab menggunakan PandoruyHub Library
    local m = {}

    -- Module references
    local Window
    local PetTeam
    local Pet
    local Core
    local PandoruyHub
    local SwapSkillModule = nil
    local HttpService = game:GetService("HttpService")

    -- Storage (username-based path set in Init)
    local SAVE_BASE = "Pandora_KG"
    local SAVE_DIR = SAVE_BASE
    local SAVE_FILE = SAVE_DIR .. "/petteam_config.json"

    -- Swap Skill state (shared with SwapSkill module)
    local SwapSkillState = { swap_skill = { enabled = false, scanInterval = 0.1, selected = {}, delays = {} } }

    -- Save config to file
    function m:SaveConfig()
        pcall(function()
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local G = getgenv and getgenv() or _G
            local payload = {
                swapSkill = SwapSkillState.swap_skill,
                autoBoostEnabled = G.AUTO_BOOST_ENABLED or false,
                autoFeedEnabled = G.AUTO_FEED_ENABLED or false,
                autoCollectFruitEnabled = G.AUTO_COLLECT_FRUIT_ENABLED or false,
                _ts = os.time()
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
        end)
    end

    -- Load config from file
    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            return false
        end

        local success = pcall(function()
            local text = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(text)
            local G = getgenv and getgenv() or _G

            -- Load swap_skill state (new system)
            if data.swapSkill and type(data.swapSkill) == "table" then
                if data.swapSkill.enabled ~= nil then
                    SwapSkillState.swap_skill.enabled = data.swapSkill.enabled
                end
                if data.swapSkill.scanInterval then
                    SwapSkillState.swap_skill.scanInterval = tonumber(data.swapSkill.scanInterval) or 0.1
                end
                if type(data.swapSkill.selected) == "table" then
                    SwapSkillState.swap_skill.selected = data.swapSkill.selected
                end
                if type(data.swapSkill.delays) == "table" then
                    SwapSkillState.swap_skill.delays = data.swapSkill.delays
                end
            end
            -- Backward compat: ignore old autoPickupEnabled

            if data.autoBoostEnabled ~= nil then
                G.AUTO_BOOST_ENABLED = data.autoBoostEnabled
            end
            if data.autoFeedEnabled ~= nil then
                G.AUTO_FEED_ENABLED = data.autoFeedEnabled
            end
            if data.autoCollectFruitEnabled ~= nil then
                G.AUTO_COLLECT_FRUIT_ENABLED = data.autoCollectFruitEnabled
            end
        end)

        return success
    end

    function m:Init(tab, window, petTeam, pet, core, pandoruyHub, swapSkill, swapSkillState)
        Window = window
        PetTeam = petTeam
        Pet = pet
        Core = core
        PandoruyHub = pandoruyHub
        SwapSkillModule = swapSkill

        -- Use externally provided state if available
        if swapSkillState then
            SwapSkillState = swapSkillState
        end

        -- Set username-based save path
        local Players = game:GetService("Players")
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/petteam_config.json"

        -- Load saved config
        self:LoadConfig()

        self:CreatePetTeamTab(tab)

        -- Auto-resume: start if toggles were enabled
        task.spawn(function()
            task.wait(3) -- Wait for UI and modules to fully load
            local G = getgenv and getgenv() or _G

            -- Auto-resume SwapSkill
            if SwapSkillState.swap_skill.enabled and SwapSkillModule then
                local hasSelected = SwapSkillState.swap_skill.selected and next(SwapSkillState.swap_skill.selected)
                if hasSelected then
                    print("[PetTeam] Auto-resuming SwapSkill...")
                    SwapSkillModule:Start()
                end
            end

            if G.AUTO_BOOST_ENABLED then
                print("[PetTeam] Auto-resuming Auto Boost...")
                local BoostMod = G.AutoKGBoost
                if BoostMod and BoostMod.start then
                    pcall(BoostMod.start)
                end
            end

            if G.AUTO_FEED_ENABLED then
                print("[PetTeam] Auto-resuming Auto Feed...")
                local FeedMod = G.AutoFeed or G.AutoKGFeed
                if FeedMod and FeedMod.start then
                    pcall(FeedMod.start)
                end
            end

            if G.AUTO_COLLECT_FRUIT_ENABLED then
                print("[PetTeam] Auto-resuming Auto Collect Fruit...")
                local CollectMod = G.AutoCollectFruit
                if CollectMod and CollectMod.start then
                    pcall(CollectMod.start)
                end
            end
        end)
    end

    function m:CreatePetTeamTab(tab)
        self:AddSwapSkillSection(tab)
        self:AddAutoBoostSection(tab)
        self:AddAutoFeedSection(tab)
    end

    -- Helper to get pet options including saved ones
    function m:GetPetOptionsWithSaved(savedTeamGuidsMap)
        local results = {}
        local lookup = {} -- name -> guid
        local seenGuids = {}

        -- 1. Get standard active pets (favorite pets)
        if Pet and Pet.GetActivePetsForDropdown then
            for _, item in ipairs(Pet:GetActivePetsForDropdown()) do
                table.insert(results, item)
                lookup[item.text] = item.value
                seenGuids[item.value] = true
            end
        end

        -- 2. Add saved pets if missing
        if savedTeamGuidsMap then
            for guid, _ in pairs(savedTeamGuidsMap) do
                if not seenGuids[guid] then
                    -- Fetch pet data manually
                    local petData = Pet:GetPetData(guid)
                    if petData then
                        -- Format display name (logic from Pet:GetActivePetsForDropdown)
                        local PD = petData.PetData or petData.Data or {}
                        local petType = petData.PetType or petData.Type or PD.Type or PD.PetType or "Unknown"
                        local age = PD.Level or PD.Age or petData.Level or petData.Age or 0
                        local baseWeight = PD.BaseWeight or petData.BaseWeight or 0

                        -- Weight scale per level (default 0.1)
                        local SCALE_PER_LVL = 0.1
                        local currentWeight = baseWeight * (1 + SCALE_PER_LVL * age)

                        -- Resolve mutation
                        local mutCode = PD.MutationType or petData.MutationType or ""
                        local mutName = ""
                        if mutCode ~= "" then
                            if Pet.MutationEnumMap and Pet.MutationEnumMap[mutCode] then
                                mutName = Pet.MutationEnumMap[mutCode]
                            else
                                mutName = mutCode
                            end
                            if mutName == "Gold" then mutName = "Golden" end
                        end

                        local displayName = ""
                        if mutName ~= "" then displayName = mutName .. " " end
                        displayName = displayName .. petType
                        displayName = displayName .. string.format(" Age %d", age)
                        displayName = displayName .. string.format(" %.2f KG", currentWeight)

                        local cleanGuid = tostring(guid):gsub("[{}]", "")
                        local shortGuid = string.sub(cleanGuid, 1, 8)
                        displayName = displayName .. " (" .. shortGuid .. ")"

                        -- Add to results
                        local item = {
                            text = displayName,
                            value = guid,
                            weight = currentWeight
                        }
                        table.insert(results, item)
                        lookup[item.text] = guid
                        seenGuids[guid] = true
                    else
                        -- Pet data not found (maybe deleted/traded?), add placeholder with GUID
                        local shortGuid = string.sub(tostring(guid), 1, 8)
                        local displayName = "Unknown Pet (" .. shortGuid .. ")"
                        local item = { text = displayName, value = guid, weight = 0 }
                        table.insert(results, item)
                        lookup[item.text] = guid
                        seenGuids[guid] = true
                    end
                end
            end
        end

        -- Sort by weight descending
        table.sort(results, function(a, b)
            return (a.weight or 0) > (b.weight or 0)
        end)

        -- Extract just names for dropdown
        local names = {}
        for _, item in ipairs(results) do
            table.insert(names, item.text)
        end

        if #names == 0 then table.insert(names, "No favorite pets") end

        return names, lookup
    end

    function m:AddSwapSkillSection(tab)
        local section = tab:AddSection("Auto Pickup Pet")

        m.PickupLookup = {}

        local savedPetsPickup = SwapSkillState.swap_skill.selected or {}
        local optionsPickup, lookupPickup = self:GetPetOptionsWithSaved(savedPetsPickup)
        m.PickupLookup = lookupPickup

        local defaultsPickup = {}
        for name, guid in pairs(lookupPickup) do
            if savedPetsPickup[guid] then
                table.insert(defaultsPickup, name)
            end
        end

        -- Pet selection dropdown
        section:AddDropdown({
            Title = "Select Pets for Pickup",
            Content = "Choose pets to auto pickup",
            Options = optionsPickup,
            Multi = true,
            Default = defaultsPickup,
            OnOpen = function()
                local currentSaved = SwapSkillState.swap_skill.selected or {}
                local newOpts, newLookup = self:GetPetOptionsWithSaved(currentSaved)
                m.PickupLookup = newLookup
                return newOpts
            end,
            Callback = function(selectedNames)
                local selected = {}
                local currentLookup = m.PickupLookup or {}
                for _, name in ipairs(selectedNames) do
                    local guid = currentLookup[name]
                    if guid and guid ~= "" then
                        selected[guid] = true
                        -- Ensure delay exists
                        if SwapSkillModule then
                            SwapSkillModule:AddPet(guid)
                        end
                    end
                end
                SwapSkillState.swap_skill.selected = selected
                self:SaveConfig()
            end
        })

        -- Swap cooldown
        section:AddInput({
            Title = "Swap Cooldown (Seconds)",
            Content = "Min delay between swaps per pet",
            Default = tostring(SwapSkillState.swap_skill.scanInterval or 0.1),
            Callback = function(value)
                local num = tonumber(value)
                if num and num > 0 then
                    SwapSkillState.swap_skill.scanInterval = num
                    if SwapSkillModule then
                        SwapSkillModule:SetScanInterval(num)
                    end
                    self:SaveConfig()
                end
            end
        })

        -- Default pickup delay (unequipAfterReady)
        section:AddInput({
            Title = "Pickup Delay (Seconds)",
            Content = "Delay after skill ready before unequip",
            Default = "1",
            Callback = function(value)
                local num = tonumber(value)
                if num and num >= 0 and SwapSkillModule then
                    -- Apply to all selected pets
                    for uuid, on in pairs(SwapSkillState.swap_skill.selected or {}) do
                        if on then
                            SwapSkillModule:SetDelay(uuid, num, nil)
                        end
                    end
                    self:SaveConfig()
                end
            end
        })

        -- Default equip delay (equipNext)
        section:AddInput({
            Title = "Equip Delay (Seconds)",
            Content = "Delay after unequip before re-equip",
            Default = "0.2",
            Callback = function(value)
                local num = tonumber(value)
                if num and num >= 0 and SwapSkillModule then
                    -- Apply to all selected pets
                    for uuid, on in pairs(SwapSkillState.swap_skill.selected or {}) do
                        if on then
                            SwapSkillModule:SetDelay(uuid, nil, num)
                        end
                    end
                    self:SaveConfig()
                end
            end
        })

        -- Enable toggle
        local PetTeamUI = self
        section:AddToggle({
            Title = "Enable Auto Pickup",
            Content = "Auto unequip+equip when skill cooldown ready",
            Default = SwapSkillState.swap_skill.enabled or false,
            Callback = function(enabled)
                SwapSkillState.swap_skill.enabled = enabled

                if SwapSkillModule then
                    if enabled then
                        SwapSkillModule:Start()
                        if PandoruyHub and PandoruyHub.MakeNotify then
                            PandoruyHub:MakeNotify({
                                Title = "Auto Pickup",
                                Content = "Started",
                                Color = Color3.fromRGB(100, 255, 100),
                                Duration = 3
                            })
                        end
                    else
                        local wasRunning = SwapSkillModule:IsRunning()
                        SwapSkillModule:Stop()
                        if wasRunning and PandoruyHub and PandoruyHub.MakeNotify then
                            PandoruyHub:MakeNotify({
                                Title = "Auto Pickup",
                                Content = "Stopped",
                                Color = Color3.fromRGB(255, 200, 100),
                                Duration = 2
                            })
                        end
                    end
                end
                PetTeamUI:SaveConfig()
            end
        })
    end

    -- Auto Boost Section (like auto_kg)
    function m:AddAutoBoostSection(tab)
        local section = tab:AddSection("Auto Boost Pet")

        -- Load boost module
        local BoostModule = nil
        pcall(function()
            local G = getgenv and getgenv() or _G
            BoostModule = G.AutoKGBoost
            if not BoostModule then
                BoostModule = require('module/boost.lua')
                G.AutoKGBoost = BoostModule
            end
        end)

        -- Pet name-to-GUID mapping for boost dropdown
        local boostPetNameToGuid = {}

        -- Get active pets for dropdown (same pattern as Auto Pickup)
        local function getBoostPetOptions()
            boostPetNameToGuid = {}
            local options = {}

            if Pet and Pet.GetActivePetsForDropdown then
                local petData = Pet:GetActivePetsForDropdown()
                for _, item in ipairs(petData) do
                    local displayName = item.text or "Unknown"
                    local guid = item.value or ""
                    table.insert(options, displayName)
                    boostPetNameToGuid[displayName] = guid
                end
            end

            if #options == 0 then
                table.insert(options, "No favorite pets in inventory")
            end
            return options
        end

        -- Initialize global config
        local G = getgenv and getgenv() or _G
        G.SELECTED_BOOST_PETS = G.SELECTED_BOOST_PETS or {}
        G.PETBOOST_SELECTED = G.PETBOOST_SELECTED or {}
        G.AUTO_BOOST_DELAY = G.AUTO_BOOST_DELAY or 20
        G.AUTO_BOOST_ENABLED = G.AUTO_BOOST_ENABLED or false

        m.BoostLookup = {}

        local savedPetsBoost = G.SELECTED_BOOST_PETS or {}
        local optionsBoost, lookupBoost = self:GetPetOptionsWithSaved(savedPetsBoost)
        m.BoostLookup = lookupBoost

        local defaultsBoost = {}
        for name, guid in pairs(lookupBoost) do
            if savedPetsBoost[guid] then
                table.insert(defaultsBoost, name)
            end
        end

        -- Select Pets to Boost (multi-select by GUID)
        section:AddDropdown({
            Title = "Select Pets to Boost",
            Content = "Choose pets to auto boost",
            Options = optionsBoost,
            Multi = true,
            Default = defaultsBoost,
            OnOpen = function()
                local currentSaved = G.SELECTED_BOOST_PETS or {}
                local newOpts, newLookup = self:GetPetOptionsWithSaved(currentSaved)
                m.BoostLookup = newLookup
                return newOpts
            end,
            Callback = function(selectedNames)
                G.SELECTED_BOOST_PETS = {}
                local currentLookup = m.BoostLookup or {}
                for _, name in ipairs(selectedNames) do
                    local guid = currentLookup[name]
                    if guid and guid ~= "" then
                        G.SELECTED_BOOST_PETS[guid] = true
                    end
                end
            end
