        -- Boost Delay Input
        section:AddInput({
            Title = "Boost Delay (Seconds)",
            Default = tostring(G.AUTO_BOOST_DELAY),
            Callback = function(value)
                local delay = tonumber(value)
                if delay and delay > 0 then
                    G.AUTO_BOOST_DELAY = delay
                    if BoostModule and BoostModule.setDelay then
                        BoostModule.setDelay(delay)
                    end
                end
            end
        })

        -- Auto Boost Toggle
        local PetTeamUI = self
        section:AddToggle({
            Title = "Enable Auto Boost",
            Default = G.AUTO_BOOST_ENABLED or false,
            Callback = function(enabled)
                G.AUTO_BOOST_ENABLED = enabled

                -- Fetch BoostModule at runtime (not at UI creation time)
                local RuntimeBoostModule = nil
                pcall(function()
                    local GG = getgenv and getgenv() or _G
                    RuntimeBoostModule = GG.AutoKGBoost
                end)

                if RuntimeBoostModule then
                    if enabled then
                        RuntimeBoostModule.start()
                    else
                        RuntimeBoostModule.stop()
                    end
                end
                PetTeamUI:SaveConfig()
            end
        })
    end

    -- Auto Feed Section (like auto_kg)
    function m:AddAutoFeedSection(tab)
        local section = tab:AddSection("Auto Feed Pet")

        -- Get Feed module
        local FeedModule = nil
        pcall(function()
            local G = getgenv and getgenv() or _G
            FeedModule = G.AutoFeed or G.AutoKGFeed
        end)

        -- Pet name-to-GUID mapping for feed dropdown
        local feedPetNameToGuid = {}

        -- Get active pets for dropdown (same pattern as Auto Pickup)
        local function getFeedPetOptions()
            feedPetNameToGuid = {}
            local options = {}

            if Pet and Pet.GetActivePetsForDropdown then
                local petData = Pet:GetActivePetsForDropdown()
                for _, item in ipairs(petData) do
                    local displayName = item.text or "Unknown"
                    local guid = item.value or ""
                    table.insert(options, displayName)
                    feedPetNameToGuid[displayName] = guid
                end
            end

            if #options == 0 then
                table.insert(options, "No favorite pets in inventory")
            end
            return options
        end

        -- Initialize global config
        local G = getgenv and getgenv() or _G
        G.AUTO_FEED_ENABLED = G.AUTO_FEED_ENABLED or false
        G.AUTO_FEED_PETS_SELECTED = G.AUTO_FEED_PETS_SELECTED or {}
        G.AUTO_FEED_FRUITS_SELECTED = G.AUTO_FEED_FRUITS_SELECTED or {}
        G.AUTO_FEED_HUNGER_UNDER = G.AUTO_FEED_HUNGER_UNDER or 60000

        m.FeedLookup = {}

        local savedPetsFeed = G.AUTO_FEED_PETS_SELECTED or {}
        local optionsFeed, lookupFeed = self:GetPetOptionsWithSaved(savedPetsFeed)
        m.FeedLookup = lookupFeed

        local defaultsFeed = {}
        for name, guid in pairs(lookupFeed) do
            if savedPetsFeed[guid] then
                table.insert(defaultsFeed, name)
            end
        end

        -- Select Pets to Feed (multi-select by GUID)
        section:AddDropdown({
            Title = "Select Pets to Feed",
            Content = "Choose pets to auto feed",
            Options = optionsFeed,
            Multi = true,
            Default = defaultsFeed,
            OnOpen = function()
                local currentSaved = G.AUTO_FEED_PETS_SELECTED or {}
                local newOpts, newLookup = self:GetPetOptionsWithSaved(currentSaved)
                m.FeedLookup = newLookup
                return newOpts
            end,
            Callback = function(selectedNames)
                G.AUTO_FEED_PETS_SELECTED = {}
                local currentLookup = m.FeedLookup or {}
                for _, name in ipairs(selectedNames) do
                    local guid = currentLookup[name]
                    if guid and guid ~= "" then
                        G.AUTO_FEED_PETS_SELECTED[guid] = true
                    end
                end
                -- Sync to Feed module (fetch at runtime)
                local FeedMod = G.AutoFeed or G.AutoKGFeed or _G.AutoFeed or _G.AutoKGFeed
                if FeedMod and FeedMod.setPets then
                    pcall(function() FeedMod.setPets(G.AUTO_FEED_PETS_SELECTED) end)
                end
            end
        })

        -- Get fruit items from inventory (Holdable items)
        local function getFruitItems()
            local items = {}
            pcall(function()
                local DataService = require(game:GetService("ReplicatedStorage").Modules.DataService)
                local profile = DataService:GetData()
                if profile and profile.InventoryData then
                    local seen = {}
                    for _, itemRec in pairs(profile.InventoryData) do
                        if type(itemRec) == "table" and itemRec.ItemType == "Holdable" then
                            local itemData = itemRec.ItemData
                            if type(itemData) == "table" and itemData.ItemName then
                                local name = tostring(itemData.ItemName)
                                if not seen[name] then
                                    seen[name] = true
                                    table.insert(items, name)
                                end
                            end
                        end
                    end
                end
            end)
            table.sort(items)
            if #items == 0 then
                table.insert(items, "No fruit items found")
            end
            return items
        end

        -- Select Fruits to Feed (multi-select)
        section:AddDropdown({
            Title = "Select Fruit to Feed",
            Options = getFruitItems(),
            Multi = true,
            Flag = "FeedFruitsSelected",
            OnOpen = function()
                return getFruitItems()
            end,
            Callback = function(selected)
                G.AUTO_FEED_FRUITS_SELECTED = {}
                for _, fruit in ipairs(selected) do
                    G.AUTO_FEED_FRUITS_SELECTED[fruit] = true
                end
                -- Sync to Feed module (fetch at runtime)
                local FeedMod = G.AutoFeed or G.AutoKGFeed or _G.AutoFeed or _G.AutoKGFeed
                if FeedMod and FeedMod.setFruits then
                    pcall(function() FeedMod.setFruits(G.AUTO_FEED_FRUITS_SELECTED) end)
                end
            end
        })

        -- Max hunger value (100% = full hunger bar) - actual game max is ~30000
        local MAX_HUNGER = 30000

        -- Convert current threshold to percentage for default
        local currentPercent = math.floor((G.AUTO_FEED_HUNGER_UNDER / MAX_HUNGER) * 100)
        if currentPercent > 100 then currentPercent = 100 end
        if currentPercent < 1 then currentPercent = 50 end

        -- Hunger Threshold Slider (percentage)
        section:AddSlider({
            Title = "Feed If Hunger Under (%)",
            Min = 1,
            Max = 100,
            Increment = 1,
            Default = currentPercent,
            Callback = function(percent)
                -- Convert percentage to actual hunger value
                local threshold = math.floor((percent / 100) * MAX_HUNGER)
                G.AUTO_FEED_HUNGER_UNDER = threshold
                -- Fetch at runtime
                local FeedMod = G.AutoFeed or G.AutoKGFeed or _G.AutoFeed or _G.AutoKGFeed
                if FeedMod and FeedMod.setHungerUnder then
                    pcall(function() FeedMod.setHungerUnder(threshold) end)
                end
            end
        })

        -- Auto Feed Toggle
        local PetTeamUI = self
        section:AddToggle({
            Title = "Enable Auto Feed Pet",
            Default = G.AUTO_FEED_ENABLED or false,
            Callback = function(enabled)
                G.AUTO_FEED_ENABLED = enabled

                -- Fetch FeedModule at runtime (not at UI creation time)
                local FeedMod = G.AutoFeed or G.AutoKGFeed or _G.AutoFeed or _G.AutoKGFeed

                if FeedMod then
                    if enabled then
                        if FeedMod.start then
                            pcall(FeedMod.start)
                        end
                    else
                        if FeedMod.stop then
                            pcall(FeedMod.stop)
                        end
                    end
                end
                PetTeamUI:SaveConfig()
            end
        })

        -- Auto Collect Fruit Toggle
        G.AUTO_COLLECT_FRUIT_ENABLED = G.AUTO_COLLECT_FRUIT_ENABLED or false

        section:AddToggle({
            Title = "Enable Auto Collect Fruit",
            Default = G.AUTO_COLLECT_FRUIT_ENABLED or false,
            Callback = function(enabled)
                G.AUTO_COLLECT_FRUIT_ENABLED = enabled

                local CollectFruitModule = G.AutoCollectFruit or _G.AutoCollectFruit

                if CollectFruitModule then
                    if enabled then
                        if CollectFruitModule.start then
                            pcall(CollectFruitModule.start)
                        end
                    else
                        if CollectFruitModule.stop then
                            pcall(CollectFruitModule.stop)
                        end
                    end
                end
                PetTeamUI:SaveConfig()
            end
        })
    end

    return m

end

-- Module: leveling/leveling.lua
EmbeddedModules["leveling/leveling.lua"] = function()
    -- leveling/leveling.lua
    -- Backend logic untuk auto leveling pets
    local m = {}

    local Core
    local Pet
    local PetTeam
    local HttpService = game:GetService("HttpService")

    -- Storage (username-based path set in Init)
    local SAVE_BASE = "Pandora_KG"
    local SAVE_DIR = SAVE_BASE
    local SAVE_FILE = SAVE_DIR .. "/leveling_config.json"

    -- State
    m.IsRunning = false
    m.SelectedTeamPets = {} -- {guid = true} set of pet GUIDs
    m.TargetLevel = 100
    m.MaxPetsInGarden = 3
    m.SelectedPetTypes = {}
    m.OnNotify = nil       -- Callback for notifications

    -- Skill Stuck Detection (same as auto_kg)
    m.SkillStuckEnabled = true
    m.SkillStuckThreshold = 15
    m.SkillStuckTolerance = 0.1
    local SKILL_STUCK = {}
    local ALL_SKILL_TOKENS = {
        "rainbow jumbo blessing", "jumbo blessing", "jumbo",
        "friendly frier", "mining", "rainbow frilled reptile"
    }

    -- Save config to file
    function m:SaveConfig()
        pcall(function()
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local payload = {
                selectedTeamPets = self.SelectedTeamPets,
                targetLevel = self.TargetLevel,
                maxPetsInGarden = self.MaxPetsInGarden,
                selectedPetTypes = self.SelectedPetTypes,
                wasRunning = self.IsRunning, -- Save toggle state
                _ts = os.time()
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
            -- print("[Leveling] Config saved")
        end)
    end

    -- Load config from file
    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            -- print("[Leveling] No saved config, using defaults")
            return false
        end

        local success, err = pcall(function()
            local text = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(text)

            -- New format: direct pet GUIDs set
            if type(data.selectedTeamPets) == "table" then
                self.SelectedTeamPets = {}
                for guid, v in pairs(data.selectedTeamPets) do
                    if v then self.SelectedTeamPets[guid] = true end
                end
            elseif data.selectedTeam and data.selectedTeam ~= "" and PetTeam and PetTeam.GetTeam then
                -- Backward-compat: migrate from named team
                local team = PetTeam:GetTeam(data.selectedTeam)
                if team and team.pets then
                    self.SelectedTeamPets = {}
                    for _, guid in ipairs(team.pets) do
                        self.SelectedTeamPets[guid] = true
                    end
                end
            end
            if type(data.targetLevel) == "number" then
                self.TargetLevel = data.targetLevel
            end
            if type(data.maxPetsInGarden) == "number" then
                self.MaxPetsInGarden = data.maxPetsInGarden
            end
            if type(data.selectedPetTypes) == "table" then
                self.SelectedPetTypes = {}
                for petType, isSelected in pairs(data.selectedPetTypes) do
                    if isSelected then
                        self.SelectedPetTypes[petType] = true
                    end
                end
            end

            -- Load saved running state for auto-resume
            self.WasRunning = data.wasRunning == true
        end)

        if not success then
            -- warn("[Leveling] Failed to load config:", err)
            return false
        end

        return true
    end

    function m:Init(_core, _pet, _petTeam)
        Core = _core
        Pet = _pet
        PetTeam = _petTeam

        -- Set username-based save path
        local Players = game:GetService("Players")
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/leveling_config.json"

        -- Load saved config
        self:LoadConfig()
        -- Auto-resume is now handled in UI init (leveling/ui_pandoruy.lua)
    end

    -- Send notification via callback
    function m:Notify(title, content, color)
        if self.OnNotify then
            self.OnNotify(title, content, color)
        end
    end

    -- Get skill cooldown for stuck detection (same as auto_kg)
    function m:GetSkillCooldown(uuid, tokens)
        if not uuid or uuid == "" then return nil end
        tokens = tokens or ALL_SKILL_TOKENS

        local cooldowns = nil
        pcall(function()
            local GameEvents = Core.ReplicatedStorage:WaitForChild("GameEvents", 2)
            local GetPetCooldownRF = GameEvents:WaitForChild("GetPetCooldown", 2)
            if GetPetCooldownRF then
                cooldowns = GetPetCooldownRF:InvokeServer(uuid)
            end
        end)

        if type(cooldowns) ~= "table" then return nil end

        for _, cd in ipairs(cooldowns) do
            local skill = string.lower(tostring(cd.Skill or cd.Passive or ""))
            for _, token in ipairs(tokens) do
                if skill:find(token, 1, true) then
                    local time = cd.Time
                    if type(time) == "number" then return time end
                    if type(time) == "string" then
                        local m, s = time:match("^(%d+)%s*:%s*(%d+)$")
                        if m and s then return tonumber(m) * 60 + tonumber(s) end
                        return tonumber(time:match("%-?%d+%.?%d*")) or 0
                    end
                end
            end
        end
        return nil
    end

    -- Check and fix stuck pets (same as auto_kg)
    function m:CheckStuckPets()
        if not self.SkillStuckEnabled then return end

        local activePets = Pet:GetActivePets() or {}
        local stuckPets = {}

        for _, guid in ipairs(activePets) do
            local cooldown = self:GetSkillCooldown(guid, ALL_SKILL_TOKENS)
            local rec = SKILL_STUCK[guid] or { lastCooldown = nil, sameCount = 0 }

            if cooldown == nil then
                rec.lastCooldown, rec.sameCount = nil, 0
            else
                if rec.lastCooldown ~= nil then
                    local diff = cooldown - rec.lastCooldown
                    if diff >= -self.SkillStuckTolerance then
                        rec.sameCount = (rec.sameCount or 0) + 1
                    else
                        rec.sameCount = 0
                    end
                else
                    rec.sameCount = 0
                end

                rec.lastCooldown = cooldown

                if rec.sameCount >= self.SkillStuckThreshold then
                    table.insert(stuckPets, guid)
                    rec.sameCount = 0
                end
            end

            SKILL_STUCK[guid] = rec
        end

        if #stuckPets > 0 then
            for _, guid in ipairs(stuckPets) do
                Pet:UnequipPet(guid)
                task.wait(0.25)
            end
            task.wait(0.5)
            for _, guid in ipairs(stuckPets) do
                Pet:EquipPet(guid)
                task.wait(0.25)
            end
        end
    end

    -- Pickup all active pets in garden
    function m:PickupAllPets()
        local activePets = Pet:GetActivePets()
        if not activePets then
            return
        end

        local count = 0
        for _, guid in ipairs(activePets) do
            Pet:UnequipPet(guid)
            count = count + 1
            task.wait(0.25)
        end

        -- print("[Leveling] Picked up", count, "pets from garden")
    end

    -- Equip pet team (if selected)
    function m:EnsurePetTeamActive()
        if not self.SelectedTeamPets or next(self.SelectedTeamPets) == nil then
            return
        end

        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            activePetsArray = {}
        end

        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        local equipped = 0
        for petGuid, _ in pairs(self.SelectedTeamPets) do
            if not activePets[petGuid] then
                local success = Pet:EquipPet(petGuid)
                if success then
                    equipped = equipped + 1
                end
                task.wait(0.25)
            end
        end

        if equipped > 0 then
            -- print("[Leveling] Equipped", equipped, "pet team members")
        end
    end

    -- Filter pets by type (skips favorited pets)
    function m:FilterPetsByType(pets)
        if not self.SelectedPetTypes or next(self.SelectedPetTypes) == nil then
            return pets
        end

        local filtered = {}
        for guid, petData in pairs(pets) do
            local petType = Pet:GetPetType(petData)
            -- Skip favorited pets
            local isFavorited = Pet:IsPetFavorited(petData)
            if self.SelectedPetTypes[petType] and not isFavorited then
                filtered[guid] = petData
            end
        end

        return filtered
    end

    -- Auto idle logic - detect pets and equip them for leveling
    function m:AutoIdlePets()
        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterPetsByType(allPets)

        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            activePetsArray = {}
        end

        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        -- Count how many target pets are currently active (regardless of level)
        -- This ensures we don't try to equip more pets when slots are occupied by pets that reached target level
        local activeTargetCount = 0
        for guid, _ in pairs(activePets) do
            if targetPets[guid] then
                activeTargetCount = activeTargetCount + 1
            end
        end

        local totalActivePets = #activePetsArray
        local totalFreeSlots = 8 - totalActivePets
        local targetFreeSlots = self.MaxPetsInGarden - activeTargetCount
        local canEquip = math.min(totalFreeSlots, targetFreeSlots)

        if canEquip > 0 then
            for guid, petData in pairs(targetPets) do
                if canEquip <= 0 then break end

                local level = Pet:GetPetAge(petData)

                if not activePets[guid] and level < self.TargetLevel then
                    -- print("[Leveling] Auto equipping pet:", guid, "Level:", level)
                    Pet:EquipPet(guid)
                    canEquip = canEquip - 1
                    activeTargetCount = activeTargetCount + 1
                    task.wait(0.25)
                end
            end
        end
    end

    -- Check and unequip pets that reached target level
    function m:CheckAndUnequipPets()
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            return
        end

        local petTeamGuids = self.SelectedTeamPets or {}

        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterPetsByType(allPets)

        for _, guid in ipairs(activePetsArray) do
            if not petTeamGuids[guid] then
                if targetPets[guid] then
                    local petData = Pet:GetPetData(guid)
                    if petData then
                        local level = Pet:GetPetAge(petData)
                        if level >= self.TargetLevel then
                            -- print("[Leveling] Pet reached target level:", guid, "Level:", level)
                            local petType = Pet:GetPetType(petData)
                            self:Notify("Max Level Reached!", petType .. " reached Level " .. level, Color3.fromRGB(255, 215, 0))

                            -- Send webhook notification
                            local G = getgenv and getgenv() or _G
                            if G.SpecialWebhook then
                                -- Count remaining pets that haven't reached target level
                                local remainingCount = 0
                                for g, pd in pairs(targetPets) do
                                    if g ~= guid then
                                        local l = Pet:GetPetAge(pd)
                                        if l < self.TargetLevel then
                                            remainingCount = remainingCount + 1
                                        end
                                    end
                                end
                                pcall(function()
                                    G.SpecialWebhook:Leveling(petType, level, remainingCount)
                                end)
                            end

                            Pet:UnequipPet(guid)
                            task.wait(0.25)
                        end
                    end
                else
                    -- print("[Leveling] Unequipping unauthorized pet:", guid)
                    Pet:UnequipPet(guid)
                    task.wait(0.25)
                end
            end
        end
    end

    -- Main loop
    function m:Start()
        if self.IsRunning then
            -- warn("[Leveling] Already running!")
            return
        end

        -- Set running immediately so toggle feels responsive
        self.IsRunning = true

        self:Notify("Leveling Started", "Target: Level " .. self.TargetLevel, Color3.fromRGB(255, 215, 0))

        -- Run initialization and main loop in background
        task.spawn(function()
            -- Step 1: Pickup all pets from garden first
            self:PickupAllPets()
            task.wait(1)

            -- Check if stopped during init
            if not self.IsRunning then return end

            -- Step 2: Equip pet team immediately (if selected)
            self:EnsurePetTeamActive()
            task.wait(0.5)

            -- Main loop
            while self.IsRunning do
                pcall(function()
                    self:EnsurePetTeamActive()
                    self:CheckAndUnequipPets()
                    self:AutoIdlePets()
                    self:CheckStuckPets()
                end)

                task.wait(5)
            end
        end)
    end

    function m:Stop()
        local wasRunning = self.IsRunning
        self.IsRunning = false


        -- Only notify and cleanup if was previously running
        if wasRunning then
            self:Notify("Leveling Stopped", "Auto leveling stopped", Color3.fromRGB(255, 150, 100))

            -- Run cleanup in background so toggle responds instantly
            task.spawn(function()
                task.wait(0.5)
                self:PickupAllPets()
            end)
        end
    end

    return m

end

-- Module: leveling/ui_pandoruy.lua
EmbeddedModules["leveling/ui_pandoruy.lua"] = function()
    -- leveling/ui_pandoruy.lua
    -- UI untuk fitur leveling menggunakan PandoruyHub
    local m = {}

    local Tab
    local Window
    local PetTeam
    local Pet
    local Leveling
    local Core
