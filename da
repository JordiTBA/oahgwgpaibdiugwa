-- Module: module/boost.lua
EmbeddedModules["module/boost.lua"] = function()
    -- boost.lua
    -- Auto apply PetBoost item ke pet AKTIF
    -- Filter:
    --   • SELECTED_BOOST_PETS  → pet GUID yang di-boost (kosong = ALL)
    --   • PETBOOST_SELECTED    → daftar PetBoost (UUID) yang dipakai
    -- TANPA cek PASSIVE_BOOST
    -- Interval pakai AUTO_BOOST_DELAY (default 20)

    local Players           = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local LP = Players.LocalPlayer

    local ActivePetsService = require(
        ReplicatedStorage.Modules.PetServices.ActivePetsService
    )

    local ge = ReplicatedStorage:FindFirstChild("GameEvents")
            or ReplicatedStorage:FindFirstChild("gameEvents")

    local PetBoostRE = ge and ge:FindFirstChild("PetBoostService")

    ----------------------------------------------------------------
    -- CONFIG & DEBUG
    ----------------------------------------------------------------
    local DEFAULT_DELAY       = 20
    local AUTO_BOOST_RUNNING  = false
    local AUTO_BOOST_THREAD   = nil
    local STOP_TOKEN          = 0

    local DEBUG_BOOST = false

    local function bprint(...)
        if DEBUG_BOOST then
            -- print("[AutoKGBoost]", ...)
        end
    end

    local function bwarn(...)
        if DEBUG_BOOST then
            -- warn("[AutoKGBoost]", ...)
        end
    end

    ----------------------------------------------------------------
    -- UUID helpers
    ----------------------------------------------------------------
    local function normalizeUUID(u)
        if not u then return nil, nil end
        local core = tostring(u):match("{?([0-9a-fA-F%-]+)}?") or tostring(u)
        return core, "{" .. core .. "}"
    end

    ----------------------------------------------------------------
    -- Unequip semua tools di character
    ----------------------------------------------------------------
    local function unequipAllTools()
        local char     = LP.Character
        local backpack = LP:FindFirstChild("Backpack") or LP.Backpack
        if not char or not backpack then return end

        for _, inst in ipairs(char:GetChildren()) do
            if inst:IsA("Tool") then
                inst.Parent = backpack
            end
        end
    end

    ----------------------------------------------------------------
    -- Cari boost tool di Backpack berdasarkan UUID
    ----------------------------------------------------------------
    local function findBoostToolByUUID(boostUUID)
        if not boostUUID then return nil end

        local boostCore = select(1, normalizeUUID(boostUUID))
        if not boostCore then return nil end

        local backpack = LP:FindFirstChild("Backpack") or LP.Backpack
        if not backpack then return nil end

        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local attr = tool:GetAttribute("c") or tool:GetAttribute("C")
                if attr then
                    local attrCore = select(1, normalizeUUID(attr))
                    if attrCore == boostCore then
                        return tool
                    end
                end
            end
        end

        return nil
    end

    local function equipTool(tool)
        local char = LP.Character
        if not char or not tool then return false end

        unequipAllTools()
        tool.Parent = char
        task.wait(0.4)
        return true
    end

    ----------------------------------------------------------------
    -- Pet GUID filter (by individual pet UUID)
    ----------------------------------------------------------------
    local function buildSelectedPetMap()
        local map = _G.SELECTED_BOOST_PETS or SELECTED_BOOST_PETS or {}

        local hasAny = false
        for _, enabled in pairs(map) do
            if enabled then
                hasAny = true
                break
            end
        end

        if not hasAny then
            return nil -- ALL
        end

        local out = {}
        for guid, enabled in pairs(map) do
            if enabled then
                local core, braced = normalizeUUID(guid)
                if core then
                    out[core] = true
                    out[braced] = true
                end
            end
        end
        return out
    end

    ----------------------------------------------------------------
    -- Ambil active pets sesuai filter
    ----------------------------------------------------------------
    local function getActivePetsFiltered()
        local out = {}

        local cps = ActivePetsService.ClientPetState
        if type(cps) ~= "table" then return out end

        local perPlayer = cps[LP] or cps[LP.UserId] or cps[LP.Name]
        if type(perPlayer) ~= "table" then return out end

        local selectedMap = buildSelectedPetMap()

        for uuidKey, handlers in pairs(perPlayer) do
            if type(handlers) == "table" then
                local rec = handlers.PetModelHandler
                        or handlers.PetVFXHandler
                        or handlers.PetSoundHandler

                if type(rec) == "table" then
                    local pd = rec.PetData or rec.Data or {}
                    local pt = pd.PetType or rec.PetType or rec.Name

                    local petTypeName  = pt and tostring(pt) or ""

                    local core, braced = normalizeUUID(rec.UUID or uuidKey)
                    local allowed = (selectedMap == nil)
                        or (core and selectedMap[core])
                        or (braced and selectedMap[braced])
                    if allowed and core then
                        table.insert(out, {
                            uuidCore   = core,
                            uuidBraced = braced,
                            petType    = petTypeName,
                        })
                    end
                end
            end
        end

        return out
    end

    ----------------------------------------------------------------
    -- Ambil boost UUID terpilih
    ----------------------------------------------------------------
    local function getSelectedBoostUUIDs()
        local list = {}
        local src = _G.PETBOOST_SELECTED or PETBOOST_SELECTED

        if type(src) ~= "table" then
            return list
        end

        for uuid, enabled in pairs(src) do
            if enabled then
                table.insert(list, uuid)
            end
        end

        return list
    end

    ----------------------------------------------------------------
    -- APPLY BOOST SEKALI (TANPA PASSIVE CHECK)
    -- + bisa diputus cepat kalau STOP (token berubah / running false)
    ----------------------------------------------------------------
    local function applyAutoBoostOnce(myToken)
        if not PetBoostRE then return false end
        if (not AUTO_BOOST_RUNNING) or (myToken ~= STOP_TOKEN) then return false end

        local boostUUIDs = getSelectedBoostUUIDs()
        if #boostUUIDs == 0 then return false end

        local pets = getActivePetsFiltered()
        if #pets == 0 then return false end

        local usedAny = false

        for _, info in ipairs(pets) do
            if (not AUTO_BOOST_RUNNING) or (myToken ~= STOP_TOKEN) then break end

            local uuidBraced = info.uuidBraced
            local petType    = info.petType or "?"

            bprint("Boost pet:", petType, uuidBraced)

            for _, boostUUID in ipairs(boostUUIDs) do
                if (not AUTO_BOOST_RUNNING) or (myToken ~= STOP_TOKEN) then break end

                local tool = findBoostToolByUUID(boostUUID)
                if tool and equipTool(tool) then
                    if (not AUTO_BOOST_RUNNING) or (myToken ~= STOP_TOKEN) then
                        unequipAllTools()
                        break
                    end

                    task.wait(0.2)

                    local ok = pcall(function()
                        PetBoostRE:FireServer("ApplyBoost", uuidBraced)
                    end)

                    if ok then
                        usedAny = true
                        bprint("ApplyBoost OK:", uuidBraced, tool.Name)
                    end

                    task.wait(0.2)
                    unequipAllTools()
                end
            end
        end

        return usedAny
    end

    ----------------------------------------------------------------
    -- PUBLIC MODULE
    ----------------------------------------------------------------
    local M = {}

    function M.isRunning()
        return AUTO_BOOST_RUNNING
    end

    function M.setDelay(v)
        local n = tonumber(v)
        if not n or n <= 0 then return end
        n = math.floor(n + 0.5) -- rapihin
        AUTO_BOOST_DELAY = n
        _G.AUTO_BOOST_DELAY = n
    end

    function M.stop()
        AUTO_BOOST_RUNNING = false
        STOP_TOKEN += 1           -- ✅ matikan loop yang sedang jalan
        AUTO_BOOST_THREAD  = nil
        pcall(unequipAllTools)    -- ✅ bersih
    end

    function M.start()
        if AUTO_BOOST_RUNNING then return end
        AUTO_BOOST_RUNNING = true

        local myToken = STOP_TOKEN

        AUTO_BOOST_THREAD = task.spawn(function()
            while AUTO_BOOST_RUNNING and (myToken == STOP_TOKEN) do
                pcall(applyAutoBoostOnce, myToken)

                local delay = tonumber(_G.AUTO_BOOST_DELAY or AUTO_BOOST_DELAY) or DEFAULT_DELAY
                delay = math.max(delay, 1)

                local t = delay
                while t > 0 and AUTO_BOOST_RUNNING and (myToken == STOP_TOKEN) do
                    task.wait(1)
                    t -= 1
                end
            end
        end)
    end

    function M.syncFromState()
        local d = tonumber(_G.AUTO_BOOST_DELAY or AUTO_BOOST_DELAY) or DEFAULT_DELAY
        M.setDelay(d)

        if AUTO_BOOST_ENABLED == true then
            M.start()
        else
            M.stop()
        end
    end

    _G.AutoKGBoost = M
    return M

end

-- Module: pet_team/swap_skill.lua
EmbeddedModules["pet_team/swap_skill.lua"] = function()
    -- pet_team/swap_skill.lua
    -- Swap Skill system - auto swap pets when skill cooldown is ready
    -- Based on auto_hatch/module/swap_skill_module.lua

    local M = {}

    local Core = nil
    local State = nil

    local RunService = game:GetService("RunService")

    -- Runtime state
    local hbConn = nil
    local running = false
    local lastReady = {}  -- [uuid] = bool
    local busy = {}       -- [uuid] = bool
    local lastTrig = {}   -- [uuid] = time
    local acc = 0
    local skillCache = {} -- [uuid] = {kind, labelNorm}

    -- Default delays
    local DEFAULT_DELAYS = { unequipAfterReady = 1, equipNext = 0.2 }

    -- Exclude tokens (skills to ignore)
    local EXCLUDE_TOKENS = {
        "mutation", "mutasi",
        "tethered",
        "shiny", "sparkling",
        "boost",
    }

    -- Ready tolerance (seconds)
    local READY_TOL = 0

    function M:Init(_core, _state)
        Core = _core
        State = _state
    end

    -- Normalize UUID to braced format
    local function normUUID(u)
        if u == nil then return nil end
        local s = tostring(u)
        local core = s:match("{?([0-9a-fA-F%-]+)}?") or s
        if core == "" then return nil end
        return "{" .. core .. "}"
    end

    -- Normalize skill label for comparison
    local function normSkillLabel(s)
        s = string.lower(tostring(s or ""))
        s = s:gsub("%b[]", "")
             :gsub("[^%w%s]", " ")
             :gsub("%s+", " ")
        return (s:gsub("^%s+", ""):gsub("%s+$", ""))
    end

    -- Check if label contains any of the tokens
    local function labelHasAny(labelNorm, tokens)
        for _, tok in ipairs(tokens or {}) do
            if tok and tok ~= "" and string.find(labelNorm, tok, 1, true) then
                return true
            end
        end
        return false
    end

    -- Parse cooldown string to seconds
    local function parseCooldownSeconds(v)
        if type(v) == "number" then return v end
        if type(v) ~= "string" then return 0 end

        local s = v:lower()
            :gsub(",", ".")
            :gsub("%s+", " ")
            :gsub("^%s*(.-)%s*$", "%1")

        -- Format: "1:30" (minutes:seconds)
        local m, sec = s:match("^(%d+)%s*:%s*(%d+)$")
        if m and sec then
            return (tonumber(m) or 0) * 60 + (tonumber(sec) or 0)
        end

        -- Format: "1m 30s"
        local mm = s:match("(%d+)%s*m")
        local ss = s:match("(%d+)%s*s")
        if mm or ss then
            return (tonumber(mm) or 0) * 60 + (tonumber(ss) or 0)
        end

        return tonumber(s:match("[-+]?%d+%.?%d*")) or 0
    end

    -- Get cooldowns from server
    local function getCooldowns(uuid)
        local ok, cds = pcall(function()
            local GetCDRF = Core.ReplicatedStorage.GameEvents:FindFirstChild("GetPetCooldown")
            if GetCDRF then
                return GetCDRF:InvokeServer(uuid)
            end
            return nil
        end)
        if ok and type(cds) == "table" then
            return cds
        end
        return nil
    end

    -- Find cooldown by cached info
    local function findByCache(cds, cache)
        if type(cds) ~= "table" or type(cache) ~= "table" then return nil end

        local wantKind = cache.kind
        local wantNorm = cache.labelNorm
        if (wantKind ~= "Skill" and wantKind ~= "Passive") or type(wantNorm) ~= "string" or wantNorm == "" then
            return nil
        end

        for _, cd in ipairs(cds) do
            local raw = (wantKind == "Skill") and cd.Skill or cd.Passive
            local ln = normSkillLabel(raw)
            if ln ~= "" and ln == wantNorm then
                return cd
            end
        end
        return nil
    end

    -- Detect best skill/passive entry from cooldowns
    local function detectEntry(cds)
        if type(cds) ~= "table" then return nil end

        local bestObj, bestKind, bestLabelNorm, bestTime = nil, nil, nil, -math.huge

        local function consider(cd, kind, rawLabel)
            local ln = normSkillLabel(rawLabel)
            if ln == "" then return end
            if labelHasAny(ln, EXCLUDE_TOKENS) then return end

            local t = parseCooldownSeconds(cd.Time)
            if t > bestTime then
                bestTime = t
                bestObj = cd
                bestKind = kind
                bestLabelNorm = ln
            end
        end

        -- Check skills first
        for _, cd in ipairs(cds) do
            if type(cd) == "table" then
                consider(cd, "Skill", cd.Skill)
            end
        end
        -- Then check passives
        for _, cd in ipairs(cds) do
            if type(cd) == "table" then
                consider(cd, "Passive", cd.Passive)
            end
        end

        if bestObj then
            return bestObj, bestKind, bestLabelNorm
        end
        return nil
    end

    -- Get cooldown for a pet
    local function getCooldown(uuid)
        uuid = normUUID(uuid)
        if not uuid then return nil end

        local cds = getCooldowns(uuid)
        if type(cds) ~= "table" then return nil end

        local cached = skillCache[uuid]
        local cdObj = nil

        if type(cached) == "table" then
            cdObj = findByCache(cds, cached)
        end

        if not cdObj then
            local hit, kind, ln = detectEntry(cds)
            if hit then
                cdObj = hit
                skillCache[uuid] = { kind = kind, labelNorm = ln }
            else
                skillCache[uuid] = nil
                return nil
            end
        end

        return parseCooldownSeconds(cdObj.Time)
    end

    -- Equip pet
    local function equipPet(uuid)
        uuid = normUUID(uuid)
        if not uuid then return end
        pcall(function()
            Core.ReplicatedStorage.GameEvents.PetsService:FireServer("EquipPet", uuid, CFrame.new(0, 5, 0))
        end)
    end

    -- Unequip pet
    local function unequipPet(uuid)
        uuid = normUUID(uuid)
        if not uuid then return end
        pcall(function()
            Core.ReplicatedStorage.GameEvents.PetsService:FireServer("UnequipPet", uuid)
        end)
    end

    -- Get delay for a pet
    local function getDelay(uuid)
        uuid = normUUID(uuid)
        if not uuid then return DEFAULT_DELAYS end

        local delays = State.swap_skill.delays or {}
        local d = delays[uuid]

        if type(d) ~= "table" then
            d = {
                unequipAfterReady = DEFAULT_DELAYS.unequipAfterReady,
                equipNext = DEFAULT_DELAYS.equipNext,
            }
            State.swap_skill.delays[uuid] = d
        end

        d.unequipAfterReady = tonumber(d.unequipAfterReady) or DEFAULT_DELAYS.unequipAfterReady
        d.equipNext = tonumber(d.equipNext) or DEFAULT_DELAYS.equipNext

        return d
    end

    -- Build ordered list of selected pets
    local function buildSelectedOrdered()
        local selected = State.swap_skill.selected or {}
        local out = {}

        for uuid, on in pairs(selected) do
            if on then
                uuid = normUUID(uuid)
                if uuid then
                    table.insert(out, uuid)
                end
            end
        end

        return out
    end

    -- Reset trackers
    local function resetTrackers()
        lastReady = {}
        busy = {}
        lastTrig = {}
        skillCache = {}
        acc = 0
    end

    -- Main tick function (called on Heartbeat)
    local function tick(dt)
        if not running then return end

        local poll = 0.05
        acc = acc + dt
        if acc < poll then return end
        acc = 0

        local list = buildSelectedOrdered()
        if #list <= 0 then return end

        local now = os.clock()
        local minInterval = tonumber(State.swap_skill.scanInterval) or 0.1
        if minInterval <= 0 then minInterval = 0.1 end

        for _, uuid in ipairs(list) do
            if not busy[uuid] then
                local cd
                local ok = pcall(function()
                    cd = getCooldown(uuid)
                end)
                if not ok then cd = nil end

                if cd ~= nil then
                    local ready = (cd <= READY_TOL)
                    local wasReady = (lastReady[uuid] == true)

                    -- Transition from not ready to ready
                    if (not wasReady) and ready then
                        local lt = lastTrig[uuid] or 0
                        if (now - lt) >= minInterval then
                            lastTrig[uuid] = now
                            busy[uuid] = true

                            local d = getDelay(uuid)
                            local du = d.unequipAfterReady
                            local de = d.equipNext

                            -- Unequip after delay, then re-equip
                            task.delay(du, function()
                                if not running then return end

                                unequipPet(uuid)
                                lastReady[uuid] = false

                                task.delay(de, function()
                                    if not running then return end
                                    equipPet(uuid)
                                    busy[uuid] = false
                                end)
                            end)
                        end
                    end

                    lastReady[uuid] = ready
                else
                    lastReady[uuid] = false
                end
            end
        end
    end

    -- Start swap skill
    function M:Start()
        if running then return true end

        running = true
        resetTrackers()

        if hbConn then
            hbConn:Disconnect()
            hbConn = nil
        end

        hbConn = RunService.Heartbeat:Connect(tick)

        return true
    end

    -- Stop swap skill
    function M:Stop()
        running = false

        if hbConn then
            hbConn:Disconnect()
            hbConn = nil
        end

        resetTrackers()
        return true
    end

    -- Toggle based on state
    function M:Toggle(enabled)
        if enabled then
            M:Start()
        else
            M:Stop()
        end
    end

    -- Check if running
    function M:IsRunning()
        return running == true
    end

    -- Set scan interval
    function M:SetScanInterval(v)
        local n = tonumber(v)
        if n and n > 0 then
            State.swap_skill.scanInterval = n
        end
        return State.swap_skill.scanInterval
    end

    -- Add pet to selection
    function M:AddPet(uuid)
        uuid = normUUID(uuid)
        if not uuid then return end
        State.swap_skill.selected[uuid] = true
        getDelay(uuid) -- Ensure delay exists
    end

    -- Remove pet from selection
    function M:RemovePet(uuid)
        uuid = normUUID(uuid)
        if not uuid then return end
        State.swap_skill.selected[uuid] = nil
    end

    -- Set delay for a pet
    function M:SetDelay(uuid, unequipAfterReady, equipNext)
        uuid = normUUID(uuid)
        if not uuid then return end

        local d = getDelay(uuid)
        if unequipAfterReady then
            d.unequipAfterReady = tonumber(unequipAfterReady) or DEFAULT_DELAYS.unequipAfterReady
        end
        if equipNext then
            d.equipNext = tonumber(equipNext) or DEFAULT_DELAYS.equipNext
        end
    end

    -- Get all selected pets with their delays
    function M:GetSelectedPets()
        local result = {}
        local selected = State.swap_skill.selected or {}

        for uuid, on in pairs(selected) do
            if on then
                local d = getDelay(uuid)
                table.insert(result, {
                    uuid = uuid,
                    unequipAfterReady = d.unequipAfterReady,
                    equipNext = d.equipNext,
                })
            end
        end

        return result
    end

    return M

end

-- Module: mutation/venom.lua
EmbeddedModules["mutation/venom.lua"] = function()
    -- mutation/venom.lua
    -- Auto Venom Mutation for Passive Pets using Giant Scorpion skill timing
    local m = {}

    local Core
    local Pet
    local PetTeam
    local Mutation -- Reference to mutation.lua for CleansePet function
    local SpecialWebhook -- Reference for webhook notifications
    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")

    -- Storage (paths set in Init with username)
    local SAVE_BASE = "Pandora_KG"
    local SAVE_DIR = SAVE_BASE
    local SAVE_FILE = SAVE_DIR .. "/venom_config.json"

    -- State
    m.IsRunning = false
    m.CurrentPhase = "idle" -- "hunting_tumbal", "waiting_venom", "idle"
    m.TumbalTeamPets = {} -- {guid = true} set for hunting tumbal mutation (Phase 1)
    m.ScorpionTeamPets = {} -- {guid = true} set with Giant Scorpion (Phase 2)
    m.TumbalMutations = {} -- {mutationType = true} - Mutasi tumbal yang di-keep
    m.TargetPetTypes = {} -- {petType = true} - Pet types to process
    m.TargetWeightAge1 = 0 -- Weight filter at age 1: >0 = above, <0 = below, 0 = no filter
    m.ScorpionSkillReadyThreshold = -3 -- Skill dianggap ready jika cooldown <= X detik (-3 = 3 detik setelah ready)
    m.CurrentTargetPet = nil -- Pet yang sedang di-proses
    m.ProcessedPets = {} -- Track pets that have been processed
    m.OnNotify = nil -- Callback for notifications
    m.WasRunning = false -- For auto-resume

    -- Skill detection tokens for Giant Scorpion and Mimic Octopus
    local SCORPION_SKILL_TOKENS = {
        "venomous", "scorpion", "sting", "poison", "venom", "mimic", "copy"
    }

    -- Mutation enum map (will be loaded from game)
    m.MutationEnumMap = {}

    -- Status tracking
    m.LastSkillCooldown = nil
    m.GiantScorpionUUID = nil

    function m:Init(_core, _pet, _petTeam, _mutation)
        Core = _core
        Pet = _pet
        PetTeam = _petTeam
        Mutation = _mutation

        -- Set username-based save path
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/venom_config.json"

        -- Load mutation enum map
        self:LoadMutationEnumMap()

        -- Load saved config
        self:LoadConfig()
    end

    function m:SetSpecialWebhook(_specialWebhook)
        SpecialWebhook = _specialWebhook
    end

    function m:LoadMutationEnumMap()
        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local mutationModule = require(RS.Data.PetRegistry.PetMutationRegistry)

            if mutationModule.EnumToPetMutation then
                for enumVal, displayName in pairs(mutationModule.EnumToPetMutation) do
                    self.MutationEnumMap[enumVal] = displayName
                end
            end
        end)
    end

    function m:SaveConfig()
        pcall(function()
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local payload = {
                tumbalTeamPets = self.TumbalTeamPets,
                scorpionTeamPets = self.ScorpionTeamPets,
                tumbalMutations = self.TumbalMutations,
                targetPetTypes = self.TargetPetTypes,
                targetWeightAge1 = self.TargetWeightAge1,
                scorpionSkillReadyThreshold = self.ScorpionSkillReadyThreshold,
                wasRunning = self.IsRunning,
                _ts = os.time()
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
        end)
    end

    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            return false
        end

        local success = pcall(function()
            local text = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(text)

            -- New format: direct pet GUIDs set
            if type(data.tumbalTeamPets) == "table" then
                self.TumbalTeamPets = {}
                for guid, v in pairs(data.tumbalTeamPets) do
                    if v then self.TumbalTeamPets[guid] = true end
                end
            elseif data.tumbalTeam and data.tumbalTeam ~= "" and PetTeam and PetTeam.GetTeam then
                local team = PetTeam:GetTeam(data.tumbalTeam)
                if team and team.pets then
                    self.TumbalTeamPets = {}
                    for _, guid in ipairs(team.pets) do self.TumbalTeamPets[guid] = true end
                end
            end
            if type(data.scorpionTeamPets) == "table" then
                self.ScorpionTeamPets = {}
                for guid, v in pairs(data.scorpionTeamPets) do
                    if v then self.ScorpionTeamPets[guid] = true end
                end
            elseif data.scorpionTeam and data.scorpionTeam ~= "" and PetTeam and PetTeam.GetTeam then
                local team = PetTeam:GetTeam(data.scorpionTeam)
                if team and team.pets then
                    self.ScorpionTeamPets = {}
                    for _, guid in ipairs(team.pets) do self.ScorpionTeamPets[guid] = true end
                end
            end
            self.TumbalMutations = data.tumbalMutations or {}
            self.TargetPetTypes = data.targetPetTypes or {}
            self.TargetWeightAge1 = data.targetWeightAge1 or 0
            self.ScorpionSkillReadyThreshold = data.scorpionSkillReadyThreshold or -3
            self.WasRunning = data.wasRunning == true
        end)

        return success
    end

    function m:Notify(title, content, color)
        if self.OnNotify then
            self.OnNotify(title, content, color)
        end
    end

    -- Pickup all pets from garden
    function m:PickupAllPets()
        local activePets = Pet:GetActivePets()
        if not activePets then
            return
        end

        local count = 0
        for _, guid in ipairs(activePets) do
            Pet:UnequipPet(guid)
            count = count + 1
            task.wait(0.25)
        end
    end

    -- Get pet mutation display name (same logic as mutation.lua)
    function m:GetPetMutation(petData)
        if not petData then return nil end

        local mutation = nil
        pcall(function()
            -- Get raw mutation type (enum like "X")
            local rawMutation = nil

            -- Check multiple possible locations
            if petData.MutationType and petData.MutationType ~= "" then
                rawMutation = petData.MutationType
            elseif petData.PetData and petData.PetData.MutationType and petData.PetData.MutationType ~= "" then
                rawMutation = petData.PetData.MutationType
            elseif petData.Mutation and petData.Mutation ~= "" then
                rawMutation = petData.Mutation
            elseif petData.m and petData.m ~= "" then
                rawMutation = petData.m
            end

            if rawMutation then
                -- Convert enum to display name using MutationEnumMap
                if self.MutationEnumMap and self.MutationEnumMap[rawMutation] then
                    mutation = self.MutationEnumMap[rawMutation]
                else
                    -- Fallback: use raw value
                    mutation = rawMutation
                end

                -- Normalize Gold to Golden
                if mutation == "Gold" then
                    mutation = "Golden"
                end
            end
        end)

        return mutation
    end

    -- Find ALL venom pets (Scorpion and Mimic) in active pets
    function m:FindAllVenomPets()
        local activePets = Pet:GetActivePets() or {}
        local venomPets = {}

        for _, guid in ipairs(activePets) do
            local petData = Pet:GetPetData(guid)
            if petData then
                local petType = Pet:GetPetType(petData)
                local lowerType = petType and string.lower(petType) or ""

                -- Check for Giant Scorpion or Mimic Octopus
                if lowerType:find("scorpion") or lowerType:find("mimic") or lowerType:find("octopus") then
                    table.insert(venomPets, guid)
                end
            end
        end

        return venomPets
    end

    -- Backward compat: find first venom pet
    function m:FindGiantScorpion()
        local pets = self:FindAllVenomPets()
        return pets[1]
    end

    -- Helper: parse cooldown from pet
    function m:GetPetSkillCooldown(petUUID)
        local cooldowns = nil
        pcall(function()
            local GameEvents = Core.ReplicatedStorage:WaitForChild("GameEvents", 2)
            local GetPetCooldownRF = GameEvents:WaitForChild("GetPetCooldown", 2)
            if GetPetCooldownRF then
                cooldowns = GetPetCooldownRF:InvokeServer(petUUID)
            end
        end)

        if type(cooldowns) ~= "table" then return nil end

        for _, cd in ipairs(cooldowns) do
            local skill = string.lower(tostring(cd.Skill or cd.Passive or ""))
            for _, token in ipairs(SCORPION_SKILL_TOKENS) do
                if skill:find(token, 1, true) then
                    local time = cd.Time
                    if type(time) == "number" then
                        return time
                    elseif type(time) == "string" then
                        local mins, secs = time:match("^(%d+)%s*:%s*(%d+)$")
                        if mins and secs then
                            return tonumber(mins) * 60 + tonumber(secs)
                        end
                        return tonumber(time:match("%-?%d+%.?%d*")) or 0
                    end
                end
            end
        end

        return nil  -- No matching skill found
    end

    -- Get skill cooldown, checking ALL venom pets and picking LOWEST cooldown
    function m:GetScorpionSkillCooldown()
        local venomPets = self:FindAllVenomPets()
        if #venomPets == 0 then
            return nil, "No Giant Scorpion or Mimic Octopus found in active pets"
        end

        local bestPet = nil
        local bestCooldown = 999999

        for _, petUUID in ipairs(venomPets) do
            local cooldown = self:GetPetSkillCooldown(petUUID)
            if cooldown and cooldown < bestCooldown then
                bestCooldown = cooldown
                bestPet = petUUID
            end
        end

        -- If no skill found, return high cooldown (don't trigger cleanshard)
        if not bestPet then
            bestPet = venomPets[1]
            bestCooldown = 999  -- High value = skill not detected
        end

        self.GiantScorpionUUID = bestPet
        self.LastSkillCooldown = bestCooldown

        return bestCooldown
    end

    -- Get next passive pet to process (no Venom mutation yet)
    function m:GetNextTargetPet()
        local allPets = Pet:GetAllPetsInInventory() or {}

        for guid, petData in pairs(allPets) do
            local petType = Pet:GetPetType(petData)
            local isFavorited = false
            if Pet.IsPetFavorited then
                isFavorited = Pet:IsPetFavorited(petData) or false
            end

            -- Check if this pet type is in target list and not favorited
            if self.TargetPetTypes[petType] and not isFavorited then
                -- Check if already processed
                if not self.ProcessedPets[guid] then
                    local mutation = self:GetPetMutation(petData)

                    -- Skip if already has Venom
                    if mutation ~= "Venom" then
                        -- Weight filter at age 1
                        if self.TargetWeightAge1 ~= 0 then
                            -- Calculate weight at age 1 using base weight formula
                            -- weight = base * (1 + SCALE_PER_LVL * level)
                            local baseWeight = petData.PetData and petData.PetData.BaseWeight or 0
                            local scalePer = 0.01 -- Default SCALE_PERCENTAGE_OF_BASE_WEIGHT_PER_LEVEL
                            pcall(function()
                                local PetRegistry = require(Core.ReplicatedStorage.Data.PetRegistry)
                                scalePer = PetRegistry.PetConfig.WEIGHT_CONFIG.SCALE_PERCENTAGE_OF_BASE_WEIGHT_PER_LEVEL or 0.01
                            end)
                            local weightAge1 = baseWeight * (1 + scalePer * 1)

                            if self.TargetWeightAge1 > 0 then
                                -- Above filter: skip if weight < threshold
                                if weightAge1 < self.TargetWeightAge1 then
                                    passFilter = false
                                end
                            else
                                -- Below filter: skip if weight > abs(threshold)
                                if weightAge1 > math.abs(self.TargetWeightAge1) then
                                    passFilter = false
                                end
                            end
                        end

                        if passFilter then
                            return guid, petData
                        end
                    end
                end
            end
        end

        return nil, nil
    end

    -- Check if pet has tumbal mutation
    function m:HasTumbalMutation(petData)
        local mutation = self:GetPetMutation(petData)
        if not mutation or mutation == "" or mutation == "None" then
            return false
        end

        -- Check if mutation is in tumbal list
        return self.TumbalMutations[mutation] == true
    end

    -- Ensure tumbal hunting team is active (Phase 1)
    function m:EnsureTumbalTeamActive()
        if not self.TumbalTeamPets or next(self.TumbalTeamPets) == nil then
            return false
        end

        local activePetsArray = Pet:GetActivePets() or {}
        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        for petGuid, _ in pairs(self.TumbalTeamPets) do
            if not activePets[petGuid] then
                Pet:EquipPet(petGuid)
                task.wait(0.25)
            end
        end

        return true
    end

    -- Ensure scorpion team is active (Phase 2)
    function m:EnsureScorpionTeamActive()
        if not self.ScorpionTeamPets or next(self.ScorpionTeamPets) == nil then
            return false
        end

        local activePetsArray = Pet:GetActivePets() or {}
        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        for petGuid, _ in pairs(self.ScorpionTeamPets) do
            if not activePets[petGuid] then
                Pet:EquipPet(petGuid)
                task.wait(0.1)
            end
        end

        return true
    end

    -- Equip target pet to garden
    function m:EquipTargetPet(petGuid)
        if not petGuid then return false end

        local activePets = Pet:GetActivePets() or {}
        for _, guid in ipairs(activePets) do
            if guid == petGuid then
                return true -- Already equipped
            end
        end

        Pet:EquipPet(petGuid)
        task.wait(0.3)
        return true
    end

    -- Unequip target pet from garden
    function m:UnequipTargetPet(petGuid)
        if not petGuid then return false end
        Pet:UnequipPet(petGuid)
        task.wait(0.25)
        return true
    end

    -- Phase 1: Hunt tumbal mutation
    function m:RunPhase1()
        if not self.IsRunning then return end

        self.CurrentPhase = "hunting_tumbal"

        -- Clear previous target first
        self.CurrentTargetPet = nil

        local targetGuid, targetData = nil, nil

        -- Find pet without tumbal mutation (using same filter as GetNextTargetPet)
        local allPets = Pet:GetAllPetsInInventory() or {}
        for guid, petData in pairs(allPets) do
            local petType = Pet:GetPetType(petData)
            local isFavorited = false
            if Pet.IsPetFavorited then
                isFavorited = Pet:IsPetFavorited(petData) or false
            end

            if self.TargetPetTypes[petType] and not isFavorited then
                if not self.ProcessedPets[guid] then
                    local mutation = self:GetPetMutation(petData)

                    -- Skip if already has Venom
                    if mutation == "Venom" then
                        -- Pet already has Venom! Mark as processed and unequip
                        local petType = Pet:GetPetType(petData) or "Unknown"
                        print("[Venom] Pet already has Venom, skipping:", petType)
                        self.ProcessedPets[guid] = true

                        -- Unequip if currently equipped
                        local activePets = Pet:GetActivePets() or {}
                        for _, activeGuid in ipairs(activePets) do
                            if activeGuid == guid then
                                self:UnequipTargetPet(guid)
                                break
                            end
                        end
                    else
                        -- Weight filter at age 1
                        local passFilter = true
                        if self.TargetWeightAge1 ~= 0 then
                            local baseWeight = petData.PetData and petData.PetData.BaseWeight or 0
                            local scalePer = 0.01
                            pcall(function()
                                local PetRegistry = require(Core.ReplicatedStorage.Data.PetRegistry)
                                scalePer = PetRegistry.PetConfig.WEIGHT_CONFIG.SCALE_PERCENTAGE_OF_BASE_WEIGHT_PER_LEVEL or 0.01
                            end)
                            local weightAge1 = baseWeight * (1 + scalePer * 1)

                            if self.TargetWeightAge1 > 0 then
                                if weightAge1 < self.TargetWeightAge1 then passFilter = false end
                            else
                                if weightAge1 > math.abs(self.TargetWeightAge1) then passFilter = false end
                            end
                        end

                        if passFilter then
                            if not self:HasTumbalMutation(petData) then
                                -- This pet needs tumbal mutation
                                targetGuid = guid
                                targetData = petData
                                break
                            else
                                -- Has tumbal mutation, ready for Phase 2
                                self.CurrentTargetPet = guid
                                self:Notify("Venom Mode", "Pet has tumbal mutation, waiting for Scorpion skill...", Color3.fromRGB(200, 100, 255))
                                self:RunPhase2()
                                return
                            end
                        end
                    end
                end
            end
        end

        if not targetGuid then
            self:Notify("Venom Mode", "No more pets to process!", Color3.fromRGB(100, 255, 100))
            self:Stop()
            return
        end

        self.CurrentTargetPet = targetGuid

        -- Ensure tumbal hunting team is active (Phase 1)
        self:EnsureTumbalTeamActive()

        -- Equip target pet
        self:EquipTargetPet(targetGuid)

        self:Notify("Venom Mode", "Hunting tumbal mutation for " .. Pet:GetPetType(targetData) .. "...", Color3.fromRGB(255, 200, 100))

        -- Wait for mutation
        while self.IsRunning and self.CurrentPhase == "hunting_tumbal" do
            task.wait(2)

            -- Check if pet now has tumbal mutation
            local petData = Pet:GetPetData(targetGuid)
            if petData then
                local mutation = self:GetPetMutation(petData)

                if mutation == "Venom" then
                    -- Lucky! Got Venom directly
                    local petType = Pet:GetPetType(petData) or "Unknown"
                    local remains = self:CountRemainingTargetPets()
                    self:Notify("Venom Mode", "Lucky! Pet got Venom directly!", Color3.fromRGB(100, 255, 100))

                    -- Send webhook
                    if SpecialWebhook and SpecialWebhook.Mutation then
                        pcall(function()
                            SpecialWebhook:Mutation(petType, "Venom", remains)
                        end)
                    end

                    self.ProcessedPets[targetGuid] = true
                    self.CurrentTargetPet = nil  -- Clear before moving to next
                    self:UnequipTargetPet(targetGuid)
                    self:PickupAllPets()
                    task.wait(0.5)
                    self:RunPhase1() -- Process next pet
                    return
                elseif self:HasTumbalMutation(petData) then
                    -- Got tumbal mutation, move to Phase 2
                    self:Notify("Venom Mode", "Got tumbal mutation! Moving to Phase 2...", Color3.fromRGB(100, 255, 200))
                    self:RunPhase2()
                    return
                elseif mutation and mutation ~= "" then
                    -- Got a mutation but NOT tumbal and NOT Venom - cleanse it silently

                    if Mutation and Mutation.CleansePet then
                        Mutation:CleansePet(targetGuid)
                        task.wait(1)
                    end
                    -- Continue hunting for tumbal
                end
                -- else: no mutation yet, continue waiting
            end
        end
    end

    -- Phase 2: Wait for Scorpion skill and apply Venom
    function m:RunPhase2()
        if not self.IsRunning then return end

        self.CurrentPhase = "waiting_venom"

        local targetGuid = self.CurrentTargetPet
        if not targetGuid then
            self:RunPhase1()
            return
        end

        -- Pickup all pets from garden first (to switch teams)
        self:PickupAllPets()
        task.wait(0.5)

        -- Ensure scorpion team (Phase 2) is active first
        self:EnsureScorpionTeamActive()
        task.wait(0.5)

        -- Then equip target pet
        self:EquipTargetPet(targetGuid)

        while self.IsRunning and self.CurrentPhase == "waiting_venom" do
            local cooldown, err = self:GetScorpionSkillCooldown()

            if cooldown == nil then
                self:Notify("Venom Warning", err or "Scorpion skill error", Color3.fromRGB(255, 100, 100))
                task.wait(3)
            elseif cooldown <= 0 then
                -- Skill is ready!
                -- If threshold is negative, add delay (e.g. -1 = 1 second delay after ready)
                if self.ScorpionSkillReadyThreshold < 0 then
                    local delay = math.abs(self.ScorpionSkillReadyThreshold)
                    self:Notify("Venom Mode", "Skill ready! Waiting " .. delay .. "s...", Color3.fromRGB(255, 255, 100))
                    task.wait(delay)
                else
                    self:Notify("Venom Mode", "Skill ready! Cleansing...", Color3.fromRGB(255, 255, 100))
                end

                -- Apply cleansing shard to target pet immediately
                local cleanseSuccess = false
                if Mutation and Mutation.CleansePet then
                    cleanseSuccess = Mutation:CleansePet(targetGuid)
                end

                if cleanseSuccess then
                    -- Wait for skill to trigger and mutation to apply
                    task.wait(10)

                    -- Check if got Venom
                    local petData = Pet:GetPetData(targetGuid)
                    if petData then
                        local mutation = self:GetPetMutation(petData)

                        if mutation == "Venom" then
                            local petType = Pet:GetPetType(petData) or "Unknown"
                            local remains = self:CountRemainingTargetPets()
                            self:Notify("Venom Success!", "Pet got Venom mutation!", Color3.fromRGB(100, 255, 100))

                            -- Send webhook
                            if SpecialWebhook and SpecialWebhook.Mutation then
                                pcall(function()
                                    SpecialWebhook:Mutation(petType, "Venom", remains)
                                end)
                            end

                            self.ProcessedPets[targetGuid] = true
                            self.CurrentTargetPet = nil  -- Clear before moving to next
                            self:UnequipTargetPet(targetGuid)

                            -- Process next pet - pickup all first to switch teams
                            self:PickupAllPets()
                            task.wait(0.5)
                            self:RunPhase1()
                            return
                        else
                            -- Didn't get Venom, go back to Phase 1
                            self:Notify("Venom Mode", "Didn't get Venom, hunting new tumbal...", Color3.fromRGB(255, 150, 100))

                            -- Pickup all to switch back to tumbal team
                            self:PickupAllPets()
                            task.wait(0.5)
                            self.CurrentTargetPet = nil  -- Clear before retrying
                            self.CurrentPhase = "hunting_tumbal"
                            self:RunPhase1()
                            return
                        end
                    end
                else
                    self:Notify("Venom Error", "Failed to cleanse pet. No shard?", Color3.fromRGB(255, 100, 100))
                    task.wait(3)
                end
            else
                -- Skill not ready yet, poll faster for better timing
                task.wait(0.2)
            end
        end
    end

    function m:Start()
        if self.IsRunning then
            return
        end

        self.IsRunning = true
        self.CurrentPhase = "idle"
        self.ProcessedPets = {}

        self:SaveConfig()

        self:Notify("Venom Mode", "Starting Auto Venom Mutation...", Color3.fromRGB(150, 100, 255))

        task.spawn(function()
            -- Pickup all pets from garden first
            self:PickupAllPets()
            task.wait(0.5)

            self:RunPhase1()
        end)
    end

    function m:Stop()
        self.IsRunning = false
        self.CurrentPhase = "idle"
        self.CurrentTargetPet = nil

        -- Pickup all pets from garden when stopping (async to avoid blocking UI)
        task.spawn(function()
            self:PickupAllPets()
        end)

        self:SaveConfig()

        self:Notify("Venom Mode", "Stopped", Color3.fromRGB(150, 150, 150))
    end

    -- Count remaining pets that need processing
    function m:CountRemainingTargetPets()
        local count = 0
        local allPets = Pet:GetAllPetsInInventory() or {}

        for guid, petData in pairs(allPets) do
            local petType = Pet:GetPetType(petData)
            local isFavorited = false
            if Pet.IsPetFavorited then
                isFavorited = Pet:IsPetFavorited(petData) or false
            end

            if self.TargetPetTypes[petType] and not isFavorited then
                if not self.ProcessedPets[guid] then
                    local mutation = self:GetPetMutation(petData)
                    if mutation ~= "Venom" then
                        count = count + 1
                    end
                end
            end
        end

        return count
    end

    -- Get status text for UI (detailed version like Auto Mutation)
    function m:GetStatusText()
        local lines = {}

        local success, err = pcall(function()
            -- Auto Status
            local status = self.IsRunning and "RUNNING" or "STOPPED"
            table.insert(lines, "Auto Status: " .. status)

            -- Phase
            if self.IsRunning then
                local phaseText = "Idle"
                if self.CurrentPhase == "hunting_tumbal" then
                    phaseText = "Hunting Tumbal"
                elseif self.CurrentPhase == "waiting_venom" then
                    phaseText = "Waiting Venom"
                end
                table.insert(lines, "Phase: " .. phaseText)
            end
            table.insert(lines, "")

            -- Teams
            local tumbalCount = 0
            if self.TumbalTeamPets then for _ in pairs(self.TumbalTeamPets) do tumbalCount = tumbalCount + 1 end end
            local scorpionCount = 0
            if self.ScorpionTeamPets then for _ in pairs(self.ScorpionTeamPets) do scorpionCount = scorpionCount + 1 end end
            table.insert(lines, "Tumbal Team: " .. tostring(tumbalCount) .. " pets")
            table.insert(lines, "Scorpion Team: " .. tostring(scorpionCount) .. " pets")

            -- Tumbal Mutations
            local tumbalList = {}
            for mut, _ in pairs(self.TumbalMutations) do
                table.insert(tumbalList, mut)
            end
            table.sort(tumbalList)
            local tumbalStr = #tumbalList > 0 and table.concat(tumbalList, ", ") or "None"
            table.insert(lines, "Tumbal Mutations: " .. tumbalStr)
            table.insert(lines, "")

            -- Current Target
            if self.CurrentTargetPet and self.IsRunning then
                local petData = Pet:GetPetData(self.CurrentTargetPet)
                if petData then
                    local petType = Pet:GetPetType(petData) or "Unknown"
                    local mutation = self:GetPetMutation(petData) or "None"
                    table.insert(lines, "Target: " .. petType .. " [" .. mutation .. "]")
                end
            end

            -- Pet Statistics
            local venomCount = 0
            local readyCount = 0
            local hasTumbalCount = 0

            local allPets = Pet:GetAllPetsInInventory() or {}
            for guid, petData in pairs(allPets) do
                local petType = Pet:GetPetType(petData)
                local isFavorited = false
                if Pet.IsPetFavorited then
                    isFavorited = Pet:IsPetFavorited(petData) or false
                end

                if self.TargetPetTypes[petType] and not isFavorited then
                    local mutation = self:GetPetMutation(petData)
                    if mutation == "Venom" then
                        venomCount = venomCount + 1
                    elseif self.TumbalMutations[mutation] then
                        hasTumbalCount = hasTumbalCount + 1
                    elseif not mutation or mutation == "" then
                        readyCount = readyCount + 1
                    end
                end
            end

            table.insert(lines, "")
            table.insert(lines, "Pet Statistics:")
            table.insert(lines, "- Already Venom: " .. venomCount .. " pets")
            table.insert(lines, "- Has Tumbal: " .. hasTumbalCount .. " pets")
            table.insert(lines, "- Ready: " .. readyCount .. " pets")
        end)

        if not success then
            table.insert(lines, "Error: " .. tostring(err))
        end

        return table.concat(lines, "\n")
    end

    return m

end

