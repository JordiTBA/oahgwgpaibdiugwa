        petTypeC = {}, mutC = {}, autoUnfavC = false,
        -- Row 4 (suffix D)
        enabledD = false, targetsD = {}, minKGD = 0, minAgeD = 0,
        petTypeD = {}, mutD = {}, autoUnfavD = false,
    }

    m.AutoAcceptGift = false
    m.AutoAcceptTrade = false

    -- Auto Trade state
    m.AutoTrade = {
        enabled = false,
        targetPlayer = nil,      -- Player instance atau nama
        targetUserId = nil,      -- UserId target
        petTypes = {},           -- {[petTypeName] = true} filter
        petCount = 1,            -- jumlah pet per trade
        tradeCount = 1,          -- jumlah trade yang diinginkan
        tradesCompleted = 0,     -- counter trade berhasil
        tradedPetGuids = {},     -- {[guid] = true} pets sudah di-trade dalam session
        minWeight = 0,           -- 0 = off, >0 = at least, <0 = at most
    }

    -- Connections
    local RequestGiftConnection = nil
    local RequestTradeConnection = nil
    local AutoTradeConnection = nil

    -- Favorite RE (resolved in Init)
    local FavoriteItemRE = nil

    -- Config
    local AUTO_GIFT_SCAN_INTERVAL = 0.5
    local AUTO_GIFT_MAX_SEND_PER_PASS = 5

    ----------------------------------------------------------------
    -- FAVORITE HELPERS
    ----------------------------------------------------------------
    local function isToolFavorited(tool)
        if not tool or not tool:IsA("Tool") then return false end
        return tool:GetAttribute("d") == true
            or tool:GetAttribute("Favorite") == true
            or tool:GetAttribute("IsFavorite") == true
            or tool:GetAttribute("Fav") == true
            or tool:GetAttribute("fav") == true
    end

    local function setToolFavorite(tool, wantFav)
        if not tool or not FavoriteItemRE then
            return false
        end

        local cur = (isToolFavorited(tool) == true)
        wantFav = (wantFav == true)

        if cur == wantFav then
            return false
        end

        local ok, err = pcall(function()
            FavoriteItemRE:FireServer(tool)
        end)

        return ok
    end

    ----------------------------------------------------------------
    -- PET TYPE FILTER
    ----------------------------------------------------------------
    local function _passesPetType(petTypeNorm, cfgMap)
        if not cfgMap or type(cfgMap) ~= "table" then
            return true
        end

        local hasAny = false
        for _, v in pairs(cfgMap) do
            if v then
                hasAny = true
                break
            end
        end

        if not hasAny then
            return true
        end

        if not petTypeNorm or petTypeNorm == "" then
            return false
        end

        for key, enabled in pairs(cfgMap) do
            if enabled then
                if petTypeNorm == tostring(key):lower() then
                    return true
                end
            end
        end

        return false
    end

    ----------------------------------------------------------------
    -- W100 / AGE FILTER
    --   kgRaw: >0 → W100 >= kgRaw, <0 → W100 <= |kgRaw|, 0 → off
    --   ageRaw: 0 → age <= 1, >0 → age >= ageRaw, <0 → age <= |ageRaw|
    ----------------------------------------------------------------
    local function _passesGiftGroup(weightArg, age, kgRaw, ageRaw)
        kgRaw  = tonumber(kgRaw)  or 0
        ageRaw = tonumber(ageRaw) or 0

        local kgLimit   = math.abs(kgRaw)
        local useMaxKG  = (kgRaw < 0)

        local ageLimit
        local useMaxAge

        if ageRaw == 0 then
            ageLimit  = 1
            useMaxAge = true
        else
            ageLimit  = math.abs(ageRaw)
            useMaxAge = (ageRaw < 0)
        end

        if kgLimit > 0 then
            if (not useMaxKG) and weightArg < kgLimit then
                return false
            elseif useMaxKG and weightArg > kgLimit then
                return false
            end
        end

        if ageLimit > 0 then
            if (not useMaxAge) and age < ageLimit then
                return false
            elseif useMaxAge and age > ageLimit then
                return false
            end
        end

        return true
    end

    ----------------------------------------------------------------
    -- MUTATION FILTER
    --   mutMap empty → only pets WITHOUT mutations
    --   mutMap has entries → pet must have at least one matching mutation
    ----------------------------------------------------------------
    local function _matchGiftMutation(rec, helpers, mutMap)
        mutMap = (type(mutMap) == "table") and mutMap or {}

        local muts = {}
        pcall(function()
            muts = helpers.mutation_names_from_record(rec) or {}
        end)
        local hasMut = (#muts > 0)

        local hasSelected = false
        for _, v in pairs(mutMap) do
            if v then
                hasSelected = true
                break
            end
        end

        if not hasSelected then
            if not hasMut then
                return true
            else
                return false
            end
        end

        if not hasMut then
            return false
        end

        local sel = {}
        for name, on in pairs(mutMap) do
            if on then
                sel[string.lower(tostring(name))] = true
            end
        end

        for _, mName in ipairs(muts) do
            if sel[string.lower(mName)] then
                return true
            end
        end

        return false
    end

    ----------------------------------------------------------------
    -- TARGET RESOLUTION
    ----------------------------------------------------------------
    local function _getGiftTargets(cfg, which)
        which = which or "targets"
        local result = {}

        if cfg and cfg[which] and next(cfg[which]) ~= nil then
            for key, info in pairs(cfg[which]) do
                local userId = info.userId or tonumber(key)
                local name   = info.name

                local plr
                if userId then
                    plr = Core.Players:GetPlayerByUserId(userId)
                end

                if (not plr) and name and name ~= "" then
                    local want = string.lower(name)
                    for _, p in ipairs(Core.Players:GetPlayers()) do
                        if string.lower(p.Name) == want then
                            plr = p
                            break
                        end
                    end
                end

                if plr then
                    table.insert(result, plr)
                end
            end
        end

        return result
    end

    ----------------------------------------------------------------
    -- BACKPACK & TOOL HELPERS
    ----------------------------------------------------------------
    local function _isPetTool(t)
        if not (t and t:IsA("Tool")) then return false end
        local it = t:GetAttribute("ItemType") or t:GetAttribute("Itemtype") or t:GetAttribute("b")
        if it == "l" then return true end
        return it and string.lower(tostring(it)) == "pet"
    end

    local function _countTargetBackpack(plr)
        if not (plr and plr:IsA("Player")) then return math.huge end
        local bp = plr:FindFirstChild("Backpack")
        if not bp then return math.huge end
        local cnt = 0
        for _, child in ipairs(bp:GetChildren()) do
            if _isPetTool(child) then
                cnt = cnt + 1
            end
        end
        return cnt
    end

    local function _pickLeastBackpackTarget(targets)
        if type(targets) ~= "table" or #targets == 0 then
            return nil
        end
        if #targets == 1 then
            return targets[1]
        end

        local best, bestCnt
        for _, p in ipairs(targets) do
            local c = _countTargetBackpack(p)
            if not best or c < bestCnt then
                best = p
                bestCnt = c
            end
        end
        return best or targets[1]
    end

    local function _unequipAllTools(bp)
        local char = Core.LocalPlayer.Character
        if not char then return end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:UnequipTools() end)
        end

        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                obj.Parent = bp
            end
        end

        task.wait(0.05)
    end

    ----------------------------------------------------------------
    -- CORE GIVE (with autoUnfav support)
    ----------------------------------------------------------------
    local function _give(tool, target, allowUnfav, bp, helpers)
        allowUnfav = (allowUnfav == true)

        local PetGiftingService = nil
        pcall(function()
            PetGiftingService = require(Core.ReplicatedStorage.Modules.PetServices.PetGiftingService)
        end)

        if not PetGiftingService then
            return false
        end

        -- STEP 1: Favorite handling
        if isToolFavorited(tool) then
            if not allowUnfav then
                return false
            end

            -- autoUnfav = true → unfav with retry
            for i = 1, 1 do
                if isToolFavorited(tool) then
                    setToolFavorite(tool, false)
                    task.wait(0.3)
                else
                    break
                end
            end

            if isToolFavorited(tool) then
                return false
            end
        end

        -- STEP 2: Equip tool
        local char = Core.LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then
            return false
        end

        _unequipAllTools(bp)
        task.wait(0.3)

        tool.Parent = char
        task.wait(0.1)

        pcall(function()
            hum:EquipTool(tool)
        end)
        task.wait(0.4)

        -- STEP 3: Check fav again after equip
        if allowUnfav and isToolFavorited(tool) then
            setToolFavorite(tool, false)
            task.wait(0.3)
        end

        -- STEP 4: Gift
        local ok, res = pcall(function()
            return PetGiftingService:GivePet(target)
        end)

        -- STEP 5: Unequip
        task.wait(0.3)
        _unequipAllTools(bp)

        return ok and res ~= false
    end

    ----------------------------------------------------------------
    -- INIT
    ----------------------------------------------------------------
    function m:Init(_core, _player, _pet)
        Core = _core
        Player = _player
        Pet = _pet

        -- Set username-based save path
        local Players = game:GetService("Players")
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/inventory_config.json"

        -- Resolve FavoriteItemRE
        pcall(function()
            local GE = Core.ReplicatedStorage:WaitForChild("GameEvents", 5)
            FavoriteItemRE = GE and GE:FindFirstChild("Favorite_Item")
        end)

        self:LoadConfig()

        -- Start auto gift loop in background
        task.spawn(function()
            while true do
                local c = self.GIFT_CFG
                if c.enabled or c.enabledB or c.enabledC or c.enabledD then
                    local ok, err = pcall(function()
                        self:AutoGiftPets()
                    end)
                    if not ok then
                        warn("[AutoGift] Error:", err)
                    end
                end
                task.wait(AUTO_GIFT_SCAN_INTERVAL)
            end
        end)

        -- Setup auto accept gift
        task.spawn(function()
            task.wait(1)
            self:StartAutoAcceptGifts()
        end)

        -- Setup auto accept trade
        task.spawn(function()
            task.wait(1)
            self:StartAutoAcceptTrades()
        end)
    end

    ----------------------------------------------------------------
    -- SAVE CONFIG
    ----------------------------------------------------------------
    function m:SaveConfig()
        pcall(function()
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local payload = {
                giftCfg = self.GIFT_CFG,
                autoAcceptGift = self.AutoAcceptGift,
                autoAcceptTrade = self.AutoAcceptTrade,
                autoTrade = {
                    enabled = self.AutoTrade.enabled,
                    targetUserId = self.AutoTrade.targetUserId,
                    targetPlayerName = self.AutoTrade.targetPlayer and (type(self.AutoTrade.targetPlayer) == "string" and self.AutoTrade.targetPlayer or self.AutoTrade.targetPlayer.Name) or nil,
                    petTypes = self.AutoTrade.petTypes,
                    petCount = self.AutoTrade.petCount,
                    tradeCount = self.AutoTrade.tradeCount,
                    minWeight = self.AutoTrade.minWeight,
                },
                _ts = os.time(),
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
        end)
    end

    ----------------------------------------------------------------
    -- LOAD CONFIG (backward compatible)
    ----------------------------------------------------------------
    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            return
        end

        local success, result = pcall(function()
            local json = readfile(SAVE_FILE)
            return HttpService:JSONDecode(json)
        end)

        if not success or not result then
            return
        end

        -- New format: giftCfg exists
        if result.giftCfg then
            -- Merge saved config into GIFT_CFG
            for k, v in pairs(result.giftCfg) do
                self.GIFT_CFG[k] = v
            end
        elseif result.autoGiftEnabled ~= nil then
            -- Old format: migrate to Row 1
            local cfg = self.GIFT_CFG
            cfg.enabled = result.autoGiftEnabled or false

            -- Convert targets array → targets map
            local oldTargets = result.autoGiftTargets or {}
            if result.autoGiftPlayer and #oldTargets == 0 then
                oldTargets = {result.autoGiftPlayer}
            end
            cfg.targets = {}
            for _, userId in ipairs(oldTargets) do
                local plr = Core.Players:GetPlayerByUserId(userId)
                local name = plr and plr.Name or tostring(userId)
                cfg.targets[name] = { userId = userId, name = name }
            end

            -- Convert pet types
            cfg.petType = result.autoGiftPetTypes or {}

            -- Convert AgeMode/AgeValue → signed minAge
            local ageMode = result.autoGiftAgeMode or "None"
            local ageVal = result.autoGiftAgeValue or 0
            if ageMode == "Below" then
                cfg.minAge = -math.abs(ageVal)
            elseif ageMode == "Above" then
                cfg.minAge = math.abs(ageVal)
            else
                cfg.minAge = 0
            end

            -- Convert WeightMode/WeightValue → signed minKG
            local wMode = result.autoGiftWeightMode or "None"
            local wVal = result.autoGiftWeightValue or 0
            if wMode == "Below" then
                cfg.minKG = -math.abs(wVal)
            elseif wMode == "Above" then
                cfg.minKG = math.abs(wVal)
            else
                cfg.minKG = 0
            end

            -- Convert single mutation string → mut map
            local oldMut = result.autoGiftMutation
            if oldMut and oldMut ~= "" then
                cfg.mut = { [oldMut] = true }
            else
                cfg.mut = {}
            end

            -- Convert ForceFavorited → autoUnfav
            cfg.autoUnfav = result.autoGiftForceFavorited or false
        end

        self.AutoAcceptGift = result.autoAcceptGift or false
        self.AutoAcceptTrade = result.autoAcceptTrade or false

        -- Load AutoTrade config
        if result.autoTrade and type(result.autoTrade) == "table" then
            local at = result.autoTrade
            self.AutoTrade.enabled = false -- always disabled on load for safety
            self.AutoTrade.targetUserId = at.targetUserId
            self.AutoTrade.targetPlayer = at.targetPlayerName -- will resolve to Player on runtime
            self.AutoTrade.petTypes = at.petTypes or {}
            self.AutoTrade.petCount = tonumber(at.petCount) or 1
            self.AutoTrade.tradeCount = tonumber(at.tradeCount) or 1
            self.AutoTrade.minWeight = tonumber(at.minWeight) or 0
            self.AutoTrade.tradesCompleted = 0
        end
    end

    ----------------------------------------------------------------
    -- AUTO GIFT PETS (4-row priority system)
    ----------------------------------------------------------------
    function m:AutoGiftPets()
        local cfg = self.GIFT_CFG

        -- Get PetListView
        local PetListView = nil
        pcall(function()
            local G = getgenv and getgenv() or _G
            PetListView = G.PetListView
        end)

        if not PetListView then
            pcall(function()
                PetListView = require('module/pet_list_view.lua')
                local G = getgenv and getgenv() or _G
                G.PetListView = PetListView
            end)
        end

        if not PetListView or type(PetListView.getDatastoreBagIndex) ~= "function" then
            return
        end

        local bag, index, helpers = PetListView.getDatastoreBagIndex()
        if not bag or not index or not helpers then
            return
        end

        local bp = Core:GetBackpack()
        if not bp then
            return
        end

        -- Build groups from 4 rows
        local groups = {}

        local function addGroup(id, suffix)
            local keyEnabled  = "enabled" .. suffix
            local keyTargets  = "targets" .. suffix
            local keyMinKG    = "minKG"   .. suffix
            local keyMinAge   = "minAge"  .. suffix
            local keyPetType  = "petType" .. suffix
            local keyMut      = "mut"     .. suffix
            local keyAutoUnfav = "autoUnfav" .. suffix

            if not (cfg[keyEnabled] == true) then
                return
            end

            local targets = _getGiftTargets(cfg, keyTargets)
            if not (targets and #targets > 0) then
                return
            end

            table.insert(groups, {
                id         = id,
                targets    = targets,
                kgRaw      = tonumber(cfg[keyMinKG])   or 0,
                ageRaw     = tonumber(cfg[keyMinAge])  or 0,
                petTypeMap = cfg[keyPetType]           or {},
                autoUnfav  = (cfg[keyAutoUnfav] == true),
                mutMap     = cfg[keyMut]               or {},
            })
        end

        addGroup("1", "")
        addGroup("2", "B")
        addGroup("3", "C")
        addGroup("4", "D")

        if #groups == 0 then
            return
        end

        local sent = 0

        for _, tool in ipairs(bp:GetChildren()) do
            if sent >= AUTO_GIFT_MAX_SEND_PER_PASS then
                break
            end

            if not _isPetTool(tool) then continue end

            local idAttr = tool:GetAttribute("PET_UUID")
                or tool:GetAttribute("UUID")
                or tool:GetAttribute("PetUUID")

            if not idAttr then continue end

            local core, br = helpers.normUUID(idAttr)
            local rec = index[core] or index[br]

            if not rec then continue end

            local age  = helpers.age_from_record(rec)
            local w100 = helpers.weight_at_100_for_rec(rec)

            if (not age) or (not w100) then continue end

            local PD = rec.PetData or rec.Data or {}
            local petTypeRaw =
                rec.Type or rec.PetType or
                PD.Type  or PD.PetType  or
                rec.Name or PD.Name     or
                "Pet"
            local petTypeNorm = tostring(petTypeRaw):lower()

            -- Test pet against groups in priority order, first match wins
            local chosenGroup
            for _, grp in ipairs(groups) do
                if _passesGiftGroup(w100, age, grp.kgRaw, grp.ageRaw)
                    and _passesPetType(petTypeNorm, grp.petTypeMap)
                    and _matchGiftMutation(rec, helpers, grp.mutMap)
                then
                    chosenGroup = grp
                    break
                end
            end

            if chosenGroup then
                local target = _pickLeastBackpackTarget(chosenGroup.targets)
                if target then
                    local okGive = _give(tool, target, chosenGroup.autoUnfav, bp, helpers)
                    if okGive then
                        sent = sent + 1
                    end
                end
            end
        end
    end

    ----------------------------------------------------------------
    -- AUTO ACCEPT GIFTS (unchanged)
    ----------------------------------------------------------------
    function m:StartAutoAcceptGifts()
        if not self.AutoAcceptGift then
            return
        end

        if not RequestGiftConnection then
            pcall(function()
                local GameEvents = Core.ReplicatedStorage:WaitForChild("GameEvents", 5)
                local GiftPet = GameEvents:WaitForChild("GiftPet", 5)
                local AcceptGift = GameEvents:WaitForChild("AcceptPetGift", 5)

                if not GiftPet or not AcceptGift then
                    return
                end

                RequestGiftConnection = GiftPet.OnClientEvent:Connect(function(uuid, petName, fromPlayer)
                    if not self.AutoAcceptGift then
                        return
                    end

                    AcceptGift:FireServer(true, uuid)

                    task.spawn(function()
                        local playerGui = Core.LocalPlayer:WaitForChild("PlayerGui")
                        for _ = 1, 10 do
                            local root = playerGui:FindFirstChild("Gift_Notification")
                            if root then
                                local frame = root:FindFirstChild("Frame")
                                if frame then
                                    local inner = frame:FindFirstChild("Gift_Notification")
                                    if inner then
                                        inner:Destroy()
                                    end
                                end
                            end
                            task.wait(0.3)
                        end
                    end)
                end)
            end)
        end
    end

    function m:StopAutoAcceptGifts()
        if RequestGiftConnection then
            RequestGiftConnection:Disconnect()
            RequestGiftConnection = nil
        end
    end

    ----------------------------------------------------------------
    -- AUTO ACCEPT TRADES (unchanged)
    ----------------------------------------------------------------
    local TradeEvents = nil
    local SendRequestEv = nil
    local RespondRequestEv = nil
    local AcceptEv = nil
    local ConfirmEv = nil
    local UpdateState = nil
    local AddItemEv = nil           -- untuk add pet ke trade
    local ReplicationReciever = nil
    local TradeSystemReady = false

    local function initTradeSystem()
        if TradeSystemReady then return true end

        local ok = pcall(function()
            local GE = Core.ReplicatedStorage:WaitForChild("GameEvents", 5)
            TradeEvents = GE:WaitForChild("TradeEvents", 5)

            if not TradeEvents then return end

            SendRequestEv = TradeEvents:WaitForChild("SendRequest", 3)
            RespondRequestEv = TradeEvents:WaitForChild("RespondRequest", 3)
            AcceptEv = TradeEvents:WaitForChild("Accept", 3)
            ConfirmEv = TradeEvents:WaitForChild("Confirm", 3)
            UpdateState = TradeEvents:WaitForChild("UpdateTradeState", 3)
            AddItemEv = TradeEvents:WaitForChild("AddItem", 3)

            local modules = Core.ReplicatedStorage:WaitForChild("Modules", 3)
            if modules then
                local ok2, mod = pcall(function()
                    return require(modules:WaitForChild("ReplicationReciever", 3))
                end)
                if ok2 then
                    ReplicationReciever = mod
                end
            end
        end)

        TradeSystemReady = (ok and TradeEvents and RespondRequestEv and AcceptEv and ConfirmEv and AddItemEv)
        return TradeSystemReady
    end

    function m:StartAutoAcceptTrades()
        if not self.AutoAcceptTrade then
            return
        end

        if not initTradeSystem() then
            return
        end

        if not RequestTradeConnection then
            RequestTradeConnection = SendRequestEv.OnClientEvent:Connect(function(tradeId, fromPlayer, expireAt)
                if not self.AutoAcceptTrade then
                    return
                end

                pcall(function()
                    RespondRequestEv:FireServer(tradeId, true)
                end)
            end)
        end

        if UpdateState and not self._tradeStateConnection then
            self._currentTradeId = nil
            self._replicator = nil

            self._tradeStateConnection = UpdateState.OnClientEvent:Connect(function(tradeId)
                if not self.AutoAcceptTrade then return end

                if self._replicator then
                    pcall(function() self._replicator:Destroy() end)
                    self._replicator = nil
                end

                self._currentTradeId = tradeId

                if tradeId then
                    if ReplicationReciever then
                        local ok, rep = pcall(function()
                            return ReplicationReciever.new(tradeId)
                        end)
                        if ok then
                            self._replicator = rep

                            task.defer(function()
                                task.wait(1)
                                self:RunAutoAcceptTrade()
                            end)
                        end
                    else
                        task.defer(function()
                            task.wait(1)
                            pcall(function() AcceptEv:FireServer() end)
                            task.wait(2)
                            pcall(function() ConfirmEv:FireServer() end)
                        end)
                    end
                end
            end)
        end
    end

    function m:RunAutoAcceptTrade()
        if not self.AutoAcceptTrade then return end
        if not self._replicator then return end

        local function getTradeData()
            if not self._replicator then return nil end
            local ok, data = pcall(function()
                return self._replicator:GetData()
            end)
            return ok and data or nil
        end

        local function otherAccepted()
            local data = getTradeData()
            if not data then return false end

            local players = data.players or {}
            local states = data.states or {}
            local myIdx = nil

            for i, p in ipairs(players) do
                if p == Core.LocalPlayer then
                    myIdx = i
                    break
                end
            end

            if not myIdx then return false end
            local otherIdx = (myIdx == 1) and 2 or 1
            return states[otherIdx] == "Accepted"
        end

        local function otherConfirmed()
            local data = getTradeData()
            if not data then return false end

            local players = data.players or {}
            local states = data.states or {}
            local myIdx = nil

            for i, p in ipairs(players) do
                if p == Core.LocalPlayer then
                    myIdx = i
                    break
                end
            end

            if not myIdx then return false end
            local otherIdx = (myIdx == 1) and 2 or 1
            return states[otherIdx] == "Confirmed"
        end

        for _ = 1, 100 do
            if not self.AutoAcceptTrade then return end
            if otherAccepted() then break end
            task.wait(0.5)
        end

        pcall(function() AcceptEv:FireServer() end)
        task.wait(1)

        for _ = 1, 100 do
            if not self.AutoAcceptTrade then return end
            if otherConfirmed() then break end
            task.wait(0.5)
        end

        pcall(function() ConfirmEv:FireServer() end)
    end

    function m:StopAutoAcceptTrades()
        if RequestTradeConnection then
            RequestTradeConnection:Disconnect()
            RequestTradeConnection = nil
        end
        if self._tradeStateConnection then
            self._tradeStateConnection:Disconnect()
            self._tradeStateConnection = nil
        end
        if self._replicator then
            pcall(function() self._replicator:Destroy() end)
            self._replicator = nil
        end
        self._currentTradeId = nil
    end

    ----------------------------------------------------------------
    -- AUTO TRADE (send trade + add pets + confirm)
    ----------------------------------------------------------------

    -- Get pets for trade based on petTypes filter
    function m:GetPetsForTrade(count)
        local results = {}
        count = tonumber(count) or 1

        -- Get PetListView helpers (same as Auto Gift)
        local PetListView = nil
        pcall(function()
            local G = getgenv and getgenv() or _G
            PetListView = G.PetListView
        end)

        if not PetListView or type(PetListView.getDatastoreBagIndex) ~= "function" then
            return results
        end

        local bag, index, helpers = PetListView.getDatastoreBagIndex()
        if not index or not helpers then
            return results
        end

        local petTypesFilter = self.AutoTrade.petTypes or {}
        local tradedGuids = self.AutoTrade.tradedPetGuids or {}
        local minWeight = tonumber(self.AutoTrade.minWeight) or 0

        -- Check if any pet type is selected
        local hasFilter = false
        for _, v in pairs(petTypesFilter) do
            if v then
                hasFilter = true
                break
            end
        end

        -- Iterate through pet index (same as Auto Gift)
        for guid, rec in pairs(index) do
            if #results >= count then break end

            -- Normalize GUID
            local core, br = helpers.normUUID(guid)
            local normalizedGuid = br or guid

            -- Skip pets that have already been traded in this session
            if tradedGuids[normalizedGuid] or tradedGuids[core] or tradedGuids[guid] then
                continue
            end

            if type(rec) == "table" then
                local PD = rec.PetData or rec.Data or {}
                local petType = rec.PetType or rec.Type or PD.Type or PD.PetType or rec.Name or PD.Name or "Unknown"
                local petTypeLower = tostring(petType):lower()

                -- Check favorite - skip favorited pets
                local isFavorite = false
                pcall(function()
                    isFavorite = PD.IsFavorite == true or rec.IsFavorite == true
                end)

                if not isFavorite then
                    -- Check pet type filter
                    local allowed = not hasFilter
                    if hasFilter then
                        for filterName, enabled in pairs(petTypesFilter) do
                            if enabled and tostring(filterName):lower() == petTypeLower then
                                allowed = true
                                break
                            end
                        end
                    end

                    -- Check weight filter using W100 (same as Auto Gift)
                    if allowed and minWeight ~= 0 then
                        local w100 = helpers.weight_at_100_for_rec(rec) or 0
                        local weightLimit = math.abs(minWeight)
                        local useMaxWeight = (minWeight < 0)

                        if useMaxWeight then
                            -- Negative: W100 must be <= limit
                            if w100 > weightLimit then
                                allowed = false
                            end
                        else
                            -- Positive: W100 must be >= limit
                            if w100 < weightLimit then
                                allowed = false
                            end
                        end
                    end

                    if allowed then
                        table.insert(results, {
                            guid = normalizedGuid,
                            petType = petType,
                        })
                    end
                end
            end
        end

        return results
    end

    -- Resolve target player from name or userId
    function m:ResolveTradeTarget()
        local at = self.AutoTrade

        -- If already a Player instance and still in game
        if at.targetPlayer and typeof(at.targetPlayer) == "Instance" and at.targetPlayer:IsA("Player") then
            if at.targetPlayer.Parent == Core.Players then
                return at.targetPlayer
            end
        end

        -- Try by userId
        if at.targetUserId then
            local plr = Core.Players:GetPlayerByUserId(at.targetUserId)
            if plr then
                at.targetPlayer = plr
                return plr
            end
        end

        -- Try by name
        if at.targetPlayer and type(at.targetPlayer) == "string" then
            local want = string.lower(at.targetPlayer)
            for _, p in ipairs(Core.Players:GetPlayers()) do
                if string.lower(p.Name) == want then
                    at.targetPlayer = p
                    at.targetUserId = p.UserId
                    return p
                end
            end
        end

        return nil
    end

    -- Find and equip Trading Ticket from backpack
    function m:EquipTradingTicket()
        local bp = Core:GetBackpack()
        if not bp then return false end

        local char = Core.LocalPlayer.Character
        if not char then return false end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end

        -- Unequip current tools first
        pcall(function() hum:UnequipTools() end)
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                obj.Parent = bp
            end
        end
        task.wait(0.1)

        -- Find Trading Ticket in backpack
        local ticket = nil
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("trading ticket") or name:find("tradingticket") then
                    ticket = tool
                    break
                end
            end
        end

        -- Fallback: cari by attribute jika tidak ketemu by name
        if not ticket then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    local itemType = tool:GetAttribute("ItemType") or tool:GetAttribute("b")
                    if itemType and tostring(itemType):lower():find("ticket") then
                        ticket = tool
                        break
                    end
                end
            end
        end

        if not ticket then
            warn("[AutoTrade] Trading Ticket not found in backpack")
            return false
        end

        -- Equip the ticket
        ticket.Parent = char
        task.wait(0.2)
        pcall(function() hum:EquipTool(ticket) end)
        task.wait(0.3)

        return true
    end

    -- Unequip Trading Ticket back to backpack
    function m:UnequipTradingTicket()
        local bp = Core:GetBackpack()
        if not bp then return end

        local char = Core.LocalPlayer.Character
        if not char then return end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:UnequipTools() end)
        end

        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                obj.Parent = bp
            end
        end
    end

    -- Start Auto Trade
    function m:StartAutoTrade()
        if not self.AutoTrade.enabled then return end
        if not initTradeSystem() then
            warn("[AutoTrade] Trade system not ready")
            return
        end

        -- Reset counter and traded pets tracker
        self.AutoTrade.tradesCompleted = 0
        self.AutoTrade.tradedPetGuids = {}
        self._autoTradeRunning = true

        task.spawn(function()
            self:RunAutoTradeLoop()
        end)
    end

    -- Stop Auto Trade
    function m:StopAutoTrade()
        self.AutoTrade.enabled = false
        self._autoTradeRunning = false

        if AutoTradeConnection then
            AutoTradeConnection:Disconnect()
            AutoTradeConnection = nil
        end
    end

    -- Main Auto Trade Loop
    function m:RunAutoTradeLoop()
        local at = self.AutoTrade

        while self._autoTradeRunning and at.enabled do
            -- Check if we've completed enough trades
            if at.tradesCompleted >= at.tradeCount then
                print("[AutoTrade] Completed", at.tradesCompleted, "trades. Stopping.")
                self:StopAutoTrade()
                break
            end

            -- Resolve target
            local target = self:ResolveTradeTarget()
            if not target then
                warn("[AutoTrade] Target player not found, waiting...")
                task.wait(2)
                continue
            end

            -- Get pets to trade
            local pets = self:GetPetsForTrade(at.petCount)
            if #pets == 0 then
                warn("[AutoTrade] No pets available for trade")
                task.wait(2)
                continue
            end

            -- Equip Trading Ticket before sending request
            print("[AutoTrade] Equipping Trading Ticket...")
            local ticketEquipped = self:EquipTradingTicket()
            if not ticketEquipped then
                warn("[AutoTrade] Failed to equip Trading Ticket, retrying...")
                task.wait(2)
                continue
            end

            -- Wait for trade state update
            self._waitingForTrade = true
            self._tradeSuccess = false

            -- Setup listener BEFORE sending request (to catch fast auto-accept)
            local stateConn
            stateConn = UpdateState.OnClientEvent:Connect(function(tradeId)
                if not self._autoTradeRunning then
                    if stateConn then stateConn:Disconnect() end
                    return
                end

                if tradeId then
                    print("[AutoTrade] Trade session started, tradeId:", tradeId)

                    -- Trade session started, add pets
                    task.wait(0.3)

                    print("[AutoTrade] Adding", #pets, "pets...")
                    for i, petInfo in ipairs(pets) do
                        if not self._autoTradeRunning then break end

                        print("[AutoTrade] Adding pet", i, ":", petInfo.guid)
                        pcall(function()
                            AddItemEv:FireServer("Pet", petInfo.guid)
                        end)
                        -- Mark pet as traded so it won't be selected again
                        at.tradedPetGuids[petInfo.guid] = true
                        task.wait(0.2)
                    end

                    -- Wait for pets to register in trade
                    print("[AutoTrade] Waiting 5s for pets to register...")
                    task.wait(5)

                    -- Accept trade 10x
                    print("[AutoTrade] Accepting trade (10x)...")
                    for i = 1, 10 do
                        pcall(function()
                            game:GetService("ReplicatedStorage").GameEvents.TradeEvents.Accept:FireServer()
                        end)
                        task.wait(0.2)
                    end

                    -- Wait before confirm
                    print("[AutoTrade] Waiting 5s before confirm...")
                    task.wait(5)

                    -- Confirm trade 10x
                    print("[AutoTrade] Confirming trade (10x)...")
                    for i = 1, 10 do
                        pcall(function()
                            game:GetService("ReplicatedStorage").GameEvents.TradeEvents.Confirm:FireServer()
                        end)
                        task.wait(0.2)
                    end

                    -- Wait for trade to complete
                    task.wait(2)
                    local tradeSuccess = true

                    -- Only mark success if trade completed
                    if tradeSuccess then
                        task.wait(1)
                        at.tradesCompleted = at.tradesCompleted + 1
                        print("[AutoTrade] Trade completed!", at.tradesCompleted, "/", at.tradeCount)

                        -- Notify callback if exists (update UI counter)
                        if self.OnTradeCompleted then
                            task.spawn(function()
                                self.OnTradeCompleted(at.tradesCompleted, at.tradeCount)
                            end)
                        end
                    else
                        print("[AutoTrade] Trade was cancelled or failed")
                    end

                    self._tradeSuccess = true -- allow loop to continue
                end

                if stateConn then
                    stateConn:Disconnect()
                    stateConn = nil
                end
            end)

            -- NOW send trade request (after listener is ready)
            print("[AutoTrade] Sending trade request to", target.Name)
            local tradeStarted = false

            pcall(function()
                SendRequestEv:FireServer(target)
                tradeStarted = true
            end)

            -- Unequip ticket after sending request
            task.wait(0.5)
            self:UnequipTradingTicket()

            if not tradeStarted then
                warn("[AutoTrade] Failed to send trade request")
                if stateConn then stateConn:Disconnect() end
                task.wait(2)
                continue
            end

            -- Wait for trade to complete or timeout
            local completed = false
            local startTime = os.clock()
            local timeout = 90 -- 90 seconds timeout

            while not completed and self._autoTradeRunning do
                if self._tradeSuccess then
                    completed = true
                    break
                end
                if (os.clock() - startTime) > timeout then
                    warn("[AutoTrade] Trade timeout")
                    break
                end
                task.wait(0.5)
            end

            if stateConn then
                stateConn:Disconnect()
            end

            self._waitingForTrade = false

            -- Delay before next trade (wait for trade UI to fully close)
            if self._autoTradeRunning and at.enabled then
                print("[AutoTrade] Waiting before next trade...")
                task.wait(5)
            end
        end

        self._autoTradeRunning = false
    end

    return m

end

