        -- Get boost items from PetListView
        local function getBoostItems()
            local items = {}
            pcall(function()
                local PetListView = G.PetListView
                if PetListView and PetListView.buildPetBoostItems then
                    local boostItems = PetListView.buildPetBoostItems()
                    for _, item in ipairs(boostItems) do
                        table.insert(items, item.name or item.key or "Unknown Boost")
                    end
                end
            end)
            if #items == 0 then
                table.insert(items, "No boost items found")
            end
            return items
        end

        -- Store boost dropdown for refresh
        m.BoostItemDropdown = section:AddDropdown({
            Title = "Select Boost Items",
            Options = getBoostItems(),
            Multi = true,
            Flag = "BoostItemsSelected",
            OnOpen = function()
                -- Auto-refresh boost items when dropdown is opened
                return getBoostItems()
            end,
            Callback = function(selected)
                G.PETBOOST_SELECTED = {}
                -- Map names back to UUIDs using PetListView
                pcall(function()
                    local PetListView = G.PetListView
                    if PetListView and PetListView.buildPetBoostItems then
                        local boostItems = PetListView.buildPetBoostItems()
                        for _, item in ipairs(boostItems) do
                            local itemName = item.name or item.key
                            for _, selectedName in ipairs(selected) do
                                if itemName == selectedName then
                                    G.PETBOOST_SELECTED[item.key] = true
                                end
                            end
                        end
                    end
                end)
            end
