    -------------------------------------------------------------
    -- 2) Helper kecil (UUID, number, scale, dst)
    -------------------------------------------------------------
    local function __normUUID(u)
        if not u or u == "" then return nil, nil end
        local core = tostring(u):match("{?([0-9a-fA-F%-]+)}?") or tostring(u)
        return core, "{"..core.."}"
