    function m:Notify(title, content, color)
        print("[Growth] Notify called:", title, content)
        if self.OnNotify then
            self.OnNotify(title, content, color)
        else
            print("[Growth] WARNING: OnNotify callback not set!")
        end
    end

    -- Load mutations from game registry
    function m:LoadMutationsFromGame()
        local mutations = {}
        self.MutationEnumMap = {} -- Enum to display name mapping (e.g., "X" -> "Venom")

        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local mutationModule = require(RS.Data.PetRegistry.PetMutationRegistry)

            -- Load EnumToPetMutation mapping (like mutation module)
            if mutationModule.EnumToPetMutation then
                for enumVal, displayName in pairs(mutationModule.EnumToPetMutation) do
                    self.MutationEnumMap[enumVal] = displayName
                end
            end

            if mutationModule and mutationModule.PetMutationRegistry then
                for mutName, info in pairs(mutationModule.PetMutationRegistry) do
                    if type(mutName) == "string" and mutName ~= "" then
                        table.insert(mutations, mutName)
                    end
                end
            elseif type(mutationModule) == "table" then
                for mutName, _ in pairs(mutationModule) do
                    if type(mutName) == "string" and mutName ~= "" and mutName ~= "EnumToPetMutation" then
                        table.insert(mutations, mutName)
                    end
                end
            end
        end)

        table.sort(mutations)
        if #mutations > 0 then
            self.AvailableMutations = mutations
        else
            self.AvailableMutations = {"Nightmare", "Venom", "Golden", "Rainbow"}
        end
    end

    -- Get pet mutation type (robust detection like mutation module)
    function m:GetPetMutation(petData)
        if not petData then return nil end

        local mutation = nil
        pcall(function()
            -- Get raw mutation type (enum like "X")
            local rawMutation = nil

            -- Check multiple possible locations
            if petData.MutationType and petData.MutationType ~= "" then
                rawMutation = petData.MutationType
            elseif petData.PetData and petData.PetData.MutationType and petData.PetData.MutationType ~= "" then
                rawMutation = petData.PetData.MutationType
            elseif petData.Mutation and petData.Mutation ~= "" then
                rawMutation = petData.Mutation
            end

            if rawMutation then
                -- Convert enum to display name using MutationEnumMap
                if self.MutationEnumMap and self.MutationEnumMap[rawMutation] then
                    mutation = self.MutationEnumMap[rawMutation]
                else
                    -- Fallback: use raw value
                    mutation = rawMutation
                end

                -- Normalize Gold to Golden
                if mutation == "Gold" then
                    mutation = "Golden"
                end
            end
        end)

        return mutation
    end

    -- Check if pet has target mutation (case-insensitive)
    function m:HasTargetMutation(petData)
        local mutation = self:GetPetMutation(petData)
        if not mutation then return false end

        local mutationLower = string.lower(tostring(mutation))
        for targetMut, _ in pairs(self.TargetMutations) do
            if string.lower(tostring(targetMut)) == mutationLower then
                return true
            end
        end
        return false
    end

    -- Get correct team based on pet state and priority
    function m:GetTeamForPet(petData)
        local age = Pet:GetPetAge(petData) or 0
        local hasMutation = self:HasTargetMutation(petData)

        if self.PriorityFlow == "leveling" then
            -- Leveling First Flow
            if age < 40 then
                return self.LevelingTeam1Pets, "leveling1"
            elseif age < 100 then
                return self.LevelingTeam2Pets, "leveling2"
            elseif not hasMutation then
                return self.MutationTeamPets, "mutation"
            else
                return nil, "done" -- Has mutation + age >= 100
            end
        else
            -- Mutation First Flow
            if not hasMutation then
                return self.MutationTeamPets, "mutation"
            elseif age < 40 then
                return self.LevelingTeam1Pets, "leveling1"
            elseif age < 100 then
                return self.LevelingTeam2Pets, "leveling2"
            else
                return nil, "done" -- Has mutation + age >= 100
            end
        end
    end

    -- Get skill cooldown for stuck detection
    function m:GetSkillCooldown(uuid, tokens)
        if not uuid or uuid == "" then return nil end
        tokens = tokens or ALL_SKILL_TOKENS

        local cooldowns = nil
        pcall(function()
            local GameEvents = Core.ReplicatedStorage:WaitForChild("GameEvents", 2)
            local GetPetCooldownRF = GameEvents:WaitForChild("GetPetCooldown", 2)
            if GetPetCooldownRF then
                cooldowns = GetPetCooldownRF:InvokeServer(uuid)
            end
        end)

        if type(cooldowns) ~= "table" then return nil end

        for _, cd in ipairs(cooldowns) do
            local skill = string.lower(tostring(cd.Skill or cd.Passive or ""))
            for _, token in ipairs(tokens) do
                if skill:find(token, 1, true) then
                    local time = cd.Time
                    if type(time) == "number" then return time end
                    if type(time) == "string" then
                        local min, sec = time:match("^(%d+)%s*:%s*(%d+)$")
                        if min and sec then return tonumber(min) * 60 + tonumber(sec) end
                        return tonumber(time:match("%-?%d+%.?%d*")) or 0
                    end
                end
            end
        end
        return nil
    end

    -- Check and fix stuck pets
    function m:CheckStuckPets()
        if not self.SkillStuckEnabled then return end

        local activePets = Pet:GetActivePets() or {}
        local stuckPets = {}

        for _, guid in ipairs(activePets) do
            local cooldown = self:GetSkillCooldown(guid, ALL_SKILL_TOKENS)
            local rec = SKILL_STUCK[guid] or { lastCooldown = nil, sameCount = 0 }

            if cooldown == nil then
                rec.lastCooldown, rec.sameCount = nil, 0
            else
                if rec.lastCooldown ~= nil then
                    local diff = cooldown - rec.lastCooldown
                    if diff >= -self.SkillStuckTolerance then
                        rec.sameCount = (rec.sameCount or 0) + 1
                    else
                        rec.sameCount = 0
                    end
                else
                    rec.sameCount = 0
                end

                rec.lastCooldown = cooldown

                if rec.sameCount >= self.SkillStuckThreshold then
                    table.insert(stuckPets, guid)
                    rec.sameCount = 0
                end
            end

            SKILL_STUCK[guid] = rec
        end

        if #stuckPets > 0 then
            for _, guid in ipairs(stuckPets) do
                Pet:UnequipPet(guid)
                task.wait(0.25)
            end
            task.wait(0.5)
            for _, guid in ipairs(stuckPets) do
                Pet:EquipPet(guid)
                task.wait(0.25)
            end
        end
    end

    -- Get pet team GUIDs as map (accepts {guid=true} set directly)
    function m:GetTeamGuids(petTeamPets)
        if type(petTeamPets) == "table" then
            return petTeamPets
        end
        return {}
    end

    -- Equip pet team (accepts {guid=true} set directly)
    function m:EquipTeam(petTeamPets)
        if not petTeamPets or next(petTeamPets) == nil then return end

        local activePets = {}
        for _, guid in ipairs(Pet:GetActivePets() or {}) do
            activePets[guid] = true
        end

        for guid, _ in pairs(petTeamPets) do
            if not activePets[guid] then
                Pet:EquipPet(guid)
                task.wait(0.25)
            end
        end
    end

    -- Pickup all pets
    function m:PickupAllPets()
        local activePets = Pet:GetActivePets()
        if not activePets then return end

        for _, guid in ipairs(activePets) do
            Pet:UnequipPet(guid)
            task.wait(0.25)
        end
    end

    -- Check and unequip pets that completed their current stage
    -- Uses SAME stage detection logic as RunGrowthCycle (based on pet progress counting)
    function m:CheckAndUnequipCompletedPets()
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then return end

        -- Get all pets and filter by target types (same as RunGrowthCycle)
        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterTargetPets(allPets)

        -- Count target pets stats to determine current stage
        local totalTarget = 0
        local hasMutation = 0
        local age40Plus = 0
        local age100Plus = 0

        for guid, petData in pairs(targetPets) do
            totalTarget = totalTarget + 1
            local hasTargetMut = self:HasTargetMutation(petData)
            local age = Pet:GetPetAge(petData) or 0

            if hasTargetMut then
                hasMutation = hasMutation + 1
            end

            if self.PriorityFlow == "mutation" then
                if hasTargetMut then
                    if age >= 40 then age40Plus = age40Plus + 1 end
                    if age >= 100 then age100Plus = age100Plus + 1 end
                end
            else
                if age >= 40 then age40Plus = age40Plus + 1 end
                if age >= 100 then age100Plus = age100Plus + 1 end
            end
        end

        -- No target pets = nothing to do
        if totalTarget == 0 then return end

        -- Determine current stage (SAME logic as RunGrowthCycle)
        local currentStage = ""
        if self.PriorityFlow == "mutation" then
            if hasMutation < totalTarget then
                currentStage = "mutation"
            elseif age40Plus < totalTarget then
                currentStage = "leveling1"
            elseif age100Plus < totalTarget then
                currentStage = "leveling2"
            else
                currentStage = "done"
            end
        else
            if age40Plus < totalTarget then
                currentStage = "leveling1"
            elseif age100Plus < totalTarget then
                currentStage = "leveling2"
            elseif hasMutation < totalTarget then
                currentStage = "mutation"
            else
                currentStage = "done"
            end
        end

        -- Get all team GUIDs
        local allTeamGuids = {}
        for k, v in pairs(self:GetTeamGuids(self.MutationTeamPets)) do allTeamGuids[k] = v end
        for k, v in pairs(self:GetTeamGuids(self.LevelingTeam1Pets)) do allTeamGuids[k] = v end
        for k, v in pairs(self:GetTeamGuids(self.LevelingTeam2Pets)) do allTeamGuids[k] = v end

        -- Check each active pet
        for _, guid in ipairs(activePetsArray) do
            -- Skip pet team members
            if not allTeamGuids[guid] then
                local petData = Pet:GetPetData(guid)
                if petData then
                    local petType = Pet:GetPetType(petData)

                    -- Only check target pet types
                    if self.TargetPetTypes[petType] then
                        local age = Pet:GetPetAge(petData) or 0
                        local mutation = self:GetPetMutation(petData)
                        local hasMut = self:HasTargetMutation(petData)

                        local shouldUnequip = false
                        local reason = ""
                        local notifyTitle = "Stage Complete!"
                        local notifyColor = Color3.fromRGB(100, 200, 255)

                        -- Check if pet completed current stage
                        if currentStage == "mutation" then
                            -- Mutation phase: unequip if got target mutation
                            if hasMut then
                                shouldUnequip = true
                                reason = "Got " .. (mutation or "mutation") .. "!"
                                notifyTitle = "Mutation Obtained!"
                                notifyColor = Color3.fromRGB(148, 0, 211)  -- Purple
                            end
                        elseif currentStage == "leveling1" then
                            -- Level 1-40 phase: unequip if age >= 40
                            if age >= 40 then
                                shouldUnequip = true
                                reason = "Age " .. age .. "!"
                                notifyTitle = "Age 40 Reached!"
                                notifyColor = Color3.fromRGB(255, 165, 0)  -- Orange
                            end
                        elseif currentStage == "leveling2" then
                            -- Level 40-100 phase: unequip if age >= 100
                            if age >= 100 then
                                shouldUnequip = true
                                reason = "Age " .. age .. "!"
                                notifyTitle = "Age 100 Reached!"
                                notifyColor = Color3.fromRGB(50, 205, 50)  -- Green
                            end
                        elseif currentStage == "done" then
                            -- All done: unequip all target pets
                            shouldUnequip = true
                            reason = "All complete!"
                            notifyTitle = "Growth Complete!"
                            notifyColor = Color3.fromRGB(255, 215, 0)  -- Gold
                        end

                        if shouldUnequip then
                            print("[Growth] Unequipping:", petType, mutation or "No mutation", "Age:", age, "-", reason)

                            -- Send notification and webhook (only if not already sent for this pet/stage)
                            local webhookKey = guid .. "_" .. currentStage
                            if not self.WebhookSent[webhookKey] then
                                self.WebhookSent[webhookKey] = true  -- Mark as sent

                                -- Send UI notification
                                self:Notify(notifyTitle, petType .. " " .. (mutation or "") .. " - " .. reason, notifyColor)

                                -- Send webhook notification
                                local G = getgenv and getgenv() or _G
                                if G.SpecialWebhook then
                                    -- Count remaining pets that haven't completed current stage
                                    local remainingCount = 0
                                    for g, pd in pairs(targetPets) do
                                        if g ~= guid then
                                            local pAge = Pet:GetPetAge(pd) or 0
                                            local pMut = self:HasTargetMutation(pd)
                                            local stillNeeds = false
                                            if currentStage == "mutation" and not pMut then stillNeeds = true
                                            elseif currentStage == "leveling1" and pAge < 40 then stillNeeds = true
                                            elseif currentStage == "leveling2" and pAge < 100 then stillNeeds = true
                                            end
                                            if stillNeeds then remainingCount = remainingCount + 1 end
                                        end
                                    end
                                    print("[Growth] Sending milestone webhook:", petType, mutation, age, currentStage, remainingCount)
                                    pcall(function()
                                        G.SpecialWebhook:GrowthMilestone(petType, mutation, age, currentStage, remainingCount)
                                    end)
                                end
                            end

                            Pet:UnequipPet(guid)
                            task.wait(0.25)
                        end
                    end
                end
            end
        end
    end

    -- Filter pets by target types (skip favorited)
    function m:FilterTargetPets(pets)
        if not self.TargetPetTypes or next(self.TargetPetTypes) == nil then
            return pets
        end

        local filtered = {}
        for guid, petData in pairs(pets) do
            local petType = Pet:GetPetType(petData)
            local isFavorited = Pet:IsPetFavorited(petData)
            if self.TargetPetTypes[petType] and not isFavorited then
                filtered[guid] = petData
            end
        end
        return filtered
    end

    -- Check if pet should be cleansed (has unwanted mutation)
    function m:ShouldCleansePet(petData)
        local mutation = self:GetPetMutation(petData)

        -- No mutation = don't cleanse
        if not mutation or mutation == "" then
            return false
        end

        -- Check if mutation is in target list (should keep)
        local mutationLower = string.lower(tostring(mutation))
        for keepMutation, _ in pairs(self.TargetMutations) do
            if string.lower(tostring(keepMutation)) == mutationLower then
                return false -- Keep this mutation
            end
        end

        -- Has mutation but not in target list = should cleanse
        return true
    end

    -- Cleanse a pet (apply cleansing shard)
    function m:CleansePet(petGuid)
        local Player = Players.LocalPlayer
        if not Player then return false end

        -- Get cleansing shard from backpack
        local cleansingTool = nil
        pcall(function()
            if Player.Backpack then
                for _, tool in pairs(Player.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        local toolName = tool.Name
                        local attrU = tool:GetAttribute("u") or ""
                        local attrItemName = tool:GetAttribute("ItemName") or ""

                        if toolName:find("Cleansing") or toolName:find("cleansing") or
                           attrU:find("Cleansing") or attrU:find("cleansing") or
                           attrItemName:find("Cleansing") or attrItemName:find("cleansing") then
                            cleansingTool = tool
                            break
                        end
                    end
                end
            end
        end)

        if not cleansingTool then
            return false
        end

        -- Find pet model in PetsPhysical
        local petMover = nil
        pcall(function()
            local petsPhysical = Core.Workspace:FindFirstChild("PetsPhysical")
            if petsPhysical then
                for _, container in ipairs(petsPhysical:GetChildren()) do
                    local modelPet = container:FindFirstChild(petGuid)
                    if modelPet then
                        petMover = modelPet
                        break
                    end
                end
            end
        end)

        if not petMover then
            return false
        end

        -- Unequip any current tool
        pcall(function()
            if Player.Character then
                for _, child in pairs(Player.Character:GetChildren()) do
                    if child:IsA("Tool") then
                        child.Parent = Player.Backpack
                    end
                end
            end
        end)
        task.wait(0.2)

        -- Equip cleansing tool
        pcall(function()
            if Player.Character and cleansingTool then
                cleansingTool.Parent = Player.Character
            end
        end)
        task.wait(0.5)

        -- Apply cleansing shard
        local success = pcall(function()
            Core.ReplicatedStorage.GameEvents.PetShardService_RE:FireServer(
                "ApplyShard",
                petMover
            )
        end)

        task.wait(1)

        -- Unequip tool
        pcall(function()
            if Player.Character and cleansingTool then
                cleansingTool.Parent = Player.Backpack
            end
        end)

        if success then
            self:Notify("Pet Cleansed", "Removed unwanted mutation from pet", Color3.fromRGB(200, 150, 255))
            return true
        end
        return false
    end

    -- Check active pets and cleanse those with unwanted mutations
    -- IMPORTANT: Only cleanse TARGET pets, not pet team members!
    function m:CheckAndCleansePets()
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then return end

        local allPets = Pet:GetAllPetsInInventory()

        -- Get all team GUIDs to skip
        local allTeamGuids = {}
        for k, v in pairs(self:GetTeamGuids(self.MutationTeamPets)) do allTeamGuids[k] = v end
        for k, v in pairs(self:GetTeamGuids(self.LevelingTeam1Pets)) do allTeamGuids[k] = v end
        for k, v in pairs(self:GetTeamGuids(self.LevelingTeam2Pets)) do allTeamGuids[k] = v end

        for _, guid in ipairs(activePetsArray) do
            -- Skip pet team members - only cleanse target pets
            if not allTeamGuids[guid] then
                local petData = allPets[guid]
                if petData then
                    local petType = Pet:GetPetType(petData)
                    local mutation = self:GetPetMutation(petData)

                    -- Only cleanse if pet is in target types
                    if self.TargetPetTypes[petType] then
                        local shouldCleanse = self:ShouldCleansePet(petData)
                        -- print("[Growth] Checking pet:", petType, "Mutation:", mutation or "None", "ShouldCleanse:", shouldCleanse)
                        if shouldCleanse then
                            -- print("[Growth] Cleansing pet:", petType, "with unwanted mutation:", mutation)
                            local success = self:CleansePet(guid)
                            -- print("[Growth] Cleanse result:", success)
                            task.wait(1.5)
                        end
                    end
                end
            end
        end
    end

    -- Main growth logic (BATCH approach - all pets complete stage before moving to next)
    function m:RunGrowthCycle()
        -- Get all pets and filter by target types
        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterTargetPets(allPets)

        -- Count target pets stats (considering priority flow)
        local totalTarget = 0
        local hasMutation = 0
        local age40Plus = 0
        local age100Plus = 0

        for guid, petData in pairs(targetPets) do
            totalTarget = totalTarget + 1
            local hasTargetMut = self:HasTargetMutation(petData)
            local age = Pet:GetPetAge(petData) or 0

            if hasTargetMut then
                hasMutation = hasMutation + 1
            end

            if self.PriorityFlow == "mutation" then
                -- Mutation First: only count age milestones for pets WITH target mutation
                -- Pet without mutation should stay in mutation stage regardless of age
                if hasTargetMut then
                    if age >= 40 then
                        age40Plus = age40Plus + 1
                    end
                    if age >= 100 then
                        age100Plus = age100Plus + 1
                    end
                end
            else
                -- Leveling First: count age milestones for all pets
                -- Only count mutation for pets that reached age 100
                if age >= 40 then
                    age40Plus = age40Plus + 1
                end
                if age >= 100 then
                    age100Plus = age100Plus + 1
                end
            end
        end

        -- Determine current stage based on batch progress
        local currentStage = ""
        local currentTeam = nil
        -- If no target pets in inventory, pickup any remaining in garden and stay idle
        if totalTarget == 0 then
            local activePetsArray = Pet:GetActivePets() or {}
            local allTeamGuids = {}
            for k, v in pairs(self:GetTeamGuids(self.MutationTeamPets)) do allTeamGuids[k] = v end
            for k, v in pairs(self:GetTeamGuids(self.LevelingTeam1Pets)) do allTeamGuids[k] = v end
            for k, v in pairs(self:GetTeamGuids(self.LevelingTeam2Pets)) do allTeamGuids[k] = v end

            -- Check if any target pets are still in garden (from previous run)
            for _, guid in ipairs(activePetsArray) do
                if not allTeamGuids[guid] then
                    -- Use GetPetData for active pets (not inventory)
                    local petData = Pet:GetPetData(guid)
                    if petData then
                        local petType = Pet:GetPetType(petData)
                        if self.TargetPetTypes[petType] then
                            print("[Growth] Unequipping target pet in garden:", petType)
                            Pet:UnequipPet(guid)
                            task.wait(0.25)
                        end
                    end
                end
            end

            print("[Growth] No target pets in inventory, staying idle")
            return
        end

        if self.PriorityFlow == "mutation" then
            -- Mutation First: mutation -> lv1-40 -> lv40-100 -> done
            if hasMutation < totalTarget then
                currentStage = "mutation"
                currentTeam = self.MutationTeamPets
            elseif age40Plus < totalTarget then
                currentStage = "leveling1"
                currentTeam = self.LevelingTeam1Pets
            elseif age100Plus < totalTarget then
                currentStage = "leveling2"
                currentTeam = self.LevelingTeam2Pets
            else
                currentStage = "done"
            end
        else
            -- Leveling First: lv1-40 -> lv40-100 -> mutation -> done
            if age40Plus < totalTarget then
                currentStage = "leveling1"
                currentTeam = self.LevelingTeam1Pets
            elseif age100Plus < totalTarget then
                currentStage = "leveling2"
                currentTeam = self.LevelingTeam2Pets
            elseif hasMutation < totalTarget then
                currentStage = "mutation"
                currentTeam = self.MutationTeamPets
            else
                currentStage = "done"
            end
        end

        -- Debug print
        -- print("[Growth] Stage:", currentStage, "Total:", totalTarget, "Mutation:", hasMutation, "Age40+:", age40Plus, "Age100+:", age100Plus)

        -- Detect phase transition - if phase changed, pickup ALL pets first
        if self.CurrentPhase and self.CurrentPhase ~= currentStage then
            print("[Growth] PHASE TRANSITION:", self.CurrentPhase, "->", currentStage)

            -- Phase complete notification
            local phaseCompleteText = ""
            local phaseColor = Color3.fromRGB(255, 200, 100)
            if self.CurrentPhase == "mutation" then
                phaseCompleteText = "Mutation Phase Complete!"
                phaseColor = Color3.fromRGB(148, 0, 211)  -- Purple
            elseif self.CurrentPhase == "leveling1" then
                phaseCompleteText = "Level 1-40 Phase Complete!"
                phaseColor = Color3.fromRGB(255, 165, 0)  -- Orange
            elseif self.CurrentPhase == "leveling2" then
                phaseCompleteText = "Level 40-100 Phase Complete!"
                phaseColor = Color3.fromRGB(50, 205, 50)  -- Green
            end
            self:Notify(phaseCompleteText, "Moving to: " .. currentStage, phaseColor)

            -- Send webhook for phase completion (previous phase is now complete)
            local G = getgenv and getgenv() or _G
            if G.SpecialWebhook then
                print("[Growth] Sending phase complete webhook:", self.CurrentPhase, "totalPets:", totalTarget)
                pcall(function()
                    G.SpecialWebhook:GrowthPhaseComplete(self.CurrentPhase, totalTarget)
                end)
            end

            -- Pickup ALL pets from garden (both team and target pets)
            local activePetsArray = Pet:GetActivePets() or {}
            for _, guid in ipairs(activePetsArray) do
                Pet:UnequipPet(guid)
                task.wait(0.2)
            end

            print("[Growth] All pets picked up, waiting before equipping new team...")
            task.wait(1)
        end

        -- Update current phase
        self.CurrentPhase = currentStage

        -- If all done, we're finished
        if currentStage == "done" then
            self:Notify("Growth Complete!", "All " .. totalTarget .. " pets finished!", Color3.fromRGB(100, 255, 100))
            self.CurrentPhase = nil
            return
        end

        -- Get all team GUIDs
        local allTeamGuids = {}
        for k, v in pairs(self:GetTeamGuids(self.MutationTeamPets)) do allTeamGuids[k] = v end
        for k, v in pairs(self:GetTeamGuids(self.LevelingTeam1Pets)) do allTeamGuids[k] = v end
        for k, v in pairs(self:GetTeamGuids(self.LevelingTeam2Pets)) do allTeamGuids[k] = v end

        -- Check if current team is already equipped
        local activePetsArray = Pet:GetActivePets() or {}
        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        local currentTeamGuids = self:GetTeamGuids(currentTeam)
        local teamNeedsEquip = false
        for guid, _ in pairs(currentTeamGuids) do
            if not activePets[guid] then
                teamNeedsEquip = true
                break
            end
        end

        -- Only equip team if some members are missing
        if currentTeam and teamNeedsEquip then
            self:EquipTeam(currentTeam)
            -- Refresh active pets after equip
            activePetsArray = Pet:GetActivePets() or {}
            activePets = {}
            for _, guid in ipairs(activePetsArray) do
                activePets[guid] = true
            end
        end

        -- Refresh active pets for target counting
        activePetsArray = Pet:GetActivePets() or {}
        activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        local targetCount = 0
        for _, guid in ipairs(activePetsArray) do
            if not allTeamGuids[guid] then
                local petData = Pet:GetPetData(guid)
                if petData then
                    local petType = Pet:GetPetType(petData)
                    if self.TargetPetTypes[petType] then
                        targetCount = targetCount + 1
                    end
                end
            end
        end

        -- Unequip logic moved to CheckAndUnequipCompletedPets()
        -- Here we only focus on equipping new pets

        -- Calculate available slots: 8 max - current team size
        local currentTeamSize = 0
        local currentTeamGuids = self:GetTeamGuids(currentTeam)
        for _ in pairs(currentTeamGuids) do
            currentTeamSize = currentTeamSize + 1
        end
        local maxTargetSlots = 8 - currentTeamSize

        local canEquip = maxTargetSlots - targetCount
        if canEquip > 0 then
            for guid, petData in pairs(targetPets) do
                if canEquip <= 0 then break end
                if not activePets[guid] then
                    -- Check if pet still needs current stage
                    local needsCurrentStage = false
                    local age = Pet:GetPetAge(petData) or 0
                    local hasMut = self:HasTargetMutation(petData)

                    if currentStage == "mutation" and not hasMut then
                        needsCurrentStage = true
                    elseif currentStage == "leveling1" and age < 40 then
                        needsCurrentStage = true
                    elseif currentStage == "leveling2" and age < 100 then
                        needsCurrentStage = true
                    end

                    if needsCurrentStage then
                        Pet:EquipPet(guid)
                        canEquip = canEquip - 1
                        task.wait(0.25)
                    end
                end
            end
        end

        -- CheckStuckPets and CheckAndCleansePets are called from main loop
    end

    function m:Start()
        if self.IsRunning then return end

        if next(self.LevelingTeam1Pets) == nil and next(self.LevelingTeam2Pets) == nil and next(self.MutationTeamPets) == nil then
            self:Notify("Growth", "Please select at least one pet team!", Color3.fromRGB(255, 100, 100))
            return
        end

        if next(self.TargetPetTypes) == nil then
            self:Notify("Growth", "Please select target pet types!", Color3.fromRGB(255, 100, 100))
            return
        end

        self.IsRunning = true
        self.CurrentPhase = nil  -- Reset phase tracking
        self.WebhookSent = {}    -- Reset webhook tracking
        SKILL_STUCK = {}

        self:Notify("Growth Started", "Priority: " .. self.PriorityFlow, Color3.fromRGB(100, 180, 255))

        task.spawn(function()
            self:PickupAllPets()
            task.wait(1)

            while self.IsRunning do
                pcall(function()
                    -- First check and unequip any fully completed pets
                    self:CheckAndUnequipCompletedPets()

                    -- Run main growth cycle
                    self:RunGrowthCycle()
                    self:CheckStuckPets()
                    self:CheckAndCleansePets()
                end)
                task.wait(5)
            end
        end)
    end

    function m:Stop()
        local wasRunning = self.IsRunning
        self.IsRunning = false


        if wasRunning then
            self:Notify("Growth Stopped", "Auto growth stopped", Color3.fromRGB(255, 150, 100))
            task.spawn(function()
                task.wait(0.5)
                self:PickupAllPets()
            end)
        end
    end

    return m

end

-- Module: shop/ui_pandoruy.lua
EmbeddedModules["shop/ui_pandoruy.lua"] = function()
    -- shop/ui_pandoruy.lua
    -- UI module for Shop tab (Auto Buy Seed, Egg, Gear)

    local m = {}

    -- Module references
    local Window
    local PandoruyHub
    local HttpService = game:GetService("HttpService")

    -- Storage (username-based path set in Init)
    local SAVE_BASE = "Pandora_KG"
    local SAVE_DIR = SAVE_BASE
    local SAVE_FILE = SAVE_DIR .. "/shop_config.json"

    -- Save config to file
    function m:SaveConfig()
        pcall(function()
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local G = getgenv and getgenv() or _G
            local payload = {
                autoBuySeedEnabled = G.AUTO_BUY_SEED_ENABLED or false,
                autoBuyEggEnabled = G.AUTO_BUY_EGG_ENABLED or false,
                autoBuyGearEnabled = G.AUTO_BUY_GEAR_ENABLED or false,
                seedSelected = G.SEED_SELECTED or {},
                eggSelected = G.EGG_SELECTED or {},
                gearSelected = G.GEAR_SELECTED or {},
                _ts = os.time()
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
        end)
    end

    -- Load config from file
    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            return false
        end

        local success = pcall(function()
            local text = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(text)
            local G = getgenv and getgenv() or _G

            if data.autoBuySeedEnabled ~= nil then
                G.AUTO_BUY_SEED_ENABLED = data.autoBuySeedEnabled
            end
            if data.autoBuyEggEnabled ~= nil then
                G.AUTO_BUY_EGG_ENABLED = data.autoBuyEggEnabled
            end
            if data.autoBuyGearEnabled ~= nil then
                G.AUTO_BUY_GEAR_ENABLED = data.autoBuyGearEnabled
            end
            if type(data.seedSelected) == "table" then
                G.SEED_SELECTED = data.seedSelected
            end
            if type(data.eggSelected) == "table" then
                G.EGG_SELECTED = data.eggSelected
            end
            if type(data.gearSelected) == "table" then
                G.GEAR_SELECTED = data.gearSelected
            end
        end)

        return success
    end

    ----------------------------------------------------------------
    -- Helper: Get AutoBuy module at runtime
    ----------------------------------------------------------------
    local function getAutoBuyModule()
        local G = getgenv and getgenv() or _G
        return G.AutoBuyModule or _G.AutoBuyModule
    end

    local function syncAutoBuy()
        local AutoBuy = getAutoBuyModule()
        if not AutoBuy then return end

        local G = getgenv and getgenv() or _G

        if type(AutoBuy.SyncFromGlobals) == "function" then
            pcall(AutoBuy.SyncFromGlobals)
        end

        -- Auto start/stop based on any toggle being on
        local anyOn = (G.AUTO_BUY_SEED_ENABLED == true) or 
                      (G.AUTO_BUY_EGG_ENABLED == true) or 
                      (G.AUTO_BUY_GEAR_ENABLED == true)

        if type(AutoBuy.Start) == "function" and type(AutoBuy.Stop) == "function" then
            if anyOn then
                AutoBuy.Start()
            else
                AutoBuy.Stop()
            end
        end
    end

    function m:Init(tab, window, pandoruyHub)
        Window = window
        PandoruyHub = pandoruyHub

        -- Set username-based save path
        local Players = game:GetService("Players")
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/shop_config.json"

        local G = getgenv and getgenv() or _G

        -- Initialize global state defaults
        G.AUTO_BUY_SEED_ENABLED = G.AUTO_BUY_SEED_ENABLED or false
        G.AUTO_BUY_EGG_ENABLED = G.AUTO_BUY_EGG_ENABLED or false
        G.AUTO_BUY_GEAR_ENABLED = G.AUTO_BUY_GEAR_ENABLED or false
        G.SEED_SELECTED = G.SEED_SELECTED or {}
        G.EGG_SELECTED = G.EGG_SELECTED or {}
        G.GEAR_SELECTED = G.GEAR_SELECTED or {}

        -- Load saved config (will override defaults)
        self:LoadConfig()

        -- Add sections
        self:AddAutoBuySeedSection(tab)
        self:AddAutoBuyEggSection(tab)
        self:AddAutoBuyGearSection(tab)

        -- Auto-resume: start if any toggle was enabled
        task.spawn(function()
            task.wait(3) -- Wait for UI and modules to fully load
            local anyOn = (G.AUTO_BUY_SEED_ENABLED == true) or 
                          (G.AUTO_BUY_EGG_ENABLED == true) or 
                          (G.AUTO_BUY_GEAR_ENABLED == true)
            if anyOn then
                print("[Shop] Auto-resuming...")
                syncAutoBuy()
            end
        end)

        -- print("[Shop UI] Initialized")
    end

    -- Get seed options from AutoBuy module
    function m:GetSeedOptions()
        local options = {}
        local AutoBuy = getAutoBuyModule()
        if AutoBuy and type(AutoBuy.GetLists) == "function" then
            local seeds, _, _ = AutoBuy.GetLists()
            if type(seeds) == "table" then
                for _, name in ipairs(seeds) do
                    table.insert(options, name)
                end
            end
        end
        return options
    end

    -- Get egg options from AutoBuy module
    function m:GetEggOptions()
        local options = {}
        local AutoBuy = getAutoBuyModule()
        if AutoBuy and type(AutoBuy.GetLists) == "function" then
            local _, eggs, _ = AutoBuy.GetLists()
            if type(eggs) == "table" then
                for _, name in ipairs(eggs) do
                    table.insert(options, name)
                end
            end
        end
        return options
    end

    -- Get gear options from AutoBuy module
    function m:GetGearOptions()
        local options = {}
        local AutoBuy = getAutoBuyModule()
        if AutoBuy and type(AutoBuy.GetLists) == "function" then
            local _, _, gear = AutoBuy.GetLists()
            if type(gear) == "table" then
                for _, name in ipairs(gear) do
                    table.insert(options, name)
                end
            end
        end
        return options
    end

    ----------------------------------------------------------------
    -- AUTO BUY SEED SECTION
    ----------------------------------------------------------------
    function m:AddAutoBuySeedSection(tab)
        local G = getgenv and getgenv() or _G
        local section = tab:AddSection("Auto Buy Seed")

        -- Dropdown for seed selection
        section:AddDropdown({
            Title = "Select Seeds to Buy",
            Content = "Select seeds to auto purchase",
            Options = self:GetSeedOptions(),
            Multi = true,
            Callback = function(selected)
                G.SEED_SELECTED = {}
                for _, seedName in ipairs(selected) do
                    G.SEED_SELECTED[seedName] = true
                end
                SEED_SELECTED = G.SEED_SELECTED
                syncAutoBuy()
            end
        })

        -- Toggle for auto buy seed
        local ShopUI = self
        section:AddToggle({
            Title = "Enable Auto Buy Seed",
            Default = G.AUTO_BUY_SEED_ENABLED or false,
            Callback = function(enabled)
                G.AUTO_BUY_SEED_ENABLED = enabled
                AUTO_BUY_SEED_ENABLED = enabled
                syncAutoBuy()
                ShopUI:SaveConfig()
            end
        })
    end

    ----------------------------------------------------------------
    -- AUTO BUY EGG SECTION
    ----------------------------------------------------------------
    function m:AddAutoBuyEggSection(tab)
        local G = getgenv and getgenv() or _G
        local section = tab:AddSection("Auto Buy Egg")

        -- Dropdown for egg selection
        section:AddDropdown({
            Title = "Select Eggs to Buy",
            Content = "Select eggs to auto purchase",
            Options = self:GetEggOptions(),
            Multi = true,
            Callback = function(selected)
                G.EGG_SELECTED = {}
                for _, eggName in ipairs(selected) do
                    G.EGG_SELECTED[eggName] = true
                end
                EGG_SELECTED = G.EGG_SELECTED
                syncAutoBuy()
            end
        })

        -- Toggle for auto buy egg
        local ShopUI = self
        section:AddToggle({
            Title = "Enable Auto Buy Egg",
            Default = G.AUTO_BUY_EGG_ENABLED or false,
            Callback = function(enabled)
                G.AUTO_BUY_EGG_ENABLED = enabled
                AUTO_BUY_EGG_ENABLED = enabled
                syncAutoBuy()
                ShopUI:SaveConfig()
            end
        })
    end

    ----------------------------------------------------------------
    -- AUTO BUY GEAR SECTION
    ----------------------------------------------------------------
    function m:AddAutoBuyGearSection(tab)
        local G = getgenv and getgenv() or _G
        local section = tab:AddSection("Auto Buy Gear")

        -- Dropdown for gear selection
        section:AddDropdown({
            Title = "Select Gear to Buy",
            Content = "Select gear to auto purchase",
            Options = self:GetGearOptions(),
            Multi = true,
            Callback = function(selected)
                G.GEAR_SELECTED = {}
                for _, gearName in ipairs(selected) do
                    G.GEAR_SELECTED[gearName] = true
                end
                GEAR_SELECTED = G.GEAR_SELECTED
                syncAutoBuy()
            end
        })

        -- Toggle for auto buy gear
        local ShopUI = self
        section:AddToggle({
            Title = "Enable Auto Buy Gear",
            Default = G.AUTO_BUY_GEAR_ENABLED or false,
            Callback = function(enabled)
                G.AUTO_BUY_GEAR_ENABLED = enabled
                AUTO_BUY_GEAR_ENABLED = enabled
                syncAutoBuy()
                ShopUI:SaveConfig()
            end
        })
    end

    return m

end

-- Module: module/autobuy.lua
EmbeddedModules["module/autobuy.lua"] = function()
    -- autobuy.lua
    -- Auto buy Seed, Egg, Gear dari shop
    -- Adapted from auto_kg/module/autobuy.lua

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")

    -- Safe require with fallback
    local DataService, SeedShopData, PetEggData, GearShopDataRaw

    local ok1, res1 = pcall(function()
        return require(ReplicatedStorage.Modules.DataService)
    end)
    DataService = ok1 and res1 or nil

    local ok2, res2 = pcall(function()
        return require(ReplicatedStorage.Data.SeedShopData)
    end)
    SeedShopData = ok2 and res2 or {}

    local ok3, res3 = pcall(function()
        return require(ReplicatedStorage.Data.PetEggData)
    end)
    PetEggData = ok3 and res3 or {}

    local ok4, res4 = pcall(function()
        return require(ReplicatedStorage.Data.GearShopData)
    end)
    GearShopDataRaw = ok4 and res4 or {}

    local ge = ReplicatedStorage:FindFirstChild("GameEvents")
           or ReplicatedStorage:FindFirstChild("gameEvents")

    local BuySeedStock = ge and ge:FindFirstChild("BuySeedStock")
    local BuyPetEgg = ge and ge:FindFirstChild("BuyPetEgg")
    local BuyGearStock = ge and ge:FindFirstChild("BuyGearStock")

    local GearShopData = (type(GearShopDataRaw) == "table" and GearShopDataRaw.Gear) or GearShopDataRaw or {}

    local M = {}

    ----------------------------------------------------------------
    -- DEBUG
    ----------------------------------------------------------------
    local DEBUG = false

    local function dprint(...)
        if DEBUG then print("[AutoBuy]", ...) end
    end

    local function dwarn(...)
        if DEBUG then warn("[AutoBuy]", ...) end
    end

    ----------------------------------------------------------------
    -- GLOBAL STATE
    ----------------------------------------------------------------
    AUTO_BUY_SEED_ENABLED = (AUTO_BUY_SEED_ENABLED == true)
    AUTO_BUY_EGG_ENABLED = (AUTO_BUY_EGG_ENABLED == true)
    AUTO_BUY_GEAR_ENABLED = (AUTO_BUY_GEAR_ENABLED == true)

    SEED_SELECTED = SEED_SELECTED or {}
    EGG_SELECTED = EGG_SELECTED or {}
    GEAR_SELECTED = GEAR_SELECTED or {}

    ----------------------------------------------------------------
    -- INFO TABLES
    ----------------------------------------------------------------
    local SEED_INFO = {}
    local EGG_INFO = {}
    local GEAR_INFO = {}

    local SeedItems, EggItems, GearItems = nil, nil, nil
    local EGG_INDEX_BY_NAME = nil

    local STATE = STATE or {}

    ----------------------------------------------------------------
    -- BUILD LISTS
    ----------------------------------------------------------------
    local function sortByLayoutOrder(dataTbl, names)
        table.sort(names, function(a, b)
            local ra = dataTbl[a]
            local rb = dataTbl[b]
            local ia = (type(ra) == "table" and (ra.LayoutOrder or 0)) or 0
            local ib = (type(rb) == "table" and (rb.LayoutOrder or 0)) or 0
            if ia == ib then return tostring(a) < tostring(b) end
            return ia < ib
        end)
    end

    local function buildSeedList()
        table.clear(SEED_INFO)
        local names = {}

        for name, info in pairs(SeedShopData) do
            if type(info) == "table" and info.DisplayInShop ~= false then
                local currencyType = info.SpecialCurrencyType or "Sheckles"
                local price = info.Price or info.FallbackPrice or 0
                local rebirthReq = info.RebirthRequirement or 0

                SEED_INFO[name] = {
                    price = price,
                    currency = currencyType,
                    rebirth = rebirthReq,
                }
                names[#names + 1] = name
            end
        end

        sortByLayoutOrder(SeedShopData, names)
        dprint("buildSeedList:", #names)
        return names
    end

    local function buildEggList()
        table.clear(EGG_INFO)
        EGG_INDEX_BY_NAME = {}

        local tmp = {}
        for name, info in pairs(PetEggData) do
            if type(info) == "table" then
                tmp[#tmp + 1] = { name = name, order = info.LayoutOrder or 0 }
            end
        end

        table.sort(tmp, function(a, b)
            if a.order == b.order then return a.name < b.name end
            return a.order < b.order
        end)

        local names = {}
        for idx, rec in ipairs(tmp) do
            local info = PetEggData[rec.name]
            local price = info.Price or info.FallbackPrice or 0
            local currency = info.SpecialCurrencyType or "Sheckles"
            local rebirthReq = info.RebirthRequirement or 0

            names[idx] = rec.name
            EGG_INDEX_BY_NAME[rec.name] = idx

            EGG_INFO[rec.name] = {
                price = price,
                currency = currency,
                rebirth = rebirthReq,
                index = idx,
            }
        end

        dprint("buildEggList:", #names)
        return names
    end

    local function buildGearList()
        table.clear(GEAR_INFO)
        local names = {}

        for name, info in pairs(GearShopData) do
            if type(info) == "table" and info.DisplayInShop ~= false then
                local currencyType = info.SpecialCurrencyType or "Sheckles"
                local price = info.Price or info.FallbackPrice or 0
                local rebirthReq = info.RebirthRequirement or 0

                GEAR_INFO[name] = {
                    price = price,
                    currency = currencyType,
                    rebirth = rebirthReq,
                }
                names[#names + 1] = name
            end
        end

        sortByLayoutOrder(GearShopData, names)
        dprint("buildGearList:", #names)
        return names
    end

    local function ensureListsBuilt()
        if not SeedItems then
            local ok, res = pcall(buildSeedList)
            SeedItems = (ok and type(res) == "table") and res or {}
        end
        if not EggItems then
            local ok, res = pcall(buildEggList)
            EggItems = (ok and type(res) == "table") and res or {}
        end
        if not GearItems then
            local ok, res = pcall(buildGearList)
            GearItems = (ok and type(res) == "table") and res or {}
        end
    end

    function M.GetLists()
        ensureListsBuilt()
        return SeedItems, EggItems, GearItems
    end

    ----------------------------------------------------------------
    -- SHOP INFO
    ----------------------------------------------------------------
    local SHOP_INFO = {
        seed = {
            infoTable = SEED_INFO,
            stockPath = "SeedStocks",
            buyFn = function(name, qty)
                if not BuySeedStock then return end
                dprint("BUY seed", name, "qty", qty)
                for i = 1, qty do
                    if not STATE.autoBuySeeds then break end
                    BuySeedStock:FireServer("Shop", name)
                    task.wait(0.15)
                end
            end,
        },
        egg = {
            infoTable = EGG_INFO,
            stockPath = "PetEggStock",
            buyFn = function(name, qty)
                if not BuyPetEgg then return end
                if not EGG_INDEX_BY_NAME then buildEggList() end
                local idx = EGG_INDEX_BY_NAME and EGG_INDEX_BY_NAME[name]
                if not idx then return end

                dprint("BUY egg", name, "idx", idx, "qty", qty)
                for i = 1, qty do
                    if not STATE.autoBuyEgg then break end
                    BuyPetEgg:FireServer(idx)
                    task.wait(0.15)
                end
            end,
        },
        gear = {
            infoTable = GEAR_INFO,
            stockPath = "GearStock",
            buyFn = function(name, qty)
                if not BuyGearStock then return end
                dprint("BUY gear", name, "qty", qty)
                for i = 1, qty do
                    if not STATE.autoBuyGear then break end
                    BuyGearStock:FireServer(name)
                    task.wait(0.15)
                end
            end,
        },
    }

    function M.GetShopInfo()
        ensureListsBuilt()
        return SHOP_INFO
    end

    function M.SyncFromGlobals()
        ensureListsBuilt()

        STATE.autoBuySeeds = (AUTO_BUY_SEED_ENABLED == true)
        STATE.autoBuyEgg = (AUTO_BUY_EGG_ENABLED == true)
        STATE.autoBuyGear = (AUTO_BUY_GEAR_ENABLED == true)

        SHOP_INFO.seed.selected = SEED_SELECTED or {}
        SHOP_INFO.egg.selected = EGG_SELECTED or {}
        SHOP_INFO.gear.selected = GEAR_SELECTED or {}

        dprint("SyncFromGlobals:", STATE.autoBuySeeds, STATE.autoBuyEgg, STATE.autoBuyGear)
    end

    ----------------------------------------------------------------
    -- HELPERS
    ----------------------------------------------------------------
    local function getStockAmount(entry)
        if entry == nil then return 0 end
        if type(entry) == "number" then return entry end
        if type(entry) == "table" then return entry.Stock or 0 end
        return 0
    end

    local function getSheckles(profile)
        if not profile then return 0 end
        if type(profile.Sheckles) == "number" then return profile.Sheckles end
        if type(profile.CurrencyData) == "table" and type(profile.CurrencyData.Sheckles) == "number" then
            return profile.CurrencyData.Sheckles
        end
        if type(profile.Stats) == "table" and type(profile.Stats.Sheckles) == "number" then
            return profile.Stats.Sheckles
        end
        return 0
    end

    local function getGardenCoins(profile)
        if not profile then return 0 end
        if type(profile.GardenCoins) == "number" then return profile.GardenCoins end
        if type(profile.CurrencyData) == "table" and type(profile.CurrencyData.GardenCoins) == "number" then
            return profile.CurrencyData.GardenCoins
        end
        if type(profile.Stats) == "table" and type(profile.Stats.GardenCoins) == "number" then
            return profile.Stats.GardenCoins
        end
        return 0
    end

    ----------------------------------------------------------------
    -- TICK
    ----------------------------------------------------------------
    function M.Tick()
        M.SyncFromGlobals()

        if not DataService then return end
        local profile = DataService:GetData()
        if not profile then return end

        local sheckles = getSheckles(profile)
        local gardenCoins = getGardenCoins(profile)

        for catKey, cfg in pairs(SHOP_INFO) do
            local categoryOn = false
            if catKey == "seed" then categoryOn = STATE.autoBuySeeds
            elseif catKey == "egg" then categoryOn = STATE.autoBuyEgg
            elseif catKey == "gear" then categoryOn = STATE.autoBuyGear end

            if not categoryOn then continue end

            ensureListsBuilt()

            if catKey == "egg" then
                local stockRoot = profile[cfg.stockPath]
                local stocks = stockRoot and stockRoot.Stocks
                if typeof(stocks) ~= "table" then continue end

                local selected = cfg.selected or {}
                local hasSelected = false
                for _, on in pairs(selected) do if on then hasSelected = true break end end

                for idx, eggRec in ipairs(stocks) do
                    if type(eggRec) == "table" then
                        local name = eggRec.EggName
                        local stockCount = tonumber(eggRec.Stock) or 0
                        local priceType = eggRec.PriceType

                        local allowed = true
                        if stockCount <= 0 then allowed = false end
                        if allowed and priceType == "Robux" then allowed = false end
                        if allowed and hasSelected and not selected[name] then allowed = false end

                        if allowed then
                            for i = 1, stockCount do
                                if not STATE.autoBuyEgg then break end
                                BuyPetEgg:FireServer(idx)
                                task.wait(0.15)
                            end
                        end
                    end
                end
            else
                local infoTable = cfg.infoTable
                local stockRoot = profile[cfg.stockPath]
                local rawStocks

                if catKey == "seed" then
                    rawStocks = stockRoot and stockRoot.Shop and stockRoot.Shop.Stocks
                else
                    rawStocks = stockRoot and stockRoot.Stocks
                end

                if typeof(rawStocks) ~= "table" then continue end

                local stockTable = {}
                for key, entry in pairs(rawStocks) do
                    stockTable[key] = getStockAmount(entry)
                end

                local selected = cfg.selected or {}
                local hasSelected = false
                for _, on in pairs(selected) do if on then hasSelected = true break end end

                local function processItem(name)
                    local info = infoTable[name]
                    if not info then return end

                    local currency = info.currency or "Sheckles"
                    local price = info.price or 0
                    if price <= 0 then return end

                    local balance = (currency == "GardenCoins") and gardenCoins or sheckles
                    local stockCount = stockTable[name] or 0
                    if stockCount <= 0 then return end
                    if balance < price then return end

                    cfg.buyFn(name, stockCount)
                end

                if hasSelected then
                    for name, on in pairs(selected) do
                        if on then processItem(name) end
                    end
                else
                    for name, _ in pairs(infoTable) do
                        processItem(name)
                    end
                end
            end
        end
    end

    ----------------------------------------------------------------
    -- LOOP RUNNER
    ----------------------------------------------------------------
    local RUNNING = false
    local STOP_TOKEN = 0

    function M.Start()
        if RUNNING then return end
        RUNNING = true
        STOP_TOKEN = STOP_TOKEN + 1
        local myToken = STOP_TOKEN

        dprint("Start() loop running")

        task.spawn(function()
            while RUNNING and myToken == STOP_TOKEN do
                local ok, err = pcall(M.Tick)
                if not ok then dwarn("Tick error:", err) end
                task.wait(5)
            end
        end)
    end

    function M.Stop()
        RUNNING = false
        STOP_TOKEN = STOP_TOKEN + 1
        dprint("Stop() loop stopped")
    end

    function M.IsRunning()
        return RUNNING
    end

    _G.AutoBuyModule = M
    return M

end

