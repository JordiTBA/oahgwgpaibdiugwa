        local elephantCount = 0
        if Elephant2 and Elephant2.V2_LevelingPetTeamPets then
            for _ in pairs(Elephant2.V2_LevelingPetTeamPets) do
                levelingCount = levelingCount + 1
            end
        end
        if Elephant2 and Elephant2.V2_ElephantPetTeamPets then
            for _ in pairs(Elephant2.V2_ElephantPetTeamPets) do
                elephantCount = elephantCount + 1
            end
        end
        table.insert(lines, "Leveling Team: " .. tostring(levelingCount) .. " pets")
        table.insert(lines, "Elephant Team: " .. tostring(elephantCount) .. " pets")

        -- Target Types
        local targetTypes = {}
        if Elephant2 and Elephant2.V2_SelectedPetTypes then
            for petType, _ in pairs(Elephant2.V2_SelectedPetTypes) do
                table.insert(targetTypes, petType)
            end
            table.sort(targetTypes)
        end
        local targetTypesStr = #targetTypes > 0 and table.concat(targetTypes, ", ") or "None"
        table.insert(lines, "Target Types: " .. targetTypesStr)

        -- Pet counts
        local petsReadyCount = 0
        local petsAtMaxKG = 0
        local targetWeight = Elephant2 and Elephant2.V2_TargetWeight or 5.5

        if Pet and Pet.GetAllPetsInInventory and Elephant2 then
            local allPets = Pet:GetAllPetsInInventory()
            local selectedTypes = Elephant2.V2_SelectedPetTypes or {}

            for guid, petData in pairs(allPets or {}) do
                local petType = Pet:GetPetType(petData)
                local isFavorited = Pet.IsPetFavorited and Pet:IsPetFavorited(petData) or false

                if selectedTypes[petType] == true and not isFavorited then
                    local weight = Pet:GetPetWeight(petData) or 0
                    if weight >= targetWeight then
                        petsAtMaxKG = petsAtMaxKG + 1
                    else
                        petsReadyCount = petsReadyCount + 1
                    end
                end
            end
        end
        table.insert(lines, "Target Pets Ready: " .. tostring(petsReadyCount) .. " pets")
        table.insert(lines, "Pets at Max KG: " .. tostring(petsAtMaxKG) .. " pets")
        table.insert(lines, "")

        -- Settings
        local maxLevelingPets = Elephant2 and Elephant2.V2_MaxLevelingPets or 3
        local maxElephantPets = Elephant2 and Elephant2.V2_MaxElephantPets or 3
        table.insert(lines, "Max Leveling Target: " .. tostring(maxLevelingPets) .. " pets")
        table.insert(lines, "Max Elephant Target: " .. tostring(maxElephantPets) .. " pets")
        local levelBefore = Elephant2 and Elephant2.V2_LevelBeforeElephant or 50
        table.insert(lines, "Level Before Elephant: " .. tostring(levelBefore))
        table.insert(lines, "Target Weight: " .. tostring(targetWeight) .. " KG")
        table.insert(lines, "")

        -- Ready status
        local hasLevelingPets = levelingCount > 0
        local hasElephantPets = elephantCount > 0
        local hasTargets = #targetTypes > 0
        if hasLevelingPets and hasElephantPets and hasTargets then
            table.insert(lines, "Ready: Settings configured")
        else
            local missing = {}
            if not hasLevelingPets then table.insert(missing, "leveling pets") end
            if not hasElephantPets then table.insert(missing, "elephant pets") end
            if not hasTargets then table.insert(missing, "target types") end
            table.insert(lines, "Ready: Select " .. table.concat(missing, " and "))
        end

        return table.concat(lines, "\n")
    end

    ----------------------------------------------
    -- STATUS LOOP
    ----------------------------------------------
    function m:UpdateStatus()
        if m.OriginalStatusParagraph and m.OriginalStatusParagraph.SetContent then
            m.OriginalStatusParagraph:SetContent(self:GetOriginalStatusText())
        end

        if m.V1StatusParagraph and m.V1StatusParagraph.SetContent then
            m.V1StatusParagraph:SetContent(self:GetV1StatusText())
        end

        if m.V2StatusParagraph and m.V2StatusParagraph.SetContent then
            m.V2StatusParagraph:SetContent(self:GetV2StatusText())
        end
    end

    m.StatusLoopRunning = false

    function m:StartStatusLoop()
        if m.StatusLoopRunning then return end
        m.StatusLoopRunning = true

        task.spawn(function()
            while m.StatusLoopRunning do
                pcall(function()
                    self:UpdateStatus()
                end)
                task.wait(5)
            end
        end)
    end

    function m:StopStatusLoop()
        m.StatusLoopRunning = false
    end

    return m

end

