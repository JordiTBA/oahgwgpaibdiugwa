        self:LoadFromFile()

        -- Load last selected team
        self:LoadLastTeam()
    end

    -- Save last selected team
    function m:SaveLastTeam(teamName)
        local success, err = pcall(function()
            -- Create folders if not exists
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            -- Write team name to file
            writefile(LAST_TEAM_FILE, teamName or "")

            -- print("[PetTeam] Saved last team:", teamName)
        end)

        if not success then
            -- warn("[PetTeam] Failed to save last team:", err)
        end

        return success
    end

    -- Load last selected team
    function m:LoadLastTeam()
        local success, err = pcall(function()
            -- Check if file exists
            if isfile(LAST_TEAM_FILE) then
                -- Read from file
                local teamName = readfile(LAST_TEAM_FILE)

                -- Store in global
                G.LAST_SELECTED_TEAM = teamName

                if teamName and teamName ~= "" then
                    -- print("[PetTeam] Loaded last team:", teamName)
                end
            else
                G.LAST_SELECTED_TEAM = nil
                -- print("[PetTeam] No last team saved")
            end
        end)

        if not success then
            -- warn("[PetTeam] Failed to load last team:", err)
            G.LAST_SELECTED_TEAM = nil
        end

        return success
    end

    -- Get last selected team
    function m:GetLastTeam()
        return G.LAST_SELECTED_TEAM
    end

    -- Save teams to file
    function m:SaveToFile()
        local success, err = pcall(function()
            -- Create folders if not exists
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            -- Convert teams to JSON
            local json = HttpService:JSONEncode(G.PET_TEAMS)

            -- Write to file
            writefile(TEAMS_FILE, json)

            -- print("[PetTeam] Saved", self:GetTeamCount(), "teams to file")
        end)

        if not success then
            -- warn("[PetTeam] Failed to save to file:", err)
        end

        return success
    end

    -- Load teams from file
    function m:LoadFromFile()
        local success, err = pcall(function()
            -- Check if file exists
            if isfile(TEAMS_FILE) then
                -- Read from file
                local json = readfile(TEAMS_FILE)

                -- Decode JSON
                local teams = HttpService:JSONDecode(json)

                -- Load into memory
                G.PET_TEAMS = teams or {}

                local count = self:GetTeamCount()
                -- print("[PetTeam] Loaded", count, "teams from file")

                -- List loaded teams
                if count > 0 then
                    -- print("[PetTeam] Teams loaded:")
                    for teamName, team in pairs(G.PET_TEAMS) do
                        -- print("[PetTeam]   -", teamName, "(" .. team.count .. " pets)")
                    end
                end
            else
                -- print("[PetTeam] No saved teams file found, starting fresh")
            end
        end)

        if not success then
            -- warn("[PetTeam] Failed to load from file:", err)
            G.PET_TEAMS = {}
        end

        return success
    end

    -- Get team count
    function m:GetTeamCount()
        local count = 0
        for _ in pairs(G.PET_TEAMS) do
            count = count + 1
        end
        return count
    end

    -- Save pet team
    function m:SaveTeam(teamName, petGuids)
        if not teamName or teamName == "" then
            -- warn("[PetTeam] Invalid team name")
            return false
        end

        if not petGuids or type(petGuids) ~= "table" then
            -- warn("[PetTeam] Invalid pet list")
            return false
        end

        G.PET_TEAMS[teamName] = {
            name = teamName,
            pets = petGuids,
            created = os.time(),
            count = #petGuids
        }

        -- print("[PetTeam] Saved team:", teamName, "with", #petGuids, "pets")
        -- print("[PetTeam] Pet GUIDs:", table.concat(petGuids, ", "))

        -- Auto-save to file
        self:SaveToFile()

        return true
    end

    -- Get team by name
    function m:GetTeam(teamName)
        return G.PET_TEAMS[teamName]
    end

    -- Get all team names
    function m:GetAllTeamNames()
        local names = {}
        for teamName, _ in pairs(G.PET_TEAMS) do
            table.insert(names, teamName)
        end
        table.sort(names)
        -- print("[PetTeam] GetAllTeamNames returning:", #names, "teams")
        return names
    end

    -- Delete team
    function m:DeleteTeam(teamName)
        if G.PET_TEAMS[teamName] then
            G.PET_TEAMS[teamName] = nil
            -- print("[PetTeam] Deleted team:", teamName)

            -- Auto-save to file
            self:SaveToFile()

            return true
        end
        -- warn("[PetTeam] Team not found for deletion:", teamName)
        return false
    end

    -- Get team details for display
    function m:GetTeamDetails(teamName)
        local team = self:GetTeam(teamName)
        if not team then
            -- warn("[PetTeam] Team not found:", teamName)
            return nil
        end

        local details = {
            name = team.name,
            count = team.count,
            pets = {}
        }

        -- print("[PetTeam] Getting details for team:", teamName, "with", #team.pets, "pets")

        -- Get pet info for each GUID
        for _, petGuid in ipairs(team.pets) do
            local petData = Pet:GetPetData(petGuid)
            if petData then
                local display = Pet:GetPetDisplayName(petData)
                table.insert(details.pets, {
                    guid = petGuid,
                    type = Pet:GetPetType(petData),
                    weight = Pet:GetPetWeight(petData),
                    display = display
                })
                -- print("[PetTeam]   - Pet:", display)
            else
                -- warn("[PetTeam]   - Pet data not found for GUID:", petGuid)
            end
        end

        return details
    end

    -- Load team (equip all pets in team)
    function m:LoadTeam(teamName)
        local team = self:GetTeam(teamName)
        if not team then
            -- warn("[PetTeam] Team not found:", teamName)
            return false
        end

        -- print("[PetTeam] Loading team:", teamName, "with", #team.pets, "pets")

        -- Unequip all active pets first
        local activePets = Pet:GetActivePets()
        -- print("[PetTeam] Unequipping", #activePets, "active pets")

        for _, petGuid in ipairs(activePets) do
            Pet:UnequipPet(petGuid)
            task.wait(0.1)
        end

        -- Wait for unequip to complete
        task.wait(0.5)

        -- Equip team pets
        -- print("[PetTeam] Equipping", #team.pets, "team pets")
        for _, petGuid in ipairs(team.pets) do
            -- print("[PetTeam]   Equipping pet:", petGuid)
            Pet:EquipPet(petGuid)
            task.wait(0.1)
        end

        -- print("[PetTeam] Team loaded successfully")
        return true
    end

    -- Save current active pets as team
    function m:SaveCurrentTeam(teamName)
        -- print("[PetTeam] SaveCurrentTeam called with name:", teamName)

        local activePets = Pet:GetActivePets()

        if not activePets then
            -- warn("[PetTeam] GetActivePets returned nil")
            return false
        end

        -- print("[PetTeam] Active pets type:", type(activePets))
        -- print("[PetTeam] Active pets count:", #activePets)

        -- activePets is already an array of GUIDs
        local petGuids = activePets

        if #petGuids == 0 then
            -- warn("[PetTeam] No active pets to save")
            return false
        end

        -- print("[PetTeam] Saving", #petGuids, "pets to team:", teamName)
        return self:SaveTeam(teamName, petGuids)
    end

    return m

end

