    -- Generic gift section builder (4 rows: suffix "", "B", "C", "D")
    function m:BuildGiftSection(tab, suffix, title)
        local section = tab:AddSection(title)
        local cfg = Inventory.GIFT_CFG

        -- Derive config keys from suffix
        local keyEnabled   = "enabled"   .. suffix
        local keyTargets   = "targets"   .. suffix
        local keyMinKG     = "minKG"     .. suffix
        local keyMinAge    = "minAge"    .. suffix
        local keyPetType   = "petType"   .. suffix
        local keyMut       = "mut"       .. suffix
        local keyAutoUnfav = "autoUnfav" .. suffix

        -- Tag for unique element titles (PandoruyHub keys by Title)
        local tag = " [" .. title .. "]"

        -- Ensure defaults
        if cfg[keyEnabled]   == nil then cfg[keyEnabled]   = false end
        if cfg[keyTargets]   == nil then cfg[keyTargets]   = {} end
        if cfg[keyMinKG]     == nil then cfg[keyMinKG]     = 0 end
        if cfg[keyMinAge]    == nil then cfg[keyMinAge]    = 0 end
        if cfg[keyPetType]   == nil then cfg[keyPetType]   = {} end
        if cfg[keyMut]       == nil then cfg[keyMut]       = {} end
        if cfg[keyAutoUnfav] == nil then cfg[keyAutoUnfav] = false end

        -- Build initial selected target names from saved config
        local targetInitial = {}
        if type(cfg[keyTargets]) == "table" then
            for k, v in pairs(cfg[keyTargets]) do
                if type(v) == "table" and v.name then
                    table.insert(targetInitial, v.name)
                end
            end
        end

        -- Target dropdown (multi-select, auto-refresh on open)
        section:AddDropdown({
            Title = "Target" .. tag,
            Content = "Choose gift recipient",
            Options = self:GetPlayerOptions(targetInitial),
            Multi = true,
            Default = targetInitial,
            OnOpen = function()
                local currentTargets = {}
                if type(cfg[keyTargets]) == "table" then
                    for k, v in pairs(cfg[keyTargets]) do
                        if type(v) == "table" and v.name then
                            table.insert(currentTargets, v.name)
                        end
                    end
                end
                return self:GetPlayerOptions(currentTargets)
            end,
            Callback = function(selected)
                local oldTargets = cfg[keyTargets] or {}
                cfg[keyTargets] = {}
                for _, playerName in ipairs(selected) do
                    -- Try to find player object first
                    local found = false
                    for _, player in pairs(Core.Players:GetPlayers()) do
                        if player.Name == playerName then
                            cfg[keyTargets][playerName] = {
                                userId = player.UserId,
                                name = playerName,
                            }
                            found = true
                            break
                        end
                    end

                    -- Fallback: Retrieve from old targets to preserve UserId
                    if not found and oldTargets[playerName] then
                        cfg[keyTargets][playerName] = oldTargets[playerName]
                        found = true
                    end

                    -- Fallback: just name
                    if not found then
                         cfg[keyTargets][playerName] = {
                            userId = nil,
                            name = playerName,
                         }
                    end
                end
                Inventory:SaveConfig()
            end
        })

        -- Pet Type dropdown (multi-select)
        local petTypeInitial = {}
        if type(cfg[keyPetType]) == "table" then
            for k, v in pairs(cfg[keyPetType]) do
                if v then
                    table.insert(petTypeInitial, tostring(k))
                end
            end
        end

        section:AddDropdown({
            Title = "Pet Types" .. tag,
            Content = "Filter by pet type",
            Options = self:GetPetTypeOptions(),
            Multi = true,
            Default = petTypeInitial,
            Callback = function(selected)
                cfg[keyPetType] = {}
                for _, petName in ipairs(selected) do
                    cfg[keyPetType][petName] = true
                end
                Inventory:SaveConfig()
            end
        })

        -- Mutation Filter dropdown (MULTI-select)
        local mutInitial = {}
        if type(cfg[keyMut]) == "table" then
            for k, v in pairs(cfg[keyMut]) do
                if v then
                    table.insert(mutInitial, tostring(k))
                end
            end
        end

        section:AddDropdown({
            Title = "Mutation" .. tag,
            Content = "Empty = no mutation, pick = must have",
            Options = self:GetMutationOptions(),
            Multi = true,
            Default = mutInitial,
            Callback = function(selected)
                cfg[keyMut] = {}
                for _, mutName in ipairs(selected) do
                    cfg[keyMut][mutName] = true
                end
                Inventory:SaveConfig()
            end
        })

        -- Age input
        section:AddInput({
            Title = "Min Age" .. tag,
            Content = "0 = newborn only, + = at least, - = at most",
            Default = tostring(cfg[keyMinAge] or 0),
            Callback = function(value)
                local text = tostring(value or ""):gsub("%s+", "")
                if text == "" or text == "-" then return end
                local num = tonumber(text)
                if num == nil then return end
                cfg[keyMinAge] = num
                Inventory:SaveConfig()
            end
        })

        -- KG input
        section:AddInput({
            Title = "Min KG" .. tag,
            Content = "0 = off, + = at least, - = at most",
            Default = tostring(cfg[keyMinKG] or 0),
            Callback = function(value)
                local text = tostring(value or ""):gsub("%s+", "")
                if text == "" or text == "-" then return end
                local num = tonumber(text)
                if num == nil then return end
                cfg[keyMinKG] = num
                Inventory:SaveConfig()
            end
        })

        -- Auto Unfavorite toggle
        section:AddToggle({
            Title = "Auto Unfavorite" .. tag,
            Content = "Remove favorite before gifting",
            Default = cfg[keyAutoUnfav] == true,
            Callback = function(value)
                cfg[keyAutoUnfav] = value and true or false
                Inventory:SaveConfig()
            end
        })

        -- Enable toggle
        section:AddToggle({
            Title = title .. " Enabled",
            Content = "Turn on " .. title,
            Default = cfg[keyEnabled] == true,
            Callback = function(value)
                cfg[keyEnabled] = value and true or false
