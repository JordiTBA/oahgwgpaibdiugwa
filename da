    ----------------------------------------------
    -- STATUS TEXT BUILDERS
    ----------------------------------------------
    function m:GetOriginalStatusText()
        local lines = {}

        -- Auto Status
        local isRunning = Elephant and Elephant.IsRunning or false
        table.insert(lines, "Auto Status: " .. (isRunning and "RUNNING" or "STOPPED"))
        table.insert(lines, "")

        -- Team info (pet count from SelectedTeamPets)
        local teamPetCount = 0
        if Elephant and Elephant.SelectedTeamPets then
            for _ in pairs(Elephant.SelectedTeamPets) do
                teamPetCount = teamPetCount + 1
            end
        end
        table.insert(lines, "Elephant Team: " .. tostring(teamPetCount) .. " pets")

        -- Target Types
        local targetTypes = {}
        if Elephant and Elephant.SelectedPetTypes then
            for petType, _ in pairs(Elephant.SelectedPetTypes) do
                table.insert(targetTypes, petType)
            end
            table.sort(targetTypes)
        end
        local targetTypesStr = #targetTypes > 0 and table.concat(targetTypes, ", ") or "None"
        table.insert(lines, "Target Types: " .. targetTypesStr)

        -- Pet counts
        local petsReadyCount = 0
        local petsAtMaxKG = 0
        local targetWeight = Elephant and Elephant.TargetWeight or 5.5

        if Pet and Pet.GetAllPetsInInventory and Elephant then
            local allPets = Pet:GetAllPetsInInventory()
            local selectedTypes = Elephant.SelectedPetTypes or {}

            for guid, petData in pairs(allPets or {}) do
                local petType = Pet:GetPetType(petData)
                local isFavorited = Pet.IsPetFavorited and Pet:IsPetFavorited(petData) or false

                if selectedTypes[petType] == true and not isFavorited then
                    local weight = Pet:GetPetWeight(petData) or 0
                    if weight >= targetWeight then
                        petsAtMaxKG = petsAtMaxKG + 1
                    else
                        petsReadyCount = petsReadyCount + 1
                    end
                end
            end
        end
        table.insert(lines, "Target Pets Ready: " .. tostring(petsReadyCount) .. " pets")
        table.insert(lines, "Pets at Max KG: " .. tostring(petsAtMaxKG) .. " pets")

        -- Max in Garden
        local maxPets = Elephant and Elephant.MaxPetsInGarden or 3
        table.insert(lines, "Max in Garden: " .. tostring(maxPets) .. " pets")
        table.insert(lines, "")

        -- Threshold Settings
        table.insert(lines, "Threshold Settings:")
        local minAge = Elephant and Elephant.MinAgeToEquip or 0
        table.insert(lines, "- Min Age: " .. tostring(minAge))
        local unequipAge = Elephant and Elephant.UnequipAtAge or 0
        local maxAgeStr = unequipAge == 0 and "Unlimited" or tostring(unequipAge)
        table.insert(lines, "- Max Age: " .. maxAgeStr)
        table.insert(lines, "- Target Weight: " .. tostring(targetWeight) .. " KG")
        table.insert(lines, "")

        -- Ready status
        local hasPets = teamPetCount > 0
        local hasTargets = #targetTypes > 0
        if hasPets and hasTargets then
            table.insert(lines, "Ready: Settings configured")
        else
            local missing = {}
            if not hasPets then table.insert(missing, "pets") end
            if not hasTargets then table.insert(missing, "target types") end
            table.insert(lines, "Ready: Select " .. table.concat(missing, " and "))
        end

        return table.concat(lines, "\n")
    end

