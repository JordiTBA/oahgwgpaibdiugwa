        -- Function to update status display
        local function updateTradeStatus()
            if tradeCounterParagraph and tradeCounterParagraph.SetContent then
                local status = "Completed: " .. tostring(at.tradesCompleted or 0) .. " / " .. tostring(at.tradeCount or 1)
                if at.enabled then
                    status = status .. "\nStatus: RUNNING"
                else
                    status = status .. "\nStatus: STOPPED"
                end
                tradeCounterParagraph:SetContent(status)
            end
