                local allPets = Pet:GetAllPetsInInventory()
                local selectedTypes = Mutation.SelectedPetTypes or {}

                for guid, petData in pairs(allPets or {}) do
                    local petType = Pet:GetPetType(petData)
                    local isFavorited = Pet.IsPetFavorited and Pet:IsPetFavorited(petData) or false

                    -- Check if pet type is selected AND not favorited
                    if selectedTypes[petType] == true and not isFavorited then
                        local mutation = Mutation:GetPetMutation(petData)

                        if not mutation or mutation == "" then
                            -- No mutation = waiting
                            petsWaiting = petsWaiting + 1
                        elseif targetMutations[mutation] then
                            -- Has target mutation (done!)
                            mutationCounts[mutation] = (mutationCounts[mutation] or 0) + 1
                        else
                            -- Has unwanted mutation = also waiting (will be cleansed)
                            petsWaiting = petsWaiting + 1
                        end
                    end
                end
            end

            table.insert(lines, "Pet Statistics:")
            table.insert(lines, "- Pets Ready to Mutation: " .. tostring(petsWaiting) .. " pets")

            -- Show count per target mutation type
            for mutationType, count in pairs(mutationCounts) do
                table.insert(lines, "- Already " .. mutationType .. ": " .. tostring(count) .. " pets")
            end
            table.insert(lines, "")

            -- Max Pets
            local maxPets = Mutation and Mutation.MaxPetsInGarden or 9
            table.insert(lines, "Max in Garden: " .. tostring(maxPets) .. " pets")
            table.insert(lines, "")

            -- Ready status
            local hasTeam = teamPetCount > 0
            local hasTargets = #targetTypes > 0
            local hasMutations = #mutationsToKeep > 0
            if hasTeam and hasTargets and hasMutations then
                table.insert(lines, "Status: Ready to run")
            else
                local missing = {}
                if not hasTeam then table.insert(missing, "team") end
                if not hasTargets then table.insert(missing, "pet types") end
                if not hasMutations then table.insert(missing, "mutations to keep") end
                table.insert(lines, "Status: Select " .. table.concat(missing, ", "))
            end
        end)

        if not success then
            table.insert(lines, "Error loading status: " .. tostring(err))
        end

        return table.concat(lines, "\n")
    end

    -- Update status paragraph
    function m:UpdateStatus()
        if m.StatusParagraph and m.StatusParagraph.SetContent then
            local text = self:GetStatusText()
            m.StatusParagraph:SetContent(text)
        end

        -- Update Venom status
        if m.VenomStatusParagraph and m.VenomStatusParagraph.SetContent and Venom then
            local venomText = Venom:GetStatusText()
            m.VenomStatusParagraph:SetContent(venomText)
        end
    end

    -- Status loop state
    m.StatusLoopRunning = false

    -- Start status update loop
    function m:StartStatusLoop()
        if m.StatusLoopRunning then return end
        m.StatusLoopRunning = true

        task.spawn(function()
            while m.StatusLoopRunning do
                pcall(function()
                    self:UpdateStatus()
                end)
                task.wait(5)  -- Update every 5 seconds
            end
        end)
    end

    -- Stop status loop
    function m:StopStatusLoop()
        m.StatusLoopRunning = false
        -- print("[Mutation UI] Status loop stopped")
    end

    return m

end

-- Module: growth/growth.lua
EmbeddedModules["growth/growth.lua"] = function()
