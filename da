        Window = _window
        Leveling = _leveling
        Core = _core
        PetTeam = _petTeam
        Pet = _pet
        PandoruyHub = _pandoruyHub

        -- Setup notification callback
        if Leveling then
            Leveling.OnNotify = function(title, content, color)
                if PandoruyHub and PandoruyHub.MakeNotify then
                    PandoruyHub:MakeNotify({
                        Title = title,
                        Content = content,
                        Color = color or Color3.fromRGB(255, 215, 0),
                        Duration = 4
                    })
                end
            end
        end

        self:CreateLevelingContent()
        self:StartStatusLoop()
        -- Auto-resume is now centralized in main.lua
    end

    function m:CreateLevelingContent()
        self:AddStatusSection(Tab)
        self:AddLevelingSection(Tab)
    end

    function m:AddStatusSection(tab)
        local section = tab:AddSection("Leveling Mode Status")

        m.StatusParagraph = section:AddParagraph({
            Title = "",
            Content = "Loading status..."
        })
    end

    -- Helper to get pet options including saved ones
    function m:GetPetOptionsWithSaved(savedTeamGuidsMap)
        local results = {}
        local lookup = {} -- name -> guid
        local seenGuids = {}

        -- 1. Get standard active pets (favorite pets)
        if Pet and Pet.GetActivePetsForDropdown then
            for _, item in ipairs(Pet:GetActivePetsForDropdown()) do
                table.insert(results, item)
                lookup[item.text] = item.value
                seenGuids[item.value] = true
            end
        end

        -- 2. Add saved pets if missing
        if savedTeamGuidsMap then
            for guid, _ in pairs(savedTeamGuidsMap) do
                if not seenGuids[guid] then
                    -- Fetch pet data manually
                    local petData = Pet:GetPetData(guid)
                    if petData then
                        -- Format display name (logic from Pet:GetActivePetsForDropdown)
                        local PD = petData.PetData or petData.Data or {}
                        local petType = petData.PetType or petData.Type or PD.Type or PD.PetType or "Unknown"
                        local age = PD.Level or PD.Age or petData.Level or petData.Age or 0
                        local baseWeight = PD.BaseWeight or petData.BaseWeight or 0

                        -- Weight scale per level (default 0.1)
                        local SCALE_PER_LVL = 0.1
                        local currentWeight = baseWeight * (1 + SCALE_PER_LVL * age)

                        -- Resolve mutation
                        local mutCode = PD.MutationType or petData.MutationType or ""
                        local mutName = ""
                        if mutCode ~= "" then
                            if Pet.MutationEnumMap and Pet.MutationEnumMap[mutCode] then
                                mutName = Pet.MutationEnumMap[mutCode]
                            else
                                mutName = mutCode
                            end
                            if mutName == "Gold" then mutName = "Golden" end
                        end

                        local displayName = ""
                        if mutName ~= "" then displayName = mutName .. " " end
                        displayName = displayName .. petType
                        displayName = displayName .. string.format(" Age %d", age)
                        displayName = displayName .. string.format(" %.2f KG", currentWeight)

                        local cleanGuid = tostring(guid):gsub("[{}]", "")
                        local shortGuid = string.sub(cleanGuid, 1, 8)
                        displayName = displayName .. " (" .. shortGuid .. ")"

                        -- Add to results
                        local item = {
                            text = displayName,
                            value = guid,
                            weight = currentWeight
                        }
                        table.insert(results, item)
                        lookup[item.text] = guid
                        seenGuids[guid] = true
                    else
                        -- Pet data not found (maybe deleted/traded?), add placeholder with GUID
                        local shortGuid = string.sub(tostring(guid), 1, 8)
                        local displayName = "Unknown Pet (" .. shortGuid .. ")"
                        local item = { text = displayName, value = guid, weight = 0 }
                        table.insert(results, item)
                        lookup[item.text] = guid
                        seenGuids[guid] = true
                    end
                end
            end
        end

        -- Sort by weight descending
        table.sort(results, function(a, b)
            return (a.weight or 0) > (b.weight or 0)
        end)

        -- Extract just names for dropdown
        local names = {}
        for _, item in ipairs(results) do
            table.insert(names, item.text)
        end

        if #names == 0 then table.insert(names, "No favorite pets") end

        return names, lookup
    end

    function m:AddLevelingSection(tab)
        local section = tab:AddSection("Auto Leveling Settings")

        -- Pet Team Selection (multi-select pet dropdown)
        m.TeamLookup = {}

        local savedPets = Leveling and Leveling.SelectedTeamPets or {}
        local options, lookup = self:GetPetOptionsWithSaved(savedPets)
        m.TeamLookup = lookup

        local defaults = {}
        for name, guid in pairs(lookup) do
            if savedPets[guid] then
                table.insert(defaults, name)
            end
        end

        m.TeamDropdown = section:AddDropdown({
            Title = "Leveling Pet Team",
            Content = "Select pets to keep in garden while leveling",
            Options = options,
            Multi = true,
            Default = defaults,
            Flag = "LevelingPetTeam",
            OnOpen = function()
                local currentSaved = Leveling and Leveling.SelectedTeamPets or {}
                local newOpts, newLookup = self:GetPetOptionsWithSaved(currentSaved)
                m.TeamLookup = newLookup
                return newOpts
            end,
            Callback = function(selectedNames)
                if Leveling then
                    local pets = {}
                    local currentLookup = m.TeamLookup or {}
                    for _, name in ipairs(selectedNames) do
                        local guid = currentLookup[name]
                        if guid then pets[guid] = true end
                    end
                    Leveling.SelectedTeamPets = pets
                    if Leveling.SaveConfig then Leveling:SaveConfig() end
                end
            end
        })

        -- Pet Type Dropdown (Multi-select)
        local petTypeOptions = {}
        if Pet and Pet.GetPetRegistry then
            local petRegistry = Pet:GetPetRegistry()
            for _, petInfo in ipairs(petRegistry) do
                table.insert(petTypeOptions, petInfo.Name)
            end
            table.sort(petTypeOptions, function(a, b)
                return string.lower(a) < string.lower(b)
            end)
        else
            petTypeOptions = {"Common", "Uncommon", "Rare", "Legendary", "Mythical"}
        end

        section:AddDropdown({
            Title = "Leveling Pet Types",
            Content = "Select pet types to auto-level",
            Options = petTypeOptions,
            Multi = true,
            Flag = "LevelingPetTypes",
            Callback = function(selected)
                if Leveling then
                    Leveling.SelectedPetTypes = {}
                    for _, petName in ipairs(selected) do
                        Leveling.SelectedPetTypes[petName] = true
                    end
                    if Leveling.SaveConfig then Leveling:SaveConfig() end
                end
                -- print("[Leveling UI] Pet types selected:", table.concat(selected, ", "))
            end
        })

        -- Target Level Input
        section:AddInput({
            Title = "Target Level",
            Default = Leveling and tostring(Leveling.TargetLevel) or "100",
            Callback = function(value)
                local level = tonumber(value)
                if level and level > 0 and level <= 100 and Leveling then
                    Leveling.TargetLevel = level
                    if Leveling.SaveConfig then Leveling:SaveConfig() end
                    -- print("[Leveling UI] Target level set to:", level)
                end
            end
        })

        -- Max Pets In Garden
        section:AddInput({
            Title = "Max Pets in Garden",
            Default = Leveling and tostring(Leveling.MaxPetsInGarden) or "3",
            Callback = function(value)
                local max = tonumber(value)
                if max and max >= 1 and max <= 8 and Leveling then
                    Leveling.MaxPetsInGarden = max
                    if Leveling.SaveConfig then Leveling:SaveConfig() end
                    -- print("[Leveling UI] Max pets set to:", max)
                end
            end
        })

        -- Enable Auto Leveling Toggle
        section:AddToggle({
            Title = "Enable Auto Leveling",
            Default = Leveling and (Leveling.IsRunning or Leveling.WasRunning) or false,
            Callback = function(enabled)
                if enabled then
                    if Leveling then Leveling:Start() end
                else
                    -- Only call Stop if was actually running (prevents pickup on script load)
                    if Leveling and Leveling.IsRunning then 
                        Leveling:Stop() 
                    end
                end
            end
        })
    end

    -- Get status text for display
    function m:GetStatusText()
        local lines = {}

        -- Auto Status
        local isRunning = Leveling and Leveling.IsRunning or false
        table.insert(lines, "Auto Status: " .. (isRunning and "RUNNING" or "STOPPED"))
        table.insert(lines, "")

        -- Current Settings
        table.insert(lines, "Current Settings:")

        local teamPetCount = 0
        if Leveling and Leveling.SelectedTeamPets then
            for _ in pairs(Leveling.SelectedTeamPets) do teamPetCount = teamPetCount + 1 end
        end
        table.insert(lines, "Pet Team: " .. tostring(teamPetCount) .. " pets selected")

        -- Target Types - show actual names
        local targetTypes = {}
        if Leveling and Leveling.SelectedPetTypes then
            for petType, _ in pairs(Leveling.SelectedPetTypes) do
                table.insert(targetTypes, petType)
            end
            table.sort(targetTypes)
        end
        local targetTypesStr = #targetTypes > 0 and table.concat(targetTypes, ", ") or "None"
        table.insert(lines, "Target Types: " .. targetTypesStr)

        -- Target Pets Ready (pets matching selected types and not at max level, excluding favorited)
        local petsReadyCount = 0
        local petsAtMaxLevel = 0
        if Pet and Pet.GetAllPetsInInventory and Leveling then
            local allPets = Pet:GetAllPetsInInventory()
            local selectedTypes = Leveling.SelectedPetTypes or {}
            local targetLevel = Leveling.TargetLevel or 100

            for guid, petData in pairs(allPets or {}) do
                local petType = Pet:GetPetType(petData)
                local isFavorited = Pet.IsPetFavorited and Pet:IsPetFavorited(petData) or false

                -- Check if pet type is selected AND not favorited
                if selectedTypes[petType] == true and not isFavorited then
                    local level = Pet:GetPetAge(petData)
                    if level < targetLevel then
                        petsReadyCount = petsReadyCount + 1
                    else
                        petsAtMaxLevel = petsAtMaxLevel + 1
                    end
                end
            end
        end
        table.insert(lines, "Pets Ready to Level: " .. tostring(petsReadyCount) .. " pets")
        table.insert(lines, "Pets at Max Level: " .. tostring(petsAtMaxLevel) .. " pets")

        -- Max Pets
        local maxPets = Leveling and Leveling.MaxPetsInGarden or 3
        table.insert(lines, "Max in Garden: " .. tostring(maxPets) .. " pets")
        table.insert(lines, "")

        -- Target Level
        local targetLevel = Leveling and Leveling.TargetLevel or 100
        table.insert(lines, "Target Level: " .. tostring(targetLevel))
        table.insert(lines, "")

        -- Ready status
        local hasTeam = teamPetCount > 0
        local hasTargets = #targetTypes > 0
        if hasTeam and hasTargets then
            table.insert(lines, "Ready: Settings configured")
        else
            local missing = {}
            if not hasTeam then table.insert(missing, "team pets") end
            if not hasTargets then table.insert(missing, "pet types") end
            table.insert(lines, "Missing: " .. table.concat(missing, ", "))
        end

        return table.concat(lines, "\n")
    end

    -- Update status display
    function m:UpdateStatus()
        if m.StatusParagraph and m.StatusParagraph.SetContent then
            local statusText = self:GetStatusText()
            m.StatusParagraph:SetContent(statusText)
        end
    end

    -- Start status update loop
    function m:StartStatusLoop()
        m.StatusLoopActive = true
        task.spawn(function()
            while m.StatusLoopActive do
                pcall(function()
                    m:UpdateStatus()
                end)
                task.wait(5)
            end
        end)
    end

    -- Stop status update loop
    function m:StopStatusLoop()
        m.StatusLoopActive = false
    end

    return m

end

