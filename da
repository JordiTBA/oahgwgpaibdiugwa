-- Module: module/collectfruit.lua
EmbeddedModules["module/collectfruit.lua"] = function()
    -- collectfruit.lua (PandoruyHub)
    -- Auto Collect Fruit using GameEvents.Crops.Collect RemoteEvent
    -- Based on PandoraHub/grow-a-garden/farm/plant.lua

    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    local LP = Players.LocalPlayer
    local username = LP.Name

    local M = {}

    ----------------------------------------------------------------
    -- ENV / GLOBALS
    ----------------------------------------------------------------
    local G = (getgenv and getgenv()) or _G

    ----------------------------------------------------------------
    -- CONFIG
    ----------------------------------------------------------------
    local LOOP_TICK_SEC = 2
    local COLLECT_DELAY = 0.1
    local MAX_HOLDABLE = 200

    -- Toggle global
    G.AUTO_COLLECT_FRUIT_ENABLED = (G.AUTO_COLLECT_FRUIT_ENABLED == true)

    ----------------------------------------------------------------
    -- INTERNAL STATE
    ----------------------------------------------------------------
    local running = false

    ----------------------------------------------------------------
    -- GET CROP COLLECT REMOTE
    ----------------------------------------------------------------
    local CropsCollect = nil
    pcall(function()
        CropsCollect = ReplicatedStorage:WaitForChild("GameEvents", 5):WaitForChild("Crops", 5):WaitForChild("Collect", 5)
    end)

    -- CropsCollect loaded silently

    ----------------------------------------------------------------
    -- FIND OWN FARM
    ----------------------------------------------------------------
    local function getOwnFarm()
        local farmsFolder = workspace:FindFirstChild("Farm")
        if not farmsFolder then return nil end

        for _, farm in ipairs(farmsFolder:GetChildren()) do
            local ok, ownerValue = pcall(function()
                return farm:FindFirstChild("Important")
                    and farm.Important:FindFirstChild("Data")
                    and farm.Important.Data:FindFirstChild("Owner")
                    and farm.Important.Data.Owner.Value
            end)

            if ok and ownerValue == username then
                return farm
            end
        end

        return nil
    end

    ----------------------------------------------------------------
    -- CHECK IF FRUIT IS ELIGIBLE TO HARVEST
    ----------------------------------------------------------------
    local function isEligibleToHarvest(fruit)
        if not fruit or not fruit:IsA("Model") then return false end

        local prompt = fruit:FindFirstChild("ProximityPrompt", true)
        if not prompt then
            local customPrompt = string.format("%s_ProximityPrompt", fruit.Name)
            prompt = fruit:FindFirstChild(customPrompt, true)
        end

        if not prompt then return false end
        if not prompt.Enabled then return false end

        return true
    end

    ----------------------------------------------------------------
    -- COLLECT SINGLE FRUIT
    ----------------------------------------------------------------
    local function collectFruit(fruit)
        if not CropsCollect then return false end
        if not fruit then return false end

        local success, err = pcall(function()
            CropsCollect:FireServer({fruit})
        end)

        return success
    end

    ----------------------------------------------------------------
    -- COLLECT ALL FRUITS FROM OWN FARM
    ----------------------------------------------------------------
    local function collectAllFruits()
        local farm = getOwnFarm()
        if not farm then return 0 end

        local important = farm:FindFirstChild("Important")
        if not important then return 0 end

        local plants = important:FindFirstChild("Plants_Physical")
        if not plants then return 0 end

        local count = 0

        for _, plant in ipairs(plants:GetChildren()) do
            if not G.AUTO_COLLECT_FRUIT_ENABLED then break end

            local fruitsFolder = plant:FindFirstChild("Fruits")
            if fruitsFolder then
                for _, fruit in ipairs(fruitsFolder:GetChildren()) do
                    if not G.AUTO_COLLECT_FRUIT_ENABLED then break end

                    if isEligibleToHarvest(fruit) then
                        if collectFruit(fruit) then
                            count = count + 1
                            task.wait(COLLECT_DELAY)
                        end
                    end
                end
            end
        end

        return count
    end

    ----------------------------------------------------------------
    -- LOOP
    ----------------------------------------------------------------
    local function collectLoop()
        while running do
            if G.AUTO_COLLECT_FRUIT_ENABLED == true then
                collectAllFruits()
            end
            task.wait(LOOP_TICK_SEC)
        end
    end

    ----------------------------------------------------------------
    -- PUBLIC API
    ----------------------------------------------------------------
    function M.SetEnabled(on)
        on = (on == true)
        G.AUTO_COLLECT_FRUIT_ENABLED = on

        if on then
            if not running then
                running = true
                task.spawn(collectLoop)
            end
        else
            running = false
        end
    end

    function M.setEnabled(on) return M.SetEnabled(on) end
    function M.start() M.SetEnabled(true) end
    function M.stop() M.SetEnabled(false) end

    function M.IsRunning()
        return running == true and (G.AUTO_COLLECT_FRUIT_ENABLED == true)
    end

    function M.syncFromState()
        local on = (G.AUTO_COLLECT_FRUIT_ENABLED == true)
        M.SetEnabled(on)
    end

    -- Set globals
    _G.AutoCollectFruit = M
    G.AutoCollectFruit = M

    return M

end

-- Module: elephant/elephant.lua
EmbeddedModules["elephant/elephant.lua"] = function()
    -- elephant/elephant.lua
    -- Backend logic untuk auto elephant farming
    local m = {}

    local Core
    local Pet
    local PetTeam
    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    -- Direct datastore access (like auto_kg) for fresh data
    local ActivePetsService = nil
    pcall(function()
        ActivePetsService = require(ReplicatedStorage.Modules.PetServices.ActivePetsService)
    end)

    -- Storage (username-based path set in Init)
    local SAVE_BASE = "Pandora_KG"
    local SAVE_DIR = SAVE_BASE
    local SAVE_FILE = SAVE_DIR .. "/elephant_config.json"

    -- State
    m.IsRunning = false
    m.SelectedTeamPets = {} -- {guid = true} set of pet GUIDs
    m.TargetWeight = 60.5
    m.MaxPetsInGarden = 3  -- Default 3 (total 8 slots: 5 pet team + 3 target pets)
    m.SelectedPetTypes = {}
    m.MinAgeToEquip = 40  -- Only equip pets with age >= this value
    m.UnequipAtAge = 0     -- Unequip pets when age reaches this value
    m.OnNotify = nil       -- Callback for notifications

    -- Skill Stuck Detection (same as auto_kg)
    m.SkillStuckEnabled = true
    m.SkillStuckThreshold = 15  -- loops without cooldown change = stuck
    m.SkillStuckTolerance = 0.1 -- seconds tolerance
    local SKILL_STUCK = {}  -- [uuid] = { lastCooldown, sameCount }
    -- All skill tokens combined (ELE + XP from auto_kg)
    local ALL_SKILL_TOKENS = {
        "rainbow jumbo blessing", "jumbo blessing", "jumbo",  -- ELE
        "friendly frier", "mining", "rainbow frilled reptile"  -- XP
    }

    ----------------------------------------------------------------
    -- DIRECT DATASTORE ACCESS (like auto_kg for fresh data)
    ----------------------------------------------------------------
    local function getDatastoreBag()
        if not ActivePetsService or not ActivePetsService.GetPlayerDatastorePetData then
            return nil
        end
        local ok, store = pcall(function()
            return ActivePetsService:GetPlayerDatastorePetData(Players.LocalPlayer.Name)
        end)
        if not ok or not store then return nil end
        if not store.PetInventory or not store.PetInventory.Data then return nil end
        return store.PetInventory.Data
    end

    local function getPetAgeFromDatastore(uuid)
        if not uuid or uuid == "" then return nil end

        local bag = getDatastoreBag()
        if not bag then return nil end

        -- Normalize UUID (with and without braces)
        local core = tostring(uuid):match("{?([0-9a-fA-F%-]+)}?") or tostring(uuid)
        local braced = "{" .. core .. "}"

        local rec = bag[core] or bag[braced] or bag[uuid]
        if not rec or type(rec) ~= "table" then return nil end

        local PD = rec.PetData or rec.Data or {}
        return PD.Level or PD.Age or rec.Level or rec.Age or 0
    end

    local function getPetWeightFromDatastore(uuid)
        if not uuid or uuid == "" then return nil end

        local bag = getDatastoreBag()
        if not bag then return nil end

        local core = tostring(uuid):match("{?([0-9a-fA-F%-]+)}?") or tostring(uuid)
        local braced = "{" .. core .. "}"

        local rec = bag[core] or bag[braced] or bag[uuid]
        if not rec or type(rec) ~= "table" then return nil end

        local PD = rec.PetData or rec.Data or {}
        return PD.BaseWeight or rec.BaseWeight or 0
    end

    ----------------------------------------------------------------
    -- INVENTORY SCAN FOR WEBHOOK STATISTICS
    ----------------------------------------------------------------
    -- Weight scale per level (default 0.1 = 10%)
    local WEIGHT_SCALE_PER_LEVEL = 0.1
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local petReg = require(RS.Data.PetRegistry)
        if petReg and petReg.PetConfig and petReg.PetConfig.WEIGHT_CONFIG then
            WEIGHT_SCALE_PER_LEVEL = petReg.PetConfig.WEIGHT_CONFIG.SCALE_PERCENTAGE_OF_BASE_WEIGHT_PER_LEVEL or 0.1
        end
    end)

    -- Calculate weight at age 1 from base weight
    local function getWeightAtAge1(baseWeight)
        if not baseWeight or baseWeight <= 0 then return 0 end
        return baseWeight * (1 + WEIGHT_SCALE_PER_LEVEL * 1)
    end

    -- Get weight range string (e.g., "6.01-6.09", "6.1-6.19")
    local function getWeightRange(weight)
        if not weight or weight <= 0 then return nil end

        local base = math.floor(weight * 10) / 10  -- e.g., 6.05 -> 6.0
        local rangeStart = base + 0.01
        local rangeEnd = base + 0.09

        return string.format("%.2f-%.2f", rangeStart, rangeEnd)
    end

    -- Scan inventory and build statistics for webhook
    function m:ScanInventoryStats()
        local stats = {
            teamComposition = {},   -- {petType = count}
            targetTypes = {},       -- {petType = true}
            boostingStats = {},     -- {petType = {total = N, ranges = {range = count}}}
            totalMaxKG = 0,
            remainsQueue = 0
        }

        local bag = getDatastoreBag()
        if not bag then return stats end

        -- Get target types from config
        stats.targetTypes = self.SelectedPetTypes or {}

        -- Build team composition
        if self.SelectedTeamPets and Pet then
            for guid, _ in pairs(self.SelectedTeamPets) do
                local petData = Pet:GetPetData(guid)
                if petData then
                    local petType = Pet:GetPetType(petData)
                    stats.teamComposition[petType] = (stats.teamComposition[petType] or 0) + 1
                end
            end
        end

        -- Scan all pets in inventory
        for guid, rec in pairs(bag) do
            if type(rec) == "table" then
                local PD = rec.PetData or rec.Data or {}
                local petType = rec.PetType or rec.Type or PD.Type or PD.PetType or "Unknown"
                local baseWeight = PD.BaseWeight or rec.BaseWeight or 0
                local isFavorite = PD.IsFavorite or rec.IsFavorite or PD.Favorited or rec.Favorited or false

                -- Only count target pet types (not favorited)
                if stats.targetTypes[petType] and not isFavorite then
                    if baseWeight >= self.TargetWeight then
                        -- Pet has reached max KG
                        stats.totalMaxKG = stats.totalMaxKG + 1

                        -- Initialize pet type stats if needed
                        if not stats.boostingStats[petType] then
                            stats.boostingStats[petType] = {
                                total = 0,
                                ranges = {}
                            }
                        end

                        stats.boostingStats[petType].total = stats.boostingStats[petType].total + 1

                        -- Add to weight range (using weight at age 1)
                        local weightAt1 = getWeightAtAge1(baseWeight)
                        local range = getWeightRange(weightAt1)
                        if range then
                            stats.boostingStats[petType].ranges[range] =
                                (stats.boostingStats[petType].ranges[range] or 0) + 1
                        end
                    else
                        -- Pet still in queue
                        stats.remainsQueue = stats.remainsQueue + 1
                    end
                end
            end
        end

        return stats
    end

    -- Send Elephant BOOST webhook
    function m:SendElephantWebhook()
        local G = getgenv and getgenv() or _G
        if not G.SpecialWebhook then return end

        local stats = self:ScanInventoryStats()

        pcall(function()
            G.SpecialWebhook:ElephantBoostStats(stats)
        end)
    end

    -- Save config to file
    function m:SaveConfig()
        pcall(function()
            -- Ensure base folder exists
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            -- Ensure user folder exists
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local payload = {
                selectedTeamPets = self.SelectedTeamPets,
                targetWeight = self.TargetWeight,
                minAgeToEquip = self.MinAgeToEquip,
                unequipAtAge = self.UnequipAtAge,
                maxPetsInGarden = self.MaxPetsInGarden,
                selectedPetTypes = self.SelectedPetTypes,
                wasRunning = self.IsRunning, -- Save toggle state
                _ts = os.time()
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
            -- print("[Elephant] Config saved")
        end)
    end

    -- Load config from file
    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            -- print("[Elephant] No saved config, using defaults")
            return false
        end

        local success, err = pcall(function()
            local text = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(text)

            -- New format: direct pet GUIDs set
            if type(data.selectedTeamPets) == "table" then
                self.SelectedTeamPets = {}
                for guid, v in pairs(data.selectedTeamPets) do
                    if v then self.SelectedTeamPets[guid] = true end
                end
            elseif data.selectedTeam and data.selectedTeam ~= "" and PetTeam and PetTeam.GetTeam then
                -- Backward-compat: migrate from named team
                local team = PetTeam:GetTeam(data.selectedTeam)
                if team and team.pets then
                    self.SelectedTeamPets = {}
                    for _, guid in ipairs(team.pets) do
                        self.SelectedTeamPets[guid] = true
                    end
                end
            end
            if type(data.targetWeight) == "number" then
                self.TargetWeight = data.targetWeight
            end
            if type(data.minAgeToEquip) == "number" then
                self.MinAgeToEquip = data.minAgeToEquip
            end
            if type(data.unequipAtAge) == "number" then
                self.UnequipAtAge = data.unequipAtAge
            end
            if type(data.maxPetsInGarden) == "number" then
                self.MaxPetsInGarden = data.maxPetsInGarden
            end
            if type(data.selectedPetTypes) == "table" then
                self.SelectedPetTypes = {}
                for petType, isSelected in pairs(data.selectedPetTypes) do
                    if isSelected then
                        self.SelectedPetTypes[petType] = true
                    end
                end
            end

            -- Load saved running state for auto-resume
            self.WasRunning = data.wasRunning == true
        end)

        if not success then
            -- warn("[Elephant] Failed to load config:", err)
            return false
        end

        return true
    end

    function m:Init(_core, _pet, _petTeam)
        Core = _core
        Pet = _pet
        PetTeam = _petTeam

        -- Set username-based save path
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/elephant_config.json"

        -- Load saved config
        self:LoadConfig()
        -- Auto-resume is now handled in UI init (elephant/ui_pandoruy.lua)
    end

    -- Send notification via callback
    function m:Notify(title, content, color)
        if self.OnNotify then
            self.OnNotify(title, content, color)
        end
    end

    -- Get skill cooldown for stuck detection (same as auto_kg)
    function m:GetSkillCooldown(uuid, tokens)
        if not uuid or uuid == "" then return nil end
        tokens = tokens or ALL_SKILL_TOKENS

        local cooldowns = nil
        pcall(function()
            local GameEvents = Core.ReplicatedStorage:WaitForChild("GameEvents", 2)
            local GetPetCooldownRF = GameEvents:WaitForChild("GetPetCooldown", 2)
            if GetPetCooldownRF then
                cooldowns = GetPetCooldownRF:InvokeServer(uuid)
            end
        end)

        if type(cooldowns) ~= "table" then return nil end

        for _, cd in ipairs(cooldowns) do
            local skill = string.lower(tostring(cd.Skill or cd.Passive or ""))
            for _, token in ipairs(tokens) do
                if skill:find(token, 1, true) then
                    local time = cd.Time
                    if type(time) == "number" then return time end
                    if type(time) == "string" then
                        local m, s = time:match("^(%d+)%s*:%s*(%d+)$")
                        if m and s then return tonumber(m) * 60 + tonumber(s) end
                        return tonumber(time:match("%-?%d+%.?%d*")) or 0
                    end
                end
            end
        end
        return nil
    end

    -- Check and fix stuck pets (same as auto_kg)
    function m:CheckStuckPets()
        if not self.SkillStuckEnabled then return end

        local activePets = Pet:GetActivePets() or {}
        local stuckPets = {}

        for _, guid in ipairs(activePets) do
            local cooldown = self:GetSkillCooldown(guid, ALL_SKILL_TOKENS)
            local rec = SKILL_STUCK[guid] or { lastCooldown = nil, sameCount = 0 }

            if cooldown == nil then
                rec.lastCooldown, rec.sameCount = nil, 0
            else
                if rec.lastCooldown ~= nil then
                    local diff = cooldown - rec.lastCooldown
                    if diff >= -self.SkillStuckTolerance then
                        rec.sameCount = (rec.sameCount or 0) + 1
                    else
                        rec.sameCount = 0
                    end
                else
                    rec.sameCount = 0
                end

                rec.lastCooldown = cooldown

                if rec.sameCount >= self.SkillStuckThreshold then
                    table.insert(stuckPets, guid)
                    rec.sameCount = 0
                end
            end

            SKILL_STUCK[guid] = rec
        end

        -- Fix stuck pets
        if #stuckPets > 0 then
            for _, guid in ipairs(stuckPets) do
                Pet:UnequipPet(guid)
                task.wait(0.25)
            end
            task.wait(0.5)
            for _, guid in ipairs(stuckPets) do
                Pet:EquipPet(guid)
                task.wait(0.25)
            end
        end
    end

    -- All pet operations now use the Pet module

    -- Pickup all active pets in garden
    function m:PickupAllPets()
        local activePets = Pet:GetActivePets()
        if not activePets then
            return
        end

        local count = 0
        for _, guid in ipairs(activePets) do
            Pet:UnequipPet(guid)
            count = count + 1
            task.wait(0.25)
        end

        -- print("[Elephant] Picked up", count, "pets from garden")
    end

    -- Equip pet team (if selected)
    function m:EnsurePetTeamActive()
        if not self.SelectedTeamPets or next(self.SelectedTeamPets) == nil then
            return
        end

        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            activePetsArray = {}
        end

        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        local equipped = 0
        for petGuid, _ in pairs(self.SelectedTeamPets) do
            if not activePets[petGuid] then
                local success = Pet:EquipPet(petGuid)
                if success then
                    equipped = equipped + 1
                end
                task.wait(0.25)
            end
        end
    end

    -- Filter pets by type (skips favorited pets)
    function m:FilterPetsByType(pets)
        if not self.SelectedPetTypes or next(self.SelectedPetTypes) == nil then
            return pets
        end

        local filtered = {}
        for guid, petData in pairs(pets) do
            local petType = Pet:GetPetType(petData)
            -- Skip favorited pets
            local isFavorited = Pet:IsPetFavorited(petData)
            if self.SelectedPetTypes[petType] and not isFavorited then
                filtered[guid] = petData
            end
        end

        return filtered
    end

    -- Auto idle logic - detect new pets and equip them
    function m:AutoIdlePets()
        -- Get all pets in inventory
        local allPets = Pet:GetAllPetsInInventory()

        -- Debug: show how many pets in inventory
        local allPetsCount = 0
        for _ in pairs(allPets) do allPetsCount = allPetsCount + 1 end

        -- Filter by selected types
        local targetPets = self:FilterPetsByType(allPets)

        -- Debug: show how many pets after filtering
        local targetPetsCount = 0
        for _ in pairs(targetPets) do targetPetsCount = targetPetsCount + 1 end

        -- Debug: show selected pet types
        local selectedTypesCount = 0
        local selectedTypesList = {}
        if self.SelectedPetTypes then
            for petType, _ in pairs(self.SelectedPetTypes) do
                selectedTypesCount = selectedTypesCount + 1
                table.insert(selectedTypesList, petType)
            end
        end

        -- print("[Elephant] DEBUG: Inventory pets:", allPetsCount, "| Selected types:", selectedTypesCount, "| Target pets after filter:", targetPetsCount)
        if selectedTypesCount > 0 then
            -- print("[Elephant] DEBUG: Selected types:", table.concat(selectedTypesList, ", "))
        end

        -- Get current active pets (returns array)
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            activePetsArray = {}
        end

        -- Convert array to map for faster lookup
        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        -- Count how many target pets are currently active (regardless of age/weight criteria)
        -- This ensures we don't try to equip more pets when slots are occupied by pets that don't meet criteria yet
        local activeTargetCount = 0
        for guid, _ in pairs(activePets) do
            -- Check if this active pet is a target pet (not pet team)
            if targetPets[guid] then
                activeTargetCount = activeTargetCount + 1
            end
        end

        -- Calculate total active pets and free slots in garden
        local totalActivePets = #activePetsArray
        local totalFreeSlots = 8 - totalActivePets

        -- Check if we can equip more target pets (limited by MaxPetsInGarden)
        local targetFreeSlots = self.MaxPetsInGarden - activeTargetCount

        -- We can only equip if:
        -- 1. There are free slots in garden (max 8 total)
        -- 2. We haven't reached MaxPetsInGarden for target pets
        local canEquip = math.min(totalFreeSlots, targetFreeSlots)

        -- print("[Elephant] DEBUG: Active pets:", totalActivePets, "| Free slots:", totalFreeSlots, "| Target free slots:", targetFreeSlots, "| Can equip:", canEquip)

        if canEquip > 0 then
            -- Find pets to equip (not currently active, age >= MinAge, weight < target)
            for guid, petData in pairs(targetPets) do
                if canEquip <= 0 then break end

                -- Use DIRECT DATASTORE ACCESS for fresh data (like auto_kg)
                local weight = getPetWeightFromDatastore(guid) or Pet:GetPetWeight(petData)
                local age = getPetAgeFromDatastore(guid) or Pet:GetPetAge(petData)
                local petType = Pet:GetPetType(petData)
                local isActive = activePets[guid]
                local ageOk = age >= self.MinAgeToEquip
                local weightOk = weight < self.TargetWeight

                -- print("[Elephant] DEBUG: Pet", petType, "GUID:", string.sub(guid, 1, 8), "Age:", age, "Weight:", weight, "Active:", isActive, "AgeOK:", ageOk, "WeightOK:", weightOk)

                -- Only equip if:
                -- 1. Not currently active
                -- 2. Age >= MinAgeToEquip
                -- 3. Weight < TargetWeight
                if not isActive and ageOk and weightOk then
                    -- print("[Elephant] Auto equipping target pet:", guid, "Age:", age, "Weight:", weight)
                    Pet:EquipPet(guid)
                    canEquip = canEquip - 1
                    activeTargetCount = activeTargetCount + 1
                    task.wait(0.25)
                end
            end
        end
    end

    -- Check and unequip pets that reached target weight or age (only for target pets, NOT pet team)
    function m:CheckAndUnequipPets()
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            return
        end

        -- Get pet team members (to exclude from unequip logic)
        local petTeamGuids = self.SelectedTeamPets or {}

        -- Get all pets in inventory and filter by selected types
        local allPets = Pet:GetAllPetsInInventory()
        local targetPets = self:FilterPetsByType(allPets)

        for _, guid in ipairs(activePetsArray) do
            -- Skip if this is a pet team member
            if not petTeamGuids[guid] then
                -- Check if this is a target pet
                if targetPets[guid] then
                    -- This is a target pet, check weight/age criteria
                    -- Use DIRECT DATASTORE ACCESS for fresh data (like auto_kg)
                    local weight = getPetWeightFromDatastore(guid)
                    local age = getPetAgeFromDatastore(guid)

                    -- Fallback to Pet module if datastore fails
                    if not weight or not age then
                        local petData = Pet:GetPetData(guid)
                        if petData then
                            weight = weight or Pet:GetPetWeight(petData)
                            age = age or Pet:GetPetAge(petData)
                        end
                    end

                    if weight and age then
                        -- Unequip if:
                        -- 1. Reached target weight, OR
                        -- 2. Age <= UnequipAtAge (and UnequipAtAge > 0)
                        if weight >= self.TargetWeight then
                            -- print("[Elephant] Target pet reached target weight:", guid, "Age:", age, "Weight:", weight)
                            local petData = Pet:GetPetData(guid)
                            local petType = petData and Pet:GetPetType(petData) or "Pet"
                            self:Notify("Max KG Reached!", petType .. " reached " .. string.format("%.1f", weight) .. " KG", Color3.fromRGB(100, 200, 100))
                            Pet:UnequipPet(guid)
                            task.wait(0.25)

                            -- Send webhook after pet reaches target
                            task.spawn(function()
                                task.wait(0.5) -- Wait for inventory to update
                                self:SendElephantWebhook()
                            end)
                        elseif self.UnequipAtAge > 0 and age >= self.UnequipAtAge then
                            -- print("[Elephant] Target pet reached unequip age:", guid, "Age:", age)
                            Pet:UnequipPet(guid)
                            task.wait(0.25)
                        end
                    end
                else
                    -- This is NOT a target pet and NOT a pet team member
                    -- Unequip unauthorized pet
                    -- print("[Elephant] Unequipping unauthorized pet:", guid)
                    Pet:UnequipPet(guid)
                    task.wait(0.25)
                end
            end
        end
    end

    -- Main loop
    function m:Start()
        if self.IsRunning then
            -- warn("[Elephant] Already running!")
            return
        end

        -- Set running immediately so toggle feels responsive
        self.IsRunning = true

        self:Notify("Elephant Started", "Target: " .. self.TargetWeight .. " KG", Color3.fromRGB(100, 180, 255))

        -- Send initial webhook with current stats
        task.spawn(function()
            task.wait(1) -- Wait for inventory to be ready
            self:SendElephantWebhook()
        end)

        -- Run initialization and main loop in background
        task.spawn(function()
            -- Step 1: Pickup all pets from garden first
            self:PickupAllPets()
            task.wait(1)

            -- Check if stopped during init
            if not self.IsRunning then return end

            -- Step 2: Equip pet team immediately (if selected)
            self:EnsurePetTeamActive()
            task.wait(0.5)

            -- Main loop
            while self.IsRunning do
                pcall(function()
                    -- Ensure pet team stays active
                    self:EnsurePetTeamActive()

                    -- Check and unequip target pets that reached target weight or age
                    self:CheckAndUnequipPets()

                    -- Auto equip new target pets
                    self:AutoIdlePets()

                    -- Check and fix stuck pets
                    self:CheckStuckPets()
                end)

                task.wait(5) -- Check every 5 seconds
            end
        end)
    end

    function m:Stop()
        local wasRunning = self.IsRunning
        self.IsRunning = false


        -- Only notify and cleanup if was previously running
        if wasRunning then
            self:Notify("Elephant Stopped", "Auto elephant farming stopped", Color3.fromRGB(255, 150, 100))

            -- Run cleanup in background so toggle responds instantly
            task.spawn(function()
                task.wait(0.5) -- Wait for main loop to stop
                self:PickupAllPets()
            end)
        end
    end

    return m

end

-- Module: mutation/mutation.lua
EmbeddedModules["mutation/mutation.lua"] = function()
    -- mutation/mutation.lua
    -- Backend logic untuk auto nightmare mutation farming
    local m = {}

    local Core
    local Pet
    local PetTeam
    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")

    -- Storage (username-based path set in Init)
    local SAVE_BASE = "Pandora_KG"
    local SAVE_DIR = SAVE_BASE
    local SAVE_FILE = SAVE_DIR .. "/mutation_config.json"

    -- State
    m.IsRunning = false
    m.SelectedTeamPets = {} -- {guid = true} set of pet GUIDs
    m.SelectedPetTypes = {} -- {petType = true, ...}
    m.TargetMutationTypes = {} -- {mutationType = true, ...} - mutation types to keep
    m.MaxPetsInGarden = 9 -- Default max active pets for mutation
    m.OnNotify = nil -- Callback for notifications
    m.NotifiedPets = {} -- Track pets that have been notified to prevent duplicates

    -- Skill Stuck Detection (same as auto_kg)
    m.SkillStuckEnabled = true
    m.SkillStuckThreshold = 15
    m.SkillStuckTolerance = 0.1
    local SKILL_STUCK = {}
    local ALL_SKILL_TOKENS = {
        "rainbow jumbo blessing", "jumbo blessing", "jumbo",
        "friendly frier", "mining", "rainbow frilled reptile"
    }

    -- Available mutation types in the game (fallback, will be loaded from game)
    m.AvailableMutationTypes = {
        "Nightmare",
        "Venom",
        "Golden",
        "Rainbow",
    }

    -- Mutation-specific settings
    m.NightmareChance = 0 -- Current nightmare chance percentage
    m.LastEventTime = 0

    -- Load mutation types from game's PetMutationRegistry
    function m:LoadMutationTypes()
        local mutationList = {}
        self.MutationEnumMap = {} -- Enum to display name mapping (e.g., "X" -> "Venom")

        pcall(function()
            local RS = game:GetService("ReplicatedStorage")
            local mutationModule = require(RS.Data.PetRegistry.PetMutationRegistry)

            -- Load EnumToPetMutation mapping
            if mutationModule.EnumToPetMutation then
                for enumVal, displayName in pairs(mutationModule.EnumToPetMutation) do
                    self.MutationEnumMap[enumVal] = displayName
                    -- print("[Mutation] Enum mapping:", enumVal, "->", displayName)
                end
            end

            if mutationModule and mutationModule.PetMutationRegistry then
                for mutName, info in pairs(mutationModule.PetMutationRegistry) do
                    if type(mutName) == "string" and mutName ~= "" then
                        table.insert(mutationList, mutName)
                    end
                end
            elseif type(mutationModule) == "table" then
                -- Direct table format
                for mutName, info in pairs(mutationModule) do
                    if type(mutName) == "string" and mutName ~= "" and type(info) == "table" then
                        table.insert(mutationList, mutName)
                    end
                end
            end
        end)

        -- Sort alphabetically
        table.sort(mutationList, function(a, b)
            return tostring(a) < tostring(b)
        end)

        if #mutationList > 0 then
            self.AvailableMutationTypes = mutationList
            -- print("[Mutation] Loaded", #mutationList, "mutation types from game:", table.concat(mutationList, ", "))
        else
            -- print("[Mutation] Using fallback mutation types")
        end
    end

    -- Save config to file
    function m:SaveConfig()
        pcall(function()
            if not isfolder(SAVE_BASE) then
                makefolder(SAVE_BASE)
            end
            if not isfolder(SAVE_DIR) then
                makefolder(SAVE_DIR)
            end

            local payload = {
                selectedTeamPets = self.SelectedTeamPets,
                SelectedPetTypes = self.SelectedPetTypes,
                TargetMutationTypes = self.TargetMutationTypes,
                MaxPetsInGarden = self.MaxPetsInGarden,
                wasRunning = self.IsRunning, -- Save toggle state
                _ts = os.time()
            }

            local json = HttpService:JSONEncode(payload)
            writefile(SAVE_FILE, json)
            -- print("[Mutation] Config saved")
        end)
    end

    -- Load config from file
    function m:LoadConfig()
        if not isfile(SAVE_FILE) then
            -- print("[Mutation] No saved config, using defaults")
            return false
        end

        local success, err = pcall(function()
            local text = readfile(SAVE_FILE)
            local data = HttpService:JSONDecode(text)

            -- New format: direct pet GUIDs set
            if type(data.selectedTeamPets) == "table" then
                self.SelectedTeamPets = {}
                for guid, v in pairs(data.selectedTeamPets) do
                    if v then self.SelectedTeamPets[guid] = true end
                end
            elseif data.SelectedTeam and data.SelectedTeam ~= "" and PetTeam and PetTeam.GetTeam then
                -- Backward-compat: migrate from named team
                local team = PetTeam:GetTeam(data.SelectedTeam)
                if team and team.pets then
                    self.SelectedTeamPets = {}
                    for _, guid in ipairs(team.pets) do
                        self.SelectedTeamPets[guid] = true
                    end
                end
            end
            if data.SelectedPetTypes then
                self.SelectedPetTypes = data.SelectedPetTypes
            end
            if data.TargetMutationTypes then
                self.TargetMutationTypes = data.TargetMutationTypes
            end
            if data.MaxPetsInGarden then
                self.MaxPetsInGarden = data.MaxPetsInGarden
            end

            -- Load saved running state for auto-resume
            self.WasRunning = data.wasRunning == true
        end)

        if not success then
            -- warn("[Mutation] Failed to load config:", err)
            return false
        end

        return true
    end

    function m:Init(_core, _pet, _petTeam)
        Core = _core
        Pet = _pet
        PetTeam = _petTeam

        -- Set username-based save path
        local username = Players.LocalPlayer and Players.LocalPlayer.Name or "Unknown"
        SAVE_DIR = SAVE_BASE .. "/" .. username
        SAVE_FILE = SAVE_DIR .. "/mutation_config.json"

        -- Load mutation types from game
        self:LoadMutationTypes()

        -- Load saved config
        self:LoadConfig()
        -- Auto-resume is now handled in UI init (mutation/ui_pandoruy.lua)
    end

    -- Send notification via callback
    function m:Notify(title, content, color)
        if self.OnNotify then
            self.OnNotify(title, content, color)
        end
    end

    -- Get skill cooldown for stuck detection (same as auto_kg)
    function m:GetSkillCooldown(uuid, tokens)
        if not uuid or uuid == "" then return nil end
        tokens = tokens or ALL_SKILL_TOKENS

        local cooldowns = nil
        pcall(function()
            local GameEvents = Core.ReplicatedStorage:WaitForChild("GameEvents", 2)
            local GetPetCooldownRF = GameEvents:WaitForChild("GetPetCooldown", 2)
            if GetPetCooldownRF then
                cooldowns = GetPetCooldownRF:InvokeServer(uuid)
            end
        end)

        if type(cooldowns) ~= "table" then return nil end

        for _, cd in ipairs(cooldowns) do
            local skill = string.lower(tostring(cd.Skill or cd.Passive or ""))
            for _, token in ipairs(tokens) do
                if skill:find(token, 1, true) then
                    local time = cd.Time
                    if type(time) == "number" then return time end
                    if type(time) == "string" then
                        local m, s = time:match("^(%d+)%s*:%s*(%d+)$")
                        if m and s then return tonumber(m) * 60 + tonumber(s) end
                        return tonumber(time:match("%-?%d+%.?%d*")) or 0
                    end
                end
            end
        end
        return nil
    end

    -- Check and fix stuck pets (same as auto_kg)
    function m:CheckStuckPets()
        if not self.SkillStuckEnabled then return end

        local activePets = Pet:GetActivePets() or {}
        local stuckPets = {}

        for _, guid in ipairs(activePets) do
            local cooldown = self:GetSkillCooldown(guid, ALL_SKILL_TOKENS)
            local rec = SKILL_STUCK[guid] or { lastCooldown = nil, sameCount = 0 }

            if cooldown == nil then
                rec.lastCooldown, rec.sameCount = nil, 0
            else
                if rec.lastCooldown ~= nil then
                    local diff = cooldown - rec.lastCooldown
                    if diff >= -self.SkillStuckTolerance then
                        rec.sameCount = (rec.sameCount or 0) + 1
                    else
                        rec.sameCount = 0
                    end
                else
                    rec.sameCount = 0
                end

                rec.lastCooldown = cooldown

                if rec.sameCount >= self.SkillStuckThreshold then
                    table.insert(stuckPets, guid)
                    rec.sameCount = 0
                end
            end

            SKILL_STUCK[guid] = rec
        end

        if #stuckPets > 0 then
            for _, guid in ipairs(stuckPets) do
                Pet:UnequipPet(guid)
                task.wait(0.25)
            end
            task.wait(0.5)
            for _, guid in ipairs(stuckPets) do
                Pet:EquipPet(guid)
                task.wait(0.25)
            end
        end
    end

    -- Pickup all pets from garden
    function m:PickupAllPets()
        local activePets = Pet:GetActivePets()
        if not activePets then
            return
        end

        local count = 0
        for _, guid in ipairs(activePets) do
            Pet:UnequipPet(guid)
            count = count + 1
            task.wait(0.25)
        end

        -- print("[Mutation] Picked up", count, "pets from garden")
    end

    -- Equip pet team (if selected)
    function m:EnsurePetTeamActive()
        if not self.SelectedTeamPets or next(self.SelectedTeamPets) == nil then
            return
        end

        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            activePetsArray = {}
        end

        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        local equipped = 0
        for petGuid, _ in pairs(self.SelectedTeamPets) do
            if not activePets[petGuid] then
                local success = Pet:EquipPet(petGuid)
                if success then
                    equipped = equipped + 1
                end
                task.wait(0.25)
            end
        end
    end

    -- Filter pets by type (skips favorited pets)
    function m:FilterPetsByType(pets)
        if not self.SelectedPetTypes or next(self.SelectedPetTypes) == nil then
            return pets
        end

        local filtered = {}
        for guid, petData in pairs(pets) do
            local petType = Pet:GetPetType(petData)
            local isFavorited = Pet:IsPetFavorited(petData)

            if self.SelectedPetTypes[petType] and not isFavorited then
                filtered[guid] = petData
            end
        end

        return filtered
    end

    -- Auto equip pets for mutation
    function m:AutoEquipPets()
        -- Get all pets in inventory
        local allPets = Pet:GetAllPetsInInventory()
        if not allPets then
            -- print("[Mutation] No pets in inventory")
            return
        end

        -- Filter by selected pet types (excludes favorited)
        local targetPets = self:FilterPetsByType(allPets)

        local targetCount = 0
        for _ in pairs(targetPets) do targetCount = targetCount + 1 end
        -- print("[Mutation] Found", targetCount, "target pets after filtering")

        -- Get pet team GUIDs
        local petTeamGuids = self.SelectedTeamPets or {}

        -- Get current active pets
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            activePetsArray = {}
        end

        local activePets = {}
        for _, guid in ipairs(activePetsArray) do
            activePets[guid] = true
        end

        -- Step 1: Unequip active pets that already have target mutation
        for _, guid in ipairs(activePetsArray) do
            -- Skip team members
            if not petTeamGuids[guid] then
                local petData = allPets[guid]
                if petData then
                    local mutation = self:GetPetMutation(petData)
                    local petType = Pet:GetPetType(petData) or "Unknown"
                    -- print("[Mutation] Checking active pet:", petType, "GUID:", guid, "Mutation:", mutation or "None")

                    -- If pet has target mutation, unequip it
                    if mutation and self.TargetMutationTypes[mutation] then
                        -- Only notify/webhook if not already done for this pet
                        if not self.NotifiedPets[guid] then
                            self.NotifiedPets[guid] = true  -- Mark as notified
                            -- print("[Mutation] >> Unequipping pet with target mutation:", petType, "Mutation:", mutation)
                            self:Notify("Mutation Obtained!", petType .. " got " .. mutation .. " mutation", Color3.fromRGB(200, 100, 255))

                            -- Send webhook notification
                            local G = getgenv and getgenv() or _G
                            if G.SpecialWebhook then
                                -- Count remaining pets that don't have target mutation yet
                                local remainingCount = 0
                                for guid2, pd2 in pairs(targetPets) do
                                    if guid2 ~= guid then
                                        local mut = self:GetPetMutation(pd2)
                                        if not mut or not self.TargetMutationTypes[mut] then
                                            remainingCount = remainingCount + 1
                                        end
                                    end
                                end
                                pcall(function()
                                    G.SpecialWebhook:Mutation(petType, mutation, remainingCount)
                                end)
                            end
                        end

                        Pet:UnequipPet(guid)
                        activePets[guid] = nil
                        task.wait(0.3)
                    end
                else
                    -- print("[Mutation] Pet data not found in inventory for:", guid)
                end
            end
        end

        -- Step 2: Count remaining active target pets
        local activeTargetCount = 0
        for guid, _ in pairs(activePets) do
            if targetPets[guid] and not petTeamGuids[guid] then
                activeTargetCount = activeTargetCount + 1
            end
        end

        -- Step 3: Equip pets that need mutation (don't have target mutation yet)
        local slotsForTargets = self.MaxPetsInGarden
        local canEquip = slotsForTargets - activeTargetCount

        -- print("[Mutation] Active target pets:", activeTargetCount, "/ Max:", slotsForTargets, ", Can equip:", canEquip)

        if canEquip > 0 then
            for guid, petData in pairs(targetPets) do
                if canEquip <= 0 then break end

                -- Skip if already active or is team member
                if not activePets[guid] and not petTeamGuids[guid] then
                    local mutation = self:GetPetMutation(petData)

                    -- Only equip if pet does NOT have target mutation
                    if not mutation or not self.TargetMutationTypes[mutation] then
                        local petType = Pet:GetPetType(petData) or "Unknown"
                        local age = Pet:GetPetAge(petData) or 0

                        -- print("[Mutation] Equipping pet:", petType, "GUID:", guid, "Age:", age, "Mutation:", mutation or "None")
                        local success = Pet:EquipPet(guid)
                        if success then
                            canEquip = canEquip - 1
                            -- print("[Mutation] Equip success, remaining slots:", canEquip)
                        else
                            -- print("[Mutation] Equip failed for:", guid)
                        end
                        task.wait(0.5)
                    end
                end
            end
        else
            -- print("[Mutation] No slots available for target pets")
        end
    end

    -- Get nightmare event status (checks if nightmare event is active)
    function m:GetNightmareStatus()
        -- Check for nightmare event in workspace
        local nightActive = false

        pcall(function()
            -- Check various places where nightmare status might be stored
            local stats = Core.Player and Core.Player:WaitForChild("leaderstats", 1)
            if stats then
                local nightStat = stats:FindFirstChild("NightmareChance")
                if nightStat then
                    self.NightmareChance = nightStat.Value or 0
                    nightActive = self.NightmareChance > 0
                end
            end
        end)

        return nightActive
    end

    -- Get pet mutation type
    function m:GetPetMutation(petData)
        if not petData then return nil end

        local mutation = nil
        pcall(function()
            -- Get raw mutation type (enum like "X")
            local rawMutation = nil

            -- Check multiple possible locations
            if petData.MutationType and petData.MutationType ~= "" then
                rawMutation = petData.MutationType
            elseif petData.PetData and petData.PetData.MutationType and petData.PetData.MutationType ~= "" then
                rawMutation = petData.PetData.MutationType
            elseif petData.Mutation and petData.Mutation ~= "" then
                rawMutation = petData.Mutation
            end

            if rawMutation then
                -- Convert enum to display name using MutationEnumMap
                if self.MutationEnumMap and self.MutationEnumMap[rawMutation] then
                    mutation = self.MutationEnumMap[rawMutation]
                else
                    -- Fallback: use raw value
                    mutation = rawMutation
                end

                -- Normalize Gold to Golden
                if mutation == "Gold" then
                    mutation = "Golden"
                end
            end
        end)

        return mutation
    end

    -- Check if pet should be cleansed (has unwanted mutation)
    function m:ShouldCleansePet(petData)
        local mutation = self:GetPetMutation(petData)

        -- No mutation = don't cleanse
        if not mutation or mutation == "" then
            return false
        end

        -- Normalize mutation name for comparison
        local mutationLower = string.lower(tostring(mutation))

        -- Check if mutation is in keep list (case-insensitive)
        for keepMutation, _ in pairs(self.TargetMutationTypes) do
            if string.lower(tostring(keepMutation)) == mutationLower then
                -- This mutation should be kept
                return false
            end
        end

        -- Has mutation but not in keep list = should cleanse
        -- print("[Mutation] Pet has unwanted mutation:", mutation, "- will cleanse")
        return true
    end

    -- Cleanse a pet (apply cleansing shard)
    function m:CleansePet(petGuid)
        -- print("[Mutation] Attempting to cleanse pet:", petGuid)

        local Player = Players.LocalPlayer
        if not Player then
            warn("[Mutation] No LocalPlayer")
            return false
        end

        -- Get cleansing shard from backpack (check multiple attribute patterns)
        local cleansingTool = nil
        pcall(function()
            if Player.Backpack then
                for _, tool in pairs(Player.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        -- Try multiple ways to identify Cleansing Pet Shard
                        local toolName = tool.Name
                        local attrU = tool:GetAttribute("u") or ""
                        local attrItemName = tool:GetAttribute("ItemName") or ""
                        local attrName = tool:GetAttribute("Name") or ""

                        -- Check all possible identifiers
                        if toolName:find("Cleansing") or toolName:find("cleansing") or
                           attrU:find("Cleansing") or attrU:find("cleansing") or
                           attrItemName:find("Cleansing") or attrItemName:find("cleansing") or
                           attrName:find("Cleansing") or attrName:find("cleansing") then
                            cleansingTool = tool
                            break
                        end
                    end
                end
            end
        end)

        if not cleansingTool then
            warn("[Mutation] No cleansing shard found in backpack")
            return false
        end

        -- print("[Mutation] Found cleansing shard")

        -- Find pet model in PetsPhysical (like PandoraHub GetModelPet)
        local petMover = nil
        pcall(function()
            local petsPhysical = Core.Workspace:FindFirstChild("PetsPhysical")
            if petsPhysical then
                for _, container in ipairs(petsPhysical:GetChildren()) do
                    local modelPet = container:FindFirstChild(petGuid)
                    if modelPet then
                        petMover = modelPet
                        break
                    end
                end
            end
        end)

        if not petMover then
            warn("[Mutation] Could not find pet model in PetsPhysical for:", petGuid)
            return false
        end

        -- print("[Mutation] Found pet mover:", petMover.Name)

        -- Unequip any current tool first
        pcall(function()
            if Player.Character then
                for _, child in pairs(Player.Character:GetChildren()) do
                    if child:IsA("Tool") then
                        child.Parent = Player.Backpack
                    end
                end
            end
        end)
        task.wait(0.2)

        -- Equip the cleansing tool by moving to Character
        pcall(function()
            if Player.Character and cleansingTool then
                cleansingTool.Parent = Player.Character
            end
        end)
        task.wait(0.5) -- Wait for tool to be equipped

        -- print("[Mutation] Tool equipped, applying shard...")

        -- Apply cleansing shard via RemoteEvent (like PandoraHub)
        local success = pcall(function()
            Core.ReplicatedStorage.GameEvents.PetShardService_RE:FireServer(
                "ApplyShard",
                petMover
            )
        end)

        task.wait(1) -- Wait for server to process

        -- Unequip tool after use - move back to Backpack
        pcall(function()
            if Player.Character and cleansingTool then
                cleansingTool.Parent = Player.Backpack
            end
        end)

        if success then
            -- print("[Mutation] Successfully applied cleansing shard to:", petGuid)
            return true
        else
            warn("[Mutation] Failed to apply cleansing shard")
            return false
        end
    end

    -- Check active pets and cleanse those with unwanted mutations
    -- IMPORTANT: Only cleanse TARGET pets, not pet team members!
    function m:CheckAndCleansePets()
        local activePetsArray = Pet:GetActivePets()
        if not activePetsArray then
            return
        end

        local allPets = Pet:GetAllPetsInInventory()

        -- Get pet team GUIDs to skip
        local petTeamGuids = self.SelectedTeamPets or {}

        for _, guid in ipairs(activePetsArray) do
            -- Skip pet team members - only cleanse target pets
            if petTeamGuids[guid] then
                -- print("[Mutation] Skipping pet team member:", guid)
            else
                local petData = allPets[guid]
                if petData then
                    if self:ShouldCleansePet(petData) then
                        local mutation = self:GetPetMutation(petData)
                        -- print("[Mutation] Found TARGET pet with unwanted mutation:", mutation, "- Cleansing...")
                        self:CleansePet(guid)
                        task.wait(1) -- Wait between cleanses
                    end
                end
            end
        end
    end

    -- Main loop
    function m:MainLoop()
        while self.IsRunning do
            -- Ensure pet team is active
            self:EnsurePetTeamActive()

            -- Auto equip pets for mutation
            self:AutoEquipPets()

            -- Check and cleanse pets with unwanted mutations
            self:CheckAndCleansePets()

            -- Check and fix stuck pets
            self:CheckStuckPets()

            -- Wait before next cycle
            task.wait(5)
        end

        -- print("[Mutation] Main loop stopped")
    end

    -- Start mutation farming
    function m:Start()
        if self.IsRunning then
            -- print("[Mutation] Already running")
            return
        end

        self.IsRunning = true

        self:Notify("Mutation Started", "Auto mutation farming started", Color3.fromRGB(100, 200, 100))
        -- print("[Mutation] Starting...")

        -- Save config when starting
        self:SaveConfig()

        -- Start main loop in background
        task.spawn(function()
            self:MainLoop()
        end)
    end

    -- Stop mutation farming
    function m:Stop()
        local wasRunning = self.IsRunning
        self.IsRunning = false
        self.NotifiedPets = {}  -- Reset tracking for next session


        -- Only notify and cleanup if was previously running
        if wasRunning then
            self:Notify("Mutation Stopped", "Auto mutation farming stopped", Color3.fromRGB(255, 150, 100))

            -- Run cleanup in background so toggle responds instantly
            task.spawn(function()
                task.wait(0.5)
                self:PickupAllPets()
            end)
        end
    end

    return m

end

-- Module: webhook/ui_pandoruy.lua
EmbeddedModules["webhook/ui_pandoruy.lua"] = function()
    -- webhook/ui_pandoruy.lua
    -- UI untuk Webhook Tab menggunakan PandoruyHub Library
    local m = {}

    -- Module references
    local Window
    local Webhook
    local Core
    local Discord

    -- Local storage for webhook values (since GetConfigValue may not exist)
    m.WebhookURL = ""
    m.PingID = ""

    function m:Init(tab, window, webhook, core, discord)
        Window = window
        Webhook = webhook
